{
  "name": "doggydad-blog",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "npm --prefix apps/artcatcher ci",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run build:artcatcher && astro build",
    "build:artcatcher": "npm --prefix apps/artcatcher run build -- --base=/doggydad/games/artcatcher/",
    "dev:artcatcher": "npm --prefix apps/artcatcher run dev",
    "check:artcatcher": "npm --prefix apps/artcatcher run lint",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^4.16.0"
  }
}
