{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wordkey-learn",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "learn.wordsmaster.app", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": { "AI_ENABLED": "true" },
  "ratelimits": [{ "name": "API_RATE_LIMIT", "namespace_id": "86421012", "simple": { "limit": 6, "period": 60 } }],
  "d1_databases": [{ "binding": "BUDGET_DB", "database_name": "wordkey-learn-budget", "database_id": "21fbf7af-625b-4ba1-a1b6-51230816bf2b", "migrations_dir": "migrations" }],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
