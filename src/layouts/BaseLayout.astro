---
interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  article?: {
    publishedTime?: string | Date;
    updatedTime?: string | Date;
    tags?: string[];
    section?: string;
  };
}

import { withBase } from '../lib/blog';

const {
  title,
  description = '记录技术、阅读与个人思考的长期博客',
  keywords,
  article
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).toString().replace(/\/$/, '');
const defaultKeywords = ['博客', '技术', '读书笔记', '计算机科学'];
const pageKeywords = keywords || article?.tags || defaultKeywords;
const pathname = Astro.url.pathname;

const toISO = (value?: string | Date) => {
  if (!value) return undefined;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
};

const publishedTimeISO = toISO(article?.publishedTime);
const updatedTimeISO = toISO(article?.updatedTime) || publishedTimeISO;

const navItems = [
  { href: withBase('/'), label: '首页', active: pathname === withBase('/') },
  { href: withBase('/category/reading-notes/'), label: '读书', active: pathname.includes('/reading-notes') },
  { href: withBase('/category/tech-learning/'), label: '技术', active: pathname.includes('/tech-learning') },
  { href: withBase('/category/turing-award/'), label: '人物', active: pathname.includes('/turing-award') },
  { href: withBase('/about/'), label: '关于', active: pathname.includes('/about') }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f0e8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={pageKeywords.join(',')} />
    <meta name="author" content="DoggyDad" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="DoggyDad RSS" href={`${siteUrl}/rss.xml`} />
    <link rel="icon" href={`${siteUrl}/favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="DoggyDad Blog" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={`${siteUrl}/og-image.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@Hjfjfjsj" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.svg`} />

    {article && publishedTimeISO && <meta property="article:published_time" content={publishedTimeISO} />}
    {article && updatedTimeISO && <meta property="article:modified_time" content={updatedTimeISO} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': article ? 'BlogPosting' : 'WebSite',
      name: title,
      headline: title,
      description,
      url: canonicalURL.toString(),
      inLanguage: 'zh-CN',
      author: {
        '@type': 'Person',
        name: 'DoggyDad',
        url: 'https://linkedin.com/in/peng-zhao-mei',
        sameAs: ['https://x.com/Hjfjfjsj', 'https://github.com/pzhao16me']
      },
      publisher: { '@type': 'Person', name: 'DoggyDad' },
      ...(article ? {
        datePublished: publishedTimeISO,
        dateModified: updatedTimeISO,
        keywords: article.tags?.join(', '),
        articleSection: article.section,
        image: `${siteUrl}/og-image.svg`,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() }
      } : {
        potentialAction: {
          '@type': 'SearchAction',
          target: `${siteUrl}/search/?q={search_term_string}`,
          'query-input': 'required name=search_term_string'
        }
      })
    })} />

    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const preferredTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = storedTheme || preferredTheme;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <div id="app">
      <header class="site-header">
        <div class="site-container header-inner">
          <a class="brand" href={withBase('/')} aria-label="DoggyDad 首页">
            <span class="brand-mark" aria-hidden="true">犬</span>
            <span>
              <strong>DoggyDad</strong>
              <small>读书 · 技术 · 人物</small>
            </span>
          </a>

          <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="site-nav">
            <span class="sr-only">打开导航</span>
            <span></span><span></span>
          </button>

          <nav class="site-nav" id="site-nav" aria-label="主要导航">
            {navItems.map((item) => (
              <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
            ))}
            <a class="search-link" href={withBase('/search/')} aria-label="搜索文章">搜索</a>
            <button class="theme-toggle" id="theme-toggle" aria-label="切换深浅主题">
              <span class="theme-icon" aria-hidden="true"></span>
            </button>
          </nav>
        </div>
      </header>

      <main class="site-container" id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-container footer-inner">
          <div>
            <a class="footer-brand" href={withBase('/')}>DoggyDad</a>
            <p>把复杂的技术与思想，写成可以反复读的笔记。</p>
          </div>
          <nav aria-label="页脚导航">
            <a href={withBase('/about/')}>关于</a>
            <a href={withBase('/search/')}>搜索</a>
            <a href={withBase('/rss.xml')}>RSS</a>
            <a href="https://github.com/pzhao16me" target="_blank" rel="noopener">GitHub</a>
            <a href="https://x.com/Hjfjfjsj" target="_blank" rel="noopener">X</a>
          </nav>
          <p class="copyright">© {new Date().getFullYear()} DoggyDad · 使用 Astro 构建</p>
        </div>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      const themeToggle = document.getElementById('theme-toggle');
      const menuToggle = document.getElementById('menu-toggle');
      const siteNav = document.getElementById('site-nav');

      themeToggle?.addEventListener('click', () => {
        const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = nextTheme;
        localStorage.setItem('theme', nextTheme);
      });

      menuToggle?.addEventListener('click', () => {
        const expanded = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!expanded));
        siteNav?.classList.toggle('is-open', !expanded);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --color-bg: #f4f0e8;
    --color-surface: #fbf9f4;
    --color-surface-raised: #fffdf8;
    --color-heading: #24211d;
    --color-text: #36322c;
    --color-text-soft: #5f584f;
    --color-text-muted: #81786d;
    --color-border: #ded7ca;
    --color-border-strong: #bdb3a4;
    --color-accent: #a34a2a;
    --color-accent-soft: #f0ddd1;
    --color-code: #272521;
    --font-sans: 'Avenir Next', Avenir, 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    --font-serif: 'Iowan Old Style', Charter, 'Noto Serif SC', 'Songti SC', STSong, serif;
    --shadow-raised: 0 18px 45px rgba(75, 58, 38, .08);
    --radius-sm: .35rem;
    --radius-md: .7rem;
    --radius-lg: 1.15rem;
  }

  [data-theme='dark'] {
    color-scheme: dark;
    --color-bg: #1d1b18;
    --color-surface: #24211d;
    --color-surface-raised: #2c2823;
    --color-heading: #f3eee5;
    --color-text: #ddd5c8;
    --color-text-soft: #c2b8aa;
    --color-text-muted: #9f9588;
    --color-border: #403a32;
    --color-border-strong: #62584b;
    --color-accent: #df8a63;
    --color-accent-soft: #493126;
    --color-code: #171614;
    --shadow-raised: 0 18px 45px rgba(0, 0, 0, .22);
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--color-bg); color: var(--color-text); font-family: var(--font-sans); line-height: 1.7; }
  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(67, 54, 39, .045) .7px, transparent .7px);
    background-size: 7px 7px;
    content: '';
    pointer-events: none;
  }
  #app { display: flex; min-height: 100dvh; flex-direction: column; }
  .site-container { width: min(100% - 3rem, 1180px); margin-inline: auto; }
  main.site-container { flex: 1; padding-block: clamp(2.4rem, 7vw, 6.5rem); }

  a { color: var(--color-accent); text-underline-offset: .2em; }
  button, input { font: inherit; }
  img { max-width: 100%; height: auto; }
  ::selection { background: var(--color-accent-soft); color: var(--color-heading); }
  :focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }

  .skip-link { position: fixed; top: .75rem; left: .75rem; z-index: 1000; transform: translateY(-200%); padding: .6rem 1rem; background: var(--color-heading); color: var(--color-bg); text-decoration: none; }
  .skip-link:focus { transform: translateY(0); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }

  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent); background: color-mix(in srgb, var(--color-bg) 88%, transparent); backdrop-filter: blur(14px); }
  .header-inner { display: flex; min-height: 5rem; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; color: var(--color-heading); text-decoration: none; }
  .brand-mark { display: grid; width: 2.1rem; height: 2.1rem; place-items: center; border: 1px solid var(--color-accent); color: var(--color-accent); font-family: var(--font-serif); font-size: 1.05rem; transform: rotate(-2deg); }
  .brand strong { display: block; font-family: var(--font-serif); font-size: 1.15rem; letter-spacing: -.02em; line-height: 1.1; }
  .brand small { display: block; margin-top: .18rem; color: var(--color-text-muted); font-size: .63rem; letter-spacing: .12em; }
  .site-nav { display: flex; align-items: center; gap: 1.7rem; }
  .site-nav a { position: relative; color: var(--color-text-soft); font-size: .88rem; font-weight: 600; text-decoration: none; }
  .site-nav a::after { position: absolute; right: 0; bottom: -.55rem; left: 0; height: 1px; background: var(--color-accent); content: ''; transform: scaleX(0); transform-origin: left; transition: transform .2s ease; }
  .site-nav a:hover::after, .site-nav a[aria-current='page']::after { transform: scaleX(1); }
  .site-nav a[aria-current='page'] { color: var(--color-heading); }
  .search-link { margin-left: .6rem; }
  .theme-toggle { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border: 1px solid var(--color-border); border-radius: 50%; background: transparent; color: var(--color-text); cursor: pointer; transition: background .2s ease, transform .2s ease; }
  .theme-toggle:hover { background: var(--color-surface-raised); transform: rotate(8deg); }
  .theme-icon { width: .75rem; height: .75rem; border: 1.5px solid currentColor; border-radius: 50%; box-shadow: .35rem -.25rem 0 -.15rem var(--color-bg); }
  .menu-toggle { display: none; width: 2.5rem; height: 2.5rem; padding: .65rem; border: 1px solid var(--color-border); background: transparent; color: var(--color-heading); }
  .menu-toggle span:not(.sr-only) { display: block; width: 100%; height: 1px; margin-block: .35rem; background: currentColor; }

  .site-footer { border-top: 1px solid var(--color-border); background: var(--color-surface); }
  .footer-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; padding-block: 3.2rem 2rem; }
  .footer-brand { color: var(--color-heading); font-family: var(--font-serif); font-size: 1.4rem; font-weight: 700; text-decoration: none; }
  .site-footer p { max-width: 34rem; margin: .5rem 0 0; color: var(--color-text-muted); font-size: .86rem; }
  .site-footer nav { display: flex; flex-wrap: wrap; align-content: start; justify-content: flex-end; gap: .5rem 1.4rem; }
  .site-footer nav a { color: var(--color-text-soft); font-size: .84rem; text-decoration: none; }
  .copyright { grid-column: 1 / -1; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }

  .prose { color: var(--color-text); font-size: clamp(1rem, 1.5vw, 1.08rem); line-height: 1.9; }
  .prose > * { max-width: 68ch; }
  .prose h2, .prose h3, .prose h4 { color: var(--color-heading); font-family: var(--font-serif); text-wrap: balance; scroll-margin-top: 7rem; }
  .prose h2 { margin: 3.4rem 0 1.15rem; font-size: clamp(1.65rem, 3vw, 2.15rem); letter-spacing: -.025em; line-height: 1.35; }
  .prose h3 { margin: 2.4rem 0 .9rem; font-size: 1.3rem; line-height: 1.45; }
  .prose p { margin: 0 0 1.25rem; text-wrap: pretty; }
  .prose ul, .prose ol { margin: 0 0 1.4rem; padding-left: 1.4rem; }
  .prose li { margin-bottom: .55rem; padding-left: .25rem; }
  .prose blockquote { margin: 2rem 0; padding: .25rem 0 .25rem 1.4rem; border-left: 2px solid var(--color-accent); color: var(--color-text-soft); font-family: var(--font-serif); font-size: 1.1em; }
  .prose blockquote p:last-child { margin-bottom: 0; }
  .prose code { padding: .12em .35em; border-radius: .25rem; background: var(--color-accent-soft); font-size: .9em; }
  .prose pre { max-width: 100%; margin: 1.8rem 0; padding: 1.25rem; overflow: auto; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-code); color: #f1eadf; line-height: 1.65; }
  .prose pre code { padding: 0; background: none; }
  .prose table { display: block; max-width: 100%; margin: 1.8rem 0; overflow-x: auto; border-collapse: collapse; font-size: .92rem; }
  .prose th, .prose td { padding: .7rem .85rem; border: 1px solid var(--color-border); text-align: left; }
  .prose th { background: var(--color-surface); color: var(--color-heading); }
  .prose hr { margin: 3rem 0; border: 0; border-top: 1px solid var(--color-border); }

  @media (max-width: 820px) {
    .site-container { width: min(100% - 2rem, 1180px); }
    .header-inner { min-height: 4.5rem; }
    .brand small { display: none; }
    .menu-toggle { display: block; }
    .site-nav { position: absolute; top: calc(100% + 1px); right: 0; left: 0; display: none; align-items: stretch; flex-direction: column; gap: 0; padding: .65rem 1rem 1rem; border-bottom: 1px solid var(--color-border); background: var(--color-bg); box-shadow: var(--shadow-raised); }
    .site-nav.is-open { display: flex; }
    .site-nav a { padding: .75rem .25rem; font-size: 1rem; }
    .site-nav a::after { display: none; }
    .search-link { margin-left: 0; }
    .theme-toggle { position: absolute; right: 4.25rem; top: .7rem; }
    .footer-inner { grid-template-columns: 1fr; }
    .site-footer nav { justify-content: flex-start; }
    .copyright { grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { transition-duration: .01ms !important; }
  }
</style>
