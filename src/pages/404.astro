---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/blog';
---

<BaseLayout title="页面没有找到 — DoggyDad" description="这个页面不存在或已经移动。">
  <section class="not-found">
    <p>404 / NOT FOUND</p>
    <h1>这页笔记，暂时找不到了。</h1>
    <div>
      <p>它可能被移动、改名，或者还没有写完。</p>
      <a href={withBase('/')}>返回首页 →</a>
      <a href={withBase('/search/')}>搜索文章</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 56vh; }
  .not-found > p { margin: 0 0 1rem; color: var(--color-accent); font-size: .7rem; font-weight: 700; letter-spacing: .15em; }
  h1 { max-width: 12ch; margin: 0; color: var(--color-heading); font-family: var(--font-serif); font-size: clamp(3rem, 9vw, 7rem); letter-spacing: -.055em; line-height: 1.02; }
  .not-found div { margin-top: 3rem; }
  .not-found div p { color: var(--color-text-muted); }
  .not-found a { margin-right: 1.5rem; font-weight: 700; text-decoration: none; }
</style>
