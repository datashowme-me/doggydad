  <!-- 5. 内置草稿纸手写抽屉 -->
  <div class="pad-drawer" id="drawer-pad" hidden>
    <div class="pad-bar">
      <span style="font-size:0.85rem; font-weight:700">📝 手写草稿纸（随数列竖式）</span>
      <div class="pad-tools">
        <div style="display:flex; gap:0.3rem">
          <button class="color-dot active" data-c="#0f172a" style="background:#0f172a" title="铅笔黑"></button>
          <button class="color-dot" data-c="#2563eb" style="background:#2563eb" title="蓝色"></button>
          <button class="color-dot" data-c="#dc2626" style="background:#dc2626" title="红色标注"></button>
        </div>
        <button id="btn-pad-eraser" class="btn-pad-tool">🧹 橡皮</button>
        <button id="btn-pad-clear" class="btn-pad-tool">🗑️ 清空</button>
        <button id="btn-pad-close" class="btn-pad-tool" style="color:#b91c1c">✖️ 收起</button>
      </div>
    </div>
    <div class="pad-body">
      <canvas id="canvas-pad" class="pad-canvas"></canvas>
    </div>
  </div>

  <!-- 原生 JavaScript 逻辑 -->
  <script is:inline>
    (function() {
      // -----------------------------------------------------------
      // 0. 音效引擎 (Web Audio API 纯代码合成)
      // -----------------------------------------------------------
      let audioCtx = null;
      let isMuted = localStorage.getItem('kousuan_muted') === 'true';

      function playTone(freq, duration, type = 'sine', gainVal = 0.2, delay = 0) {
        if (isMuted) return;
        if (!audioCtx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          if (AC) audioCtx = new AC();
        }
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
        if (!audioCtx) return;

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        const startTime = audioCtx.currentTime + delay;

        osc.type = type;
        osc.frequency.setValueAtTime(freq, startTime);
        gain.gain.setValueAtTime(gainVal, startTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(startTime);
        osc.stop(startTime + duration);
      }

      function soundCorrect() {
        playTone(523.25, 0.15, 'triangle', 0.25, 0);
        playTone(659.25, 0.15, 'triangle', 0.25, 0.08);
        playTone(783.99, 0.25, 'triangle', 0.3, 0.16);
      }
      function soundWrong() {
        playTone(220, 0.18, 'sine', 0.2, 0);
        playTone(180, 0.22, 'sine', 0.2, 0.12);
      }
      function soundLevelUp() {
        [261.63, 329.63, 392.00, 523.25, 659.25].forEach((f, idx) => playTone(f, 0.2, 'sawtooth', 0.15, idx * 0.08));
      }
      function soundVictory() {
        [392.00, 523.25, 659.25, 783.99, 1046.50].forEach((f, idx) => playTone(f, 0.35, 'triangle', 0.22, idx * 0.1));
      }
      function soundClick() {
        playTone(600, 0.04, 'sine', 0.08, 0);
      }

      // -----------------------------------------------------------
      // 1. 11 级数段题库生成器
      // -----------------------------------------------------------
      const TIERS = [
        { id: 0, name: '10 以内', max: 10, title: '10 以内加减基础' },
        { id: 1, name: '20 以内', max: 20, title: '20 以内进位加与退位减（凑十破十）' },
        { id: 2, name: '30 以内', max: 30, title: '30 以内加减与连加' },
        { id: 3, name: '40 以内', max: 40, title: '40 以内加减混合运算' },
        { id: 4, name: '50 以内', max: 50, title: '50 以内速算挑战' },
        { id: 5, name: '60 以内', max: 60, title: '60 以内口算' },
        { id: 6, name: '70 以内', max: 70, title: '70 以内混合运算' },
        { id: 7, name: '80 以内', max: 80, title: '80 以内综合进退位' },
        { id: 8, name: '90 以内', max: 90, title: '90 以内大数计算' },
        { id: 9, name: '100 以内', max: 100, title: '100 以内满十进退位与连加减' },
        { id: 10, name: '表内乘除综合', max: 100, title: '九九乘法口诀与表内整除' }
      ];

      function randInt(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
      }

      function buildQuestion(tierIdx) {
        // 第 11 关：表内乘除综合
        if (tierIdx === 10) {
          if (Math.random() < 0.25) {
            const a = randInt(2, 9), b = randInt(2, 9), prod = a * b;
            const target = prod + [0, -randInt(1, 4), randInt(1, 4)][randInt(0, 2)];
            let sym = '=';
            if (prod > target) sym = '>';
            if (prod < target) sym = '<';
            return { type: 'compare', left: `${a} × ${b}`, right: String(target), answer: sym, hash: `cmp_${a}x${b}_${sym}_${target}` };
          }
          if (Math.random() < 0.5) {
            const a = randInt(2, 9), b = randInt(2, 9);
            return { type: 'calc', expr: `${a} × ${b}`, answer: String(a * b), hash: `m_${a}x${b}` };
          } else {
            const divisor = randInt(2, 9), quotient = randInt(1, 9);
            return { type: 'calc', expr: `${divisor * quotient} ÷ ${divisor}`, answer: String(quotient), hash: `d_${divisor*quotient}/${divisor}` };
          }
        }

        const tier = TIERS[tierIdx] || TIERS[0];
        const maxVal = tier.max;

        // 28% 几率出比大小
        if (Math.random() < 0.28) {
          const isAdd = Math.random() < 0.6;
          let leftVal = 0, leftExpr = '';
          if (isAdd) {
            const a = randInt(1, maxVal - 2), b = randInt(1, maxVal - a);
            leftVal = a + b; leftExpr = `${a} + ${b}`;
          } else {
            const a = randInt(3, maxVal), b = randInt(1, a - 1);
            leftVal = a - b; leftExpr = `${a} - ${b}`;
          }
          const mode = randInt(0, 2);
          let rightVal = leftVal, sym = '=';
          if (mode === 1) { rightVal = leftVal - randInt(1, Math.min(8, Math.max(1, leftVal - 1))); sym = '>'; }
          else if (mode === 2) { rightVal = leftVal + randInt(1, 8); sym = '<'; }
          return { type: 'compare', left: leftExpr, right: String(rightVal), answer: sym, hash: `cmp_${leftExpr}_${sym}_${rightVal}` };
        } else {
          // 常规计算
          const allowed = [0, 1];
          if (tierIdx >= 2) allowed.push(2); // 连加
          if (tierIdx >= 3) allowed.push(3); // 混合
          const form = allowed[randInt(0, allowed.length - 1)];

          if (form === 0) {
            const a = randInt(1, maxVal - 1), b = randInt(1, maxVal - a);
            return { type: 'calc', expr: `${a} + ${b}`, answer: String(a + b), hash: `c_${a}+${b}` };
          } else if (form === 1) {
            const a = randInt(2, maxVal), b = randInt(1, a);
            return { type: 'calc', expr: `${a} - ${b}`, answer: String(a - b), hash: `c_${a}-${b}` };
          } else if (form === 2) {
            const a = randInt(1, Math.floor(maxVal / 3)), b = randInt(1, Math.floor(maxVal / 3));
            const c = randInt(1, maxVal - a - b);
            return { type: 'calc', expr: `${a} + ${b} + ${c}`, answer: String(a + b + c), hash: `c_${a}+${b}+${c}` };
          } else {
            const a = randInt(2, Math.floor(maxVal * 0.6)), b = randInt(2, Math.floor(maxVal * 0.4));
            const sum = a + b;
            const c = randInt(1, Math.min(sum - 1, Math.floor(maxVal * 0.5)));
            return { type: 'calc', expr: `${a} + ${b} - ${c}`, answer: String(sum - c), hash: `c_${a}+${b}-${c}` };
          }
        }
      }

      // -----------------------------------------------------------
      // 2. 状态机
      // -----------------------------------------------------------
      const state = {
        mode: 'progressive', // 'progressive' | 'custom' | 'drill'
        currentTier: 0,
        customTier: 0,
        targetCount: 50,
        timeLimit: 300,
        timeLeft: 300,
        timerId: null,
        isPaused: false,

        currentIndex: 0,
        totalAnswered: 0,
        correctCount: 0,
        currentStreak: 0,
        maxStreak: 0,
        tierStreak: 0,

        currentQuestion: null,
        inputValue: '',
        seenHashes: new Set(),

        startTime: 0,
        qStartTime: 0,
        totalQTime: 0,

        roundMistakes: [],
        drillQueue: []
      };

      // DOM 元素引用
      const $ = id => document.getElementById(id);
      const els = {
        vSetup: $('view-setup'),
        vPlay: $('view-play'),
        vResult: $('view-result'),

        btnStart: $('btn-start'),
        modeCards: document.querySelectorAll('.mode-card'),
        tierBtns: document.querySelectorAll('.tier-btn'),
        tierHint: $('tier-hint'),
        countPills: document.querySelectorAll('#count-pills .pill-btn'),
        timePills: document.querySelectorAll('#time-pills .pill-btn'),
        txtMistakeCount: $('txt-mistake-count'),

        hudTier: $('hud-tier-name'),
        hudIdx: $('hud-q-idx'),
        hudTotal: $('hud-q-total'),
        hudAcc: $('hud-q-acc'),
        hudBar: $('hud-prog-bar'),
        hudTimerBox: $('hud-timer-box'),
        hudTimerTxt: $('hud-timer-txt'),
        hudFire: $('hud-fire'),
        hudStreak: $('hud-streak-val'),
        btnPause: $('btn-pause'),

        cardStage: $('card-stage'),
        bannerLevelup: $('banner-levelup'),
        txtLevelupTitle: $('txt-levelup-title'),
        txtLevelupSub: $('txt-levelup-sub'),
        floatLayer: $('float-layer'),

        rowCalc: $('row-calc'),
        txtCalcExpr: $('txt-calc-expr'),
        slotCalc: $('slot-calc'),
        txtCalcVal: $('txt-calc-val'),

        rowComp: $('row-comp'),
        txtCompLeft: $('txt-comp-left'),
        circleComp: $('circle-comp'),
        txtCompRight: $('txt-comp-right'),

        keysComp: $('keys-comp'),
        keysCalc: $('keys-calc'),
        btnSubmitCalc: $('btn-submit-calc'),

        resTrophy: $('res-trophy'),
        resHonor: $('res-honor'),
        resTotal: $('res-total'),
        resAcc: $('res-acc'),
        resSpeed: $('res-speed'),
        resStreak: $('res-streak'),
        resSummary: $('res-summary-msg'),
        boxRoundMistakes: $('box-round-mistakes'),
        txtRoundMCount: $('txt-round-m-count'),
        listRoundMistakes: $('list-round-mistakes'),
        btnReplay: $('btn-replay'),
        btnRedoMistakes: $('btn-redo-mistakes'),
        btnGoHome: $('btn-go-home'),

        // 弹窗
        modalPause: $('modal-pause'),
        btnResume: $('btn-resume'),
        btnRestart: $('btn-restart'),
        btnQuit: $('btn-quit'),

        modalMistakes: $('modal-mistakes'),
        btnViewMistakes: $('btn-view-mistakes'),
        btnCloseM: $('btn-close-m'),
        hintMEmpty: $('hint-m-empty'),
        listMItems: $('list-m-items'),
        btnDrillM: $('btn-drill-m'),
        txtMBtnCount: $('txt-m-btn-count'),
        btnClearM: $('btn-clear-m'),

        modalHistory: $('modal-history'),
        btnViewHistory: $('btn-view-history'),
        btnCloseH: $('btn-close-h'),
        ltTotal: $('lt-total'),
        ltAcc: $('lt-acc'),
        ltStreak: $('lt-streak'),
        hintHEmpty: $('hint-h-empty'),
        listHLogs: $('list-h-logs'),

        btnToggleEye: $('btn-toggle-eye'),
        btnToggleSound: $('btn-toggle-sound'),
        btnTogglePad: $('btn-toggle-pad'),
        btnToggleFs: $('btn-toggle-fs'),
        btnGetStandalone: $('btn-get-standalone'),

        drawerPad: $('drawer-pad'),
        canvasPad: $('canvas-pad'),
        btnPadEraser: $('btn-pad-eraser'),
        btnPadClear: $('btn-pad-clear'),
        btnPadClose: $('btn-pad-close'),
        padColorDots: document.querySelectorAll('.color-dot'),

        fxCanvas: $('fx-canvas')
      };

      // 强制确保所有弹窗在初始时彻底隐藏！
      function closeAllModals() {
        [els.modalPause, els.modalMistakes, els.modalHistory].forEach(m => {
          if (m) {
            m.hidden = true;
            m.style.display = 'none';
          }
        });
      }
      closeAllModals();

      function showModal(modalEl) {
        closeAllModals();
        if (modalEl) {
          modalEl.hidden = false;
          modalEl.style.display = 'flex';
          soundClick();
        }
      }

      function hideModal(modalEl) {
        if (modalEl) {
          modalEl.hidden = true;
          modalEl.style.display = 'none';
          soundClick();
        }
      }

      // -----------------------------------------------------------
      // 3. 粒子系统
      // -----------------------------------------------------------
      const fxCtx = els.fxCanvas.getContext('2d');
      let particles = [];
      let fxLoop = null;

      function resizeFx() {
        els.fxCanvas.width = window.innerWidth;
        els.fxCanvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resizeFx);
      resizeFx();

      function spawnBurst(x, y, count = 30) {
        const colors = ['#f59e0b', '#10b981', '#3b82f6', '#ec4899', '#8b5cf6'];
        for (let i = 0; i < count; i++) {
          const a = Math.random() * Math.PI * 2, sp = Math.random() * 8 + 3;
          particles.push({
            x, y,
            vx: Math.cos(a) * sp,
            vy: Math.sin(a) * sp - 2,
            size: Math.random() * 7 + 3,
            color: colors[Math.floor(Math.random() * colors.length)],
            alpha: 1,
            decay: Math.random() * 0.025 + 0.015
          });
        }
        if (!fxLoop) animFx();
      }

      function spawnFireworks() {
        const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
        spawnBurst(cx - 150, cy - 60, 40);
        spawnBurst(cx + 150, cy - 60, 40);
        spawnBurst(cx, cy - 120, 50);
      }

      function animFx() {
        fxCtx.clearRect(0, 0, els.fxCanvas.width, els.fxCanvas.height);
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx; p.y += p.vy; p.vy += 0.2; p.alpha -= p.decay;
          if (p.alpha <= 0) { particles.splice(i, 1); continue; }
          fxCtx.save();
          fxCtx.globalAlpha = p.alpha;
          fxCtx.fillStyle = p.color;
          fxCtx.beginPath();
          fxCtx.arc(p.x, p.y, p.size / 2, 0, Math.PI * 2);
          fxCtx.fill();
          fxCtx.restore();
        }
        if (particles.length > 0) fxLoop = requestAnimationFrame(animFx);
        else fxLoop = null;
      }

      function spawnFloatText(txt, isGood = true) {
        const el = document.createElement('div');
        el.className = `float-popup ${isGood ? 'good' : 'bad'}`;
        el.textContent = txt;
        els.floatLayer.appendChild(el);
        setTimeout(() => el.remove(), 1200);
      }

      // -----------------------------------------------------------
      // 4. 草稿纸画板
      // -----------------------------------------------------------
      const padCtx = els.canvasPad.getContext('2d');
      let padDrawing = false, padColor = '#0f172a', padEraser = false, lx = 0, ly = 0;

      function resizePad() {
        const box = els.drawerPad.getBoundingClientRect();
        els.canvasPad.width = box.width;
        els.canvasPad.height = box.height - 44;
      }

      els.canvasPad.addEventListener('pointerdown', e => {
        padDrawing = true;
        const rect = els.canvasPad.getBoundingClientRect();
        lx = e.clientX - rect.left; ly = e.clientY - rect.top;
      });

      els.canvasPad.addEventListener('pointermove', e => {
        if (!padDrawing) return;
        const rect = els.canvasPad.getBoundingClientRect();
        const cx = e.clientX - rect.left, cy = e.clientY - rect.top;
        padCtx.beginPath();
        padCtx.moveTo(lx, ly); padCtx.lineTo(cx, cy);
        padCtx.lineCap = 'round';
        padCtx.strokeStyle = padEraser ? '#ffffff' : padColor;
        padCtx.lineWidth = padEraser ? 24 : 3;
        padCtx.stroke();
        lx = cx; ly = cy;
      });

      window.addEventListener('pointerup', () => padDrawing = false);

      els.padColorDots.forEach(d => {
        d.addEventListener('click', () => {
          els.padColorDots.forEach(x => x.classList.remove('active'));
          d.classList.add('active');
          padColor = d.dataset.c;
          padEraser = false;
          els.btnPadEraser.classList.remove('active');
        });
      });

      els.btnPadEraser.addEventListener('click', () => {
        padEraser = !padEraser;
        els.btnPadEraser.classList.toggle('active', padEraser);
      });

      els.btnPadClear.addEventListener('click', () => {
        padCtx.clearRect(0, 0, els.canvasPad.width, els.canvasPad.height);
        soundClick();
      });

      els.btnPadClose.addEventListener('click', togglePad);
      els.btnTogglePad.addEventListener('click', togglePad);

      function togglePad() {
        const isHidden = els.drawerPad.hidden;
        els.drawerPad.hidden = !isHidden;
        els.btnTogglePad.classList.toggle('active', isHidden);
        if (isHidden) setTimeout(resizePad, 40);
        soundClick();
      }

      // -----------------------------------------------------------
      // 5. 存储与历史
      // -----------------------------------------------------------
      const KEY_MISTAKES = 'kousuan_mistakes_v2';
      const KEY_HISTORY = 'kousuan_history_v2';

      function getMistakes() {
        try { return JSON.parse(localStorage.getItem(KEY_MISTAKES) || '[]'); }
        catch (e) { return []; }
      }
      function saveMistakes(list) {
        try {
          localStorage.setItem(KEY_MISTAKES, JSON.stringify(list));
          updateMistakeBadge();
        } catch (e) {}
      }
      function addMistake(q, userAns) {
        const list = getMistakes();
        if (!list.some(x => x.hash === q.hash)) {
          list.push({
            hash: q.hash,
            type: q.type,
            expr: q.type === 'calc' ? q.expr : `${q.left} ○ ${q.right}`,
            correctAnswer: q.answer,
            userAnswer: userAns || '(未填)',
            date: new Date().toLocaleDateString('zh-CN')
          });
          saveMistakes(list);
        }
      }
      function removeMistake(hash) {
        const list = getMistakes().filter(x => x.hash !== hash);
        saveMistakes(list);
      }
      function updateMistakeBadge() {
        const count = getMistakes().length;
        if (els.txtMistakeCount) els.txtMistakeCount.textContent = count;
      }

      function getHistory() {
        try { return JSON.parse(localStorage.getItem(KEY_HISTORY) || '[]'); }
        catch (e) { return []; }
      }
      function saveHistory(item) {
        try {
          const list = getHistory();
          list.unshift(item);
          if (list.length > 50) list.pop();
          localStorage.setItem(KEY_HISTORY, JSON.stringify(list));
        } catch (e) {}
      }

      // -----------------------------------------------------------
      // 6. 游戏核心流程
      // -----------------------------------------------------------
      function switchView(viewName) {
        closeAllModals();
        [els.vSetup, els.vPlay, els.vResult].forEach(v => v.classList.remove('active'));
        if (viewName === 'setup') els.vSetup.classList.add('active');
        if (viewName === 'play') els.vPlay.classList.add('active');
        if (viewName === 'result') els.vResult.classList.add('active');
      }

      function startGame(isDrill = false) {
        closeAllModals();
        state.isPaused = false;
        state.seenHashes.clear();
        state.currentIndex = 0;
        state.totalAnswered = 0;
        state.correctCount = 0;
        state.currentStreak = 0;
        state.maxStreak = 0;
        state.tierStreak = 0;
        state.roundMistakes = [];
        state.inputValue = '';
        state.totalQTime = 0;

        if (isDrill) {
          state.mode = 'drill';
          state.drillQueue = [...getMistakes()];
          state.targetCount = state.drillQueue.length;
          state.timeLimit = 0;
        } else {
          state.currentTier = state.mode === 'progressive' ? 0 : state.customTier;
        }

        state.timeLeft = state.timeLimit;
        state.startTime = Date.now();

        switchView('play');
        startTimer();
        updateHUD();
        nextQuestion();
        soundClick();
      }

      function startTimer() {
        clearInterval(state.timerId);
        if (state.timeLimit <= 0) {
          els.hudTimerBox.hidden = true;
          return;
        }
        els.hudTimerBox.hidden = false;
        updateTimerDisplay();

        state.timerId = setInterval(() => {
          if (state.isPaused) return;
          state.timeLeft--;
          updateTimerDisplay();
          if (state.timeLeft <= 0) finishGame('时间耗尽');
        }, 1000);
      }

      function updateTimerDisplay() {
        const m = Math.floor(state.timeLeft / 60);
        const s = state.timeLeft % 60;
        els.hudTimerTxt.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        if (state.timeLeft <= 30) els.hudTimerTxt.style.color = '#f43f5e';
        else els.hudTimerTxt.style.color = 'inherit';
      }

      function nextQuestion() {
        if (state.targetCount > 0 && state.currentIndex >= state.targetCount) {
          finishGame('达到目标题量');
          return;
        }

        state.currentIndex++;
        state.inputValue = '';
        state.qStartTime = Date.now();

        if (state.mode === 'drill') {
          const item = state.drillQueue[state.currentIndex - 1];
          if (!item) { finishGame('错题重做完成'); return; }
          if (item.type === 'calc') {
            state.currentQuestion = { type: 'calc', expr: item.expr, answer: item.correctAnswer, hash: item.hash };
          } else {
            const parts = item.expr.split('○');
            state.currentQuestion = {
              type: 'compare',
              left: parts[0]?.trim() || '',
              right: parts[1]?.trim() || '',
              answer: item.correctAnswer,
              hash: item.hash
            };
          }
        } else {
          state.currentQuestion = buildQuestion(state.currentTier);
        }

        renderQuestion();
        updateHUD();
      }

      function renderQuestion() {
        const q = state.currentQuestion;
        if (!q) return;

        if (q.type === 'compare') {
          els.rowCalc.hidden = true;
          els.rowComp.hidden = false;
          els.txtCompLeft.textContent = q.left;
          els.txtCompRight.textContent = q.right;
          els.circleComp.textContent = '○';
          els.circleComp.className = 'eq-comp-circle';

          // 互斥显示：隐藏数字键，显示比大小键
          els.keysCalc.hidden = true;
          els.keysComp.hidden = false;
        } else {
          els.rowComp.hidden = true;
          els.rowCalc.hidden = false;
          els.txtCalcExpr.textContent = q.expr;
          els.txtCalcVal.textContent = '';
          els.slotCalc.className = 'eq-input-slot';

          // 互斥显示：隐藏比大小键，显示数字键
          els.keysComp.hidden = true;
          els.keysCalc.hidden = false;
        }
      }

      function updateHUD() {
        els.hudTier.textContent = state.mode === 'drill' ? '错题专训' : TIERS[state.currentTier].name;
        els.hudIdx.textContent = state.currentIndex || 1;
        els.hudTotal.textContent = state.targetCount > 0 ? state.targetCount : '∞';
        const acc = state.totalAnswered > 0 ? Math.round((state.correctCount / state.totalAnswered) * 100) : 100;
        els.hudAcc.textContent = `${acc}%`;
        els.hudBar.style.width = state.targetCount > 0 ? `${(state.currentIndex / state.targetCount) * 100}%` : '100%';
        els.hudStreak.textContent = state.currentStreak;
        if (state.currentStreak >= 5) els.hudFire.classList.add('active');
        else els.hudFire.classList.remove('active');
      }

      function evaluateAnswer(userAns) {
        if (!state.currentQuestion) return;
        const q = state.currentQuestion;
        const isOk = String(userAns).trim() === String(q.answer).trim();
        const cost = Math.max(0.5, (Date.now() - state.qStartTime) / 1000);
        state.totalQTime += cost;
        state.totalAnswered++;

        if (isOk) {
          state.correctCount++;
          state.currentStreak++;
          state.tierStreak++;
          if (state.currentStreak > state.maxStreak) state.maxStreak = state.currentStreak;

          soundCorrect();
          const rect = els.cardStage.getBoundingClientRect();
          spawnBurst(rect.left + rect.width / 2, rect.top + rect.height * 0.35, 25);

          let fTxt = '+10 ⭐';
          if (state.currentStreak >= 3) fTxt = `+${10 + state.currentStreak * 2} 🔥 ${state.currentStreak}连对!`;
          if (cost < 2.0) fTxt += ' ⚡极速!';
          spawnFloatText(fTxt, true);

          if (state.mode === 'drill') removeMistake(q.hash);

          // 连对 3 题平滑晋级
          if (state.mode === 'progressive' && state.tierStreak >= 3 && state.currentTier < TIERS.length - 1) {
            state.tierStreak = 0;
            state.currentTier++;
            soundLevelUp();
            spawnFireworks();
            els.txtLevelupTitle.textContent = `🎉 恭喜晋级！进入【${TIERS[state.currentTier].name}】！`;
            els.txtLevelupSub.textContent = TIERS[state.currentTier].title;
            els.bannerLevelup.hidden = false;
            setTimeout(() => {
              els.bannerLevelup.hidden = true;
              nextQuestion();
            }, 1500);
          } else {
            setTimeout(nextQuestion, 240);
          }
        } else {
          state.currentStreak = 0;
          state.tierStreak = 0;
          soundWrong();
          spawnFloatText('继续加油 ❌', false);

          const m = {
            hash: q.hash,
            type: q.type,
            expr: q.type === 'calc' ? q.expr : `${q.left} ○ ${q.right}`,
            userAnswer: userAns || '(未填)',
            correctAnswer: q.answer
          };
          state.roundMistakes.push(m);
          addMistake(q, userAns);

          if (q.type === 'compare') {
            els.circleComp.textContent = q.answer;
            els.circleComp.classList.add('wrong');
          } else {
            els.txtCalcVal.textContent = q.answer;
            els.slotCalc.classList.add('wrong');
          }
          setTimeout(nextQuestion, 1100);
        }
      }

      function finishGame(reason) {
        clearInterval(state.timerId);
        soundVictory();
        spawnFireworks();

        const acc = state.totalAnswered > 0 ? Math.round((state.correctCount / state.totalAnswered) * 100) : 0;
        const spd = state.totalAnswered > 0 ? (state.totalQTime / state.totalAnswered).toFixed(1) : '0.0';

        els.resTotal.textContent = state.totalAnswered;
        els.resAcc.textContent = `${acc}%`;
        els.resSpeed.textContent = `${spd}s`;
        els.resStreak.textContent = state.maxStreak;

        let honor = '✨ 速算小能手';
        if (acc >= 98 && parseFloat(spd) < 3) honor = '⚡ 无敌神算子';
        else if (acc >= 95) honor = '🏆 数学小天才';
        else if (acc >= 90) honor = '🌟 心算大师';
        else if (acc < 60) honor = '☀️ 口算萌芽';
        els.resHonor.textContent = honor;

        if (state.roundMistakes.length > 0) {
          els.boxRoundMistakes.hidden = false;
          els.btnRedoMistakes.hidden = false;
          els.txtRoundMCount.textContent = state.roundMistakes.length;
          els.listRoundMistakes.innerHTML = state.roundMistakes.map(m => `
            <div class="m-chip">
              <strong>${m.expr}</strong>
              <span>你的答案: <span class="w">${m.userAnswer}</span> ➔ 正确: <strong class="c">${m.correctAnswer}</strong></span>
            </div>
          `).join('');
        } else {
          els.boxRoundMistakes.hidden = true;
          els.btnRedoMistakes.hidden = true;
        }

        saveHistory({
          date: new Date().toLocaleDateString('zh-CN'),
          total: state.totalAnswered,
          correct: state.correctCount,
          accuracy: acc,
          speed: spd,
          streak: state.maxStreak,
          honor: honor
        });

        updateMistakeBadge();
        switchView('result');
      }

      // -----------------------------------------------------------
      // 7. 用户交互绑定
      // -----------------------------------------------------------
      // 模式切换
      els.modeCards.forEach(card => {
        card.addEventListener('click', () => {
          els.modeCards.forEach(c => c.classList.remove('active'));
          card.classList.add('active');
          state.mode = card.dataset.mode;
          if (state.mode === 'progressive') {
            els.tierHint.textContent = '逐级闯关模式将从 10 以内开始动态晋阶';
            els.tierBtns.forEach((b, idx) => b.classList.toggle('active', idx === 0));
          } else {
            els.tierHint.textContent = '自选模式：可点击下方任意数段高强度练习';
          }
          soundClick();
        });
      });

      // 梯级选择
      els.tierBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          els.tierBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          state.customTier = parseInt(btn.dataset.tier, 10);
          state.mode = 'custom';
          els.modeCards.forEach(c => c.classList.toggle('active', c.dataset.mode === 'custom'));
          els.tierHint.textContent = `已锁定梯级：【${TIERS[state.customTier].name}】${TIERS[state.customTier].title}`;
          soundClick();
        });
      });

      // 题量
      els.countPills.forEach(p => {
        p.addEventListener('click', () => {
          els.countPills.forEach(x => x.classList.remove('active'));
          p.classList.add('active');
          state.targetCount = parseInt(p.dataset.count, 10);
          soundClick();
        });
      });

      // 限时
      els.timePills.forEach(p => {
        p.addEventListener('click', () => {
          els.timePills.forEach(x => x.classList.remove('active'));
          p.classList.add('active');
          state.timeLimit = parseInt(p.dataset.time, 10);
          soundClick();
        });
      });

      els.btnStart.addEventListener('click', () => startGame(false));

      // 比大小按钮点击
      els.keysComp.querySelectorAll('.btn-comp').forEach(btn => {
        btn.addEventListener('click', () => {
          const sym = btn.dataset.sym;
          els.circleComp.textContent = sym;
          soundClick();
          evaluateAnswer(sym);
        });
      });

      // 常规计算按键
      els.keysCalc.querySelectorAll('.num-key').forEach(btn => {
        btn.addEventListener('click', () => {
          const k = btn.dataset.k;
          soundClick();
          if (k === 'clear') {
            state.inputValue = '';
          } else if (k === 'back') {
            state.inputValue = state.inputValue.slice(0, -1);
          } else {
            if (state.inputValue.length < 5) state.inputValue += k;
          }
          els.txtCalcVal.textContent = state.inputValue;
          els.slotCalc.classList.toggle('has-val', !!state.inputValue);
        });
      });

      els.btnSubmitCalc.addEventListener('click', () => {
        if (!state.inputValue) return;
        soundClick();
        evaluateAnswer(state.inputValue);
      });

      // 实体键盘全映射
      window.addEventListener('keydown', e => {
        // 如果有弹窗打开，按 Esc 键关闭
        if (e.key === 'Escape') {
          closeAllModals();
          return;
        }

        if (!els.vPlay.classList.contains('active') || state.isPaused) return;

        const q = state.currentQuestion;
        if (!q) return;

        if (q.type === 'compare') {
          if (e.key === '>' || e.key === '.') {
            e.preventDefault(); soundClick(); els.circleComp.textContent = '>'; evaluateAnswer('>');
          } else if (e.key === '<' || e.key === ',') {
            e.preventDefault(); soundClick(); els.circleComp.textContent = '<'; evaluateAnswer('<');
          } else if (e.key === '=' || e.key === 'Enter') {
            e.preventDefault(); soundClick(); els.circleComp.textContent = '='; evaluateAnswer('=');
          }
        } else {
          if (/^[0-9]$/.test(e.key)) {
            soundClick();
            if (state.inputValue.length < 5) state.inputValue += e.key;
            els.txtCalcVal.textContent = state.inputValue;
            els.slotCalc.classList.toggle('has-val', !!state.inputValue);
          } else if (e.key === 'Backspace') {
            soundClick();
            state.inputValue = state.inputValue.slice(0, -1);
            els.txtCalcVal.textContent = state.inputValue;
            els.slotCalc.classList.toggle('has-val', !!state.inputValue);
          } else if (e.key === 'c' || e.key === 'C' || e.key === 'Delete') {
            soundClick();
            state.inputValue = '';
            els.txtCalcVal.textContent = '';
            els.slotCalc.classList.remove('has-val');
          } else if (e.key === 'Enter') {
            if (state.inputValue) {
              soundClick();
              evaluateAnswer(state.inputValue);
            }
          }
        }
      });

      // 暂停与恢复
      els.btnPause.addEventListener('click', () => {
        state.isPaused = true;
        showModal(els.modalPause);
      });
      els.btnResume.addEventListener('click', () => {
        state.isPaused = false;
        hideModal(els.modalPause);
      });
      els.btnRestart.addEventListener('click', () => {
        hideModal(els.modalPause);
        startGame(state.mode === 'drill');
      });
      els.btnQuit.addEventListener('click', () => {
        clearInterval(state.timerId);
        hideModal(els.modalPause);
        switchView('setup');
      });

      // 结算页交互
      els.btnReplay.addEventListener('click', () => startGame(false));
      els.btnRedoMistakes.addEventListener('click', () => startGame(true));
      els.btnGoHome.addEventListener('click', () => switchView('setup'));

      // 错题弹窗
      els.btnViewMistakes.addEventListener('click', () => {
        const list = getMistakes();
        els.txtMBtnCount.textContent = list.length;
        if (list.length === 0) {
          els.hintMEmpty.hidden = false;
          els.listMItems.innerHTML = '';
          els.btnDrillM.disabled = true;
        } else {
          els.hintMEmpty.hidden = true;
          els.btnDrillM.disabled = false;
          els.listMItems.innerHTML = list.map(m => `
            <div class="mistake-row">
              <div>
                <strong>${m.expr}</strong>
                <span style="font-size:0.75rem; color:var(--text-muted); margin-left:6px">${m.date || ''}</span>
              </div>
              <div style="display:flex; align-items:center; gap:8px">
                <span style="font-size:0.8rem">答案: <span style="color:#e11d48; text-decoration:line-through">${m.userAnswer}</span> ➔ <strong style="color:#059669">${m.correctAnswer}</strong></span>
                <button type="button" class="btn-del-m" data-h="${m.hash}">✓ 掌握</button>
              </div>
            </div>
          `).join('');

          els.listMItems.querySelectorAll('.btn-del-m').forEach(btn => {
            btn.addEventListener('click', () => {
              removeMistake(btn.dataset.h);
              els.btnViewMistakes.click();
            });
          });
        }
        showModal(els.modalMistakes);
      });

      els.btnCloseM.addEventListener('click', () => hideModal(els.modalMistakes));
      els.btnClearM.addEventListener('click', () => {
        if (confirm('确认清空所有错题记录？')) {
          saveMistakes([]);
          hideModal(els.modalMistakes);
        }
      });
      els.btnDrillM.addEventListener('click', () => {
        hideModal(els.modalMistakes);
        startGame(true);
      });

      // 历史弹窗
      els.btnViewHistory.addEventListener('click', () => {
        const list = getHistory();
        if (list.length === 0) {
          els.hintHEmpty.hidden = false;
          els.listHLogs.innerHTML = '';
          els.ltTotal.textContent = '0';
          els.ltAcc.textContent = '0%';
          els.ltStreak.textContent = '0';
        } else {
          els.hintHEmpty.hidden = true;
          let sumTotal = 0, sumCorrect = 0, maxS = 0;
          list.forEach(item => {
            sumTotal += (item.total || 0);
            sumCorrect += (item.correct || 0);
            if ((item.streak || 0) > maxS) maxS = item.streak;
          });
          els.ltTotal.textContent = sumTotal;
          els.ltAcc.textContent = sumTotal > 0 ? `${Math.round((sumCorrect / sumTotal) * 100)}%` : '0%';
          els.ltStreak.textContent = maxS;

          els.listHLogs.innerHTML = list.map(l => `
            <div class="hist-log">
              <div>
                <strong style="color:#b45309">${l.honor}</strong>
                <span style="color:var(--text-muted); font-size:0.75rem; display:block">${l.date}</span>
              </div>
              <div style="text-align:right">
                <span style="color:#059669; font-weight:700">${l.accuracy}% 正确率</span>
                <span style="color:var(--text-muted); font-size:0.75rem; display:block">${l.total} 题 · 均速 ${l.speed}s</span>
              </div>
            </div>
          `).join('');
        }
        showModal(els.modalHistory);
      });

      els.btnCloseH.addEventListener('click', () => hideModal(els.modalHistory));

      // 弹窗背景遮罩点击自动关闭
      [els.modalPause, els.modalMistakes, els.modalHistory].forEach(overlay => {
        overlay.addEventListener('click', e => {
          if (e.target === overlay) hideModal(overlay);
        });
      });

      // 护眼模式切换
      els.btnToggleEye.addEventListener('click', () => {
        const isEye = document.body.classList.toggle('eye-mode');
        localStorage.setItem('kousuan_eye', String(isEye));
        els.btnToggleEye.textContent = isEye ? '☀️ 明亮' : '🌿 护眼';
        soundClick();
      });
      if (localStorage.getItem('kousuan_eye') === 'true') {
        document.body.classList.add('eye-mode');
        els.btnToggleEye.textContent = '☀️ 明亮';
      }

      // 音效开关
      els.btnToggleSound.addEventListener('click', () => {
        isMuted = !isMuted;
        localStorage.setItem('kousuan_muted', String(isMuted));
        els.btnToggleSound.textContent = isMuted ? '🔇 静音' : '🔊 音效';
        soundClick();
      });
      els.btnToggleSound.textContent = isMuted ? '🔇 静音' : '🔊 音效';

      // 全屏切换
      els.btnToggleFs.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen?.();
          els.btnToggleFs.textContent = '🗗 还原';
        } else {
          document.exitFullscreen?.();
          els.btnToggleFs.textContent = '⛶ 全屏';
        }
      });

      // 下载离线单文件
      els.btnGetStandalone.addEventListener('click', () => {
        soundClick();
        window.open(`${base}/games/math/standalone.html`, '_blank');
      });

      updateMistakeBadge();
    })();
  </script>
</body>
</html>
