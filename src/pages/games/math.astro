---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://wordsmaster.app';
const canonicalUrl = `${siteUrl}/games/math/`;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>口算大冲关 · 100以内速算小能手 | WordsMaster</title>
  <meta name="description" content="专为小学低年级学生（1–3年级）设计的 100 以内口算速算练习独立单页 Web 应用：11级数段平滑晋阶、加减乘除与比大小、智能按键切换、手写草稿纸与错题闭环。" />
  <meta name="keywords" content="口算练习,100以内口算,小学数学,速算训练,加减混合,九九乘除,幼小衔接,口算小游戏" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- OpenGraph -->
  <meta property="og:title" content="口算大冲关 · 100以内速算小能手" />
  <meta property="og:description" content="专为小学 1–3 年级设计的 100 以内口算速算练习应用：11级梯度逐级闯关、智能键盘、手写草稿纸与错题闭环。" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': '口算大冲关 · 100以内速算小能手',
    'url': canonicalUrl,
    'applicationCategory': 'EducationalApplication',
    'operatingSystem': 'Any',
    'description': '专为小学低年级学生（1–3年级）设计的 100 以内口算速算练习单页 Web 应用。',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'CNY'
    }
  })} />

  <style>
    /* 全局 CSS 变量与护眼调色 */
    :root {
      --bg-page: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --brand: #2563eb;
      --brand-hover: #1d4ed8;
      --border: #e2e8f0;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
      --shadow-md: 0 8px 20px -4px rgba(0,0,0,0.08);
      --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.1);
    }

    body.eye-mode {
      --bg-page: #fbf7ee;
      --card-bg: #fffefb;
      --text-main: #2d261e;
      --text-muted: #796b58;
      --border: #ede3ce;
    }

    /* 必须强制 hidden 生效，防止被 display: flex / grid 覆盖 */
    [hidden] {
      display: none !important;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      width: 100%;
      min-height: 100%;
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', sans-serif;
      user-select: none;
      -webkit-user-select: none;
      transition: background-color 0.25s, color 0.25s;
    }

    /* 粒子特效 Canvas */
    .fx-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 999;
    }

    /* 独立页面顶部状态栏 */
    .app-header {
      width: 100%;
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-inner {
      max-width: 960px;
      margin: 0 auto;
      padding: 0.75rem 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-muted);
      background: rgba(0,0,0,0.04);
      padding: 0.4rem 0.75rem;
      border-radius: 0.5rem;
      transition: all 0.15s;
    }

    .back-btn:hover {
      color: var(--brand);
      background: rgba(37,99,235,0.08);
    }

    .app-title {
      font-size: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .badge-standalone {
      font-size: 0.7rem;
      font-weight: 700;
      background: #ecfdf5;
      color: #065f46;
      padding: 0.15rem 0.5rem;
      border-radius: 9999px;
      margin-left: 0.25rem;
    }

    .header-tools {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .tool-btn {
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text-main);
      padding: 0.4rem 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }

    .tool-btn:hover {
      border-color: var(--brand);
      color: var(--brand);
    }

    .tool-btn.highlight {
      background: #eff6ff;
      border-color: #bfdbfe;
      color: #1d4ed8;
    }

    .tool-btn.active {
      background: var(--brand);
      color: #ffffff;
      border-color: var(--brand);
    }

    /* 核心舞台主容器 */
    .app-viewport {
      max-width: 900px;
      margin: 0 auto;
      padding: 1.25rem 1rem 3rem 1rem;
    }

    .view-panel {
      display: none;
      animation: fadeIn 0.2s ease-out;
    }

    .view-panel.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* 1. 设置与模式选择页 */
    .hero-box {
      text-align: center;
      margin-bottom: 1.75rem;
    }

    .hero-kicker {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      background: #eff6ff;
      color: #1d4ed8;
      padding: 0.3rem 0.85rem;
      border-radius: 9999px;
      margin-bottom: 0.6rem;
    }

    .hero-box h2 {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 0.4rem;
    }

    .hero-box p {
      font-size: 0.95rem;
      color: var(--text-muted);
      max-width: 580px;
      margin: 0 auto;
      line-height: 1.5;
    }

    .setup-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1.25rem;
      padding: 1.75rem;
      box-shadow: var(--shadow-sm);
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 0.65rem;
    }

    .form-label .sub {
      font-size: 0.78rem;
      font-weight: 400;
      color: var(--text-muted);
    }

    /* 模式切换卡片 */
    .mode-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.85rem;
    }

    .mode-card {
      background: var(--bg-page);
      border: 2px solid transparent;
      padding: 1rem;
      border-radius: 0.85rem;
      text-align: left;
      cursor: pointer;
      transition: all 0.15s;
    }

    .mode-card:hover {
      background: #f1f5f9;
    }

    .mode-card.active {
      background: #eff6ff;
      border-color: var(--brand);
    }

    .mode-card .t {
      font-weight: 700;
      font-size: 1rem;
      margin-bottom: 0.25rem;
      color: var(--text-main);
    }

    .mode-card .d {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.4;
    }

    /* 11 梯级网格 */
    .tier-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: 0.5rem;
    }

    .tier-btn {
      background: var(--bg-page);
      border: 1px solid var(--border);
      padding: 0.6rem 0.4rem;
      border-radius: 0.6rem;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-main);
      cursor: pointer;
      text-align: center;
      transition: all 0.15s;
    }

    .tier-btn:hover {
      border-color: var(--brand);
    }

    .tier-btn.active {
      background: var(--brand);
      color: #ffffff;
      border-color: var(--brand);
      box-shadow: 0 4px 10px rgba(37,99,235,0.25);
    }

    .tier-btn.special {
      grid-column: span 2;
      background: #fffbeb;
      border-color: #fde68a;
      color: #b45309;
    }

    .tier-btn.special.active {
      background: #d97706;
      color: #ffffff;
      border-color: #d97706;
    }

    /* 选项按钮药丸 */
    .pill-row {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .pill-btn {
      flex: 1;
      min-width: 65px;
      padding: 0.6rem 0.4rem;
      background: var(--bg-page);
      border: 1px solid var(--border);
      border-radius: 0.6rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-main);
      cursor: pointer;
      text-align: center;
      transition: all 0.15s;
    }

    .pill-btn:hover {
      border-color: var(--brand);
    }

    .pill-btn.active {
      background: var(--brand);
      color: #ffffff;
      border-color: var(--brand);
    }

    /* 底部操作区 */
    .setup-actions {
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
    }

    .btn-start {
      width: 100%;
      max-width: 400px;
      background: linear-gradient(135deg, #2563eb, #1d4ed8);
      color: #ffffff;
      border: none;
      padding: 1rem 2rem;
      font-size: 1.2rem;
      font-weight: 800;
      border-radius: 0.85rem;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(37,99,235,0.3);
      transition: all 0.15s;
    }

    .btn-start:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(37,99,235,0.38);
    }

    .sub-actions {
      display: flex;
      gap: 0.65rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn-sub {
      background: var(--bg-page);
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 0.55rem 1rem;
      border-radius: 0.6rem;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-sub:hover {
      border-color: var(--brand);
      color: var(--brand);
    }

    /* 2. 核心答题竞技页 */
    .play-hud {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 0.75rem 1.25rem;
      margin-bottom: 1.25rem;
      box-shadow: var(--shadow-sm);
      gap: 1rem;
      flex-wrap: wrap;
    }

    .hud-col {
      display: flex;
      flex-direction: column;
    }

    .hud-label {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
    }

    .hud-val {
      font-size: 1.15rem;
      font-weight: 800;
    }

    .hud-progress {
      flex: 2;
      min-width: 160px;
    }

    .prog-text {
      display: flex;
      justify-content: space-between;
      font-size: 0.84rem;
      font-weight: 600;
      margin-bottom: 0.35rem;
    }

    .prog-track {
      width: 100%;
      height: 8px;
      background: #e2e8f0;
      border-radius: 9999px;
      overflow: hidden;
    }

    .prog-fill {
      height: 100%;
      background: linear-gradient(90deg, #3b82f6, #10b981);
      transition: width 0.3s;
    }

    .hud-combo {
      flex-direction: row;
      align-items: center;
      gap: 0.3rem;
      background: #fffbeb;
      padding: 0.35rem 0.75rem;
      border-radius: 0.6rem;
      border: 1px solid #fef3c7;
    }

    .combo-fire.active {
      animation: flameShake 0.4s infinite alternate;
    }

    @keyframes flameShake {
      0% { transform: scale(1) rotate(-5deg); filter: drop-shadow(0 0 4px #f59e0b); }
      100% { transform: scale(1.3) rotate(5deg); filter: drop-shadow(0 0 10px #ef4444); }
    }

    .combo-num {
      font-size: 1.2rem;
      font-weight: 900;
      color: #b45309;
    }

    /* 算式卡片核心舞台 */
    .math-card-stage {
      position: relative;
      background: var(--card-bg);
      border: 2px solid var(--border);
      border-radius: 1.5rem;
      padding: 2.25rem 1.5rem 1.75rem 1.5rem;
      box-shadow: var(--shadow-md);
      min-height: 460px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      overflow: hidden;
    }

    /* 升级全屏金色横幅 */
    .levelup-banner {
      position: absolute;
      top: 15%;
      left: 6%;
      right: 6%;
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      color: #78350f;
      padding: 1.25rem;
      border-radius: 1.25rem;
      text-align: center;
      box-shadow: 0 20px 40px rgba(245, 158, 11, 0.4);
      z-index: 50;
      border: 3px solid #fef3c7;
      animation: popBanner 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes popBanner {
      0% { transform: scale(0.6) translateY(30px); opacity: 0; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }

    /* 浮动飘字层 */
    .float-layer {
      position: absolute;
      top: 25%;
      left: 50%;
      transform: translateX(-50%);
      pointer-events: none;
      z-index: 40;
    }

    .float-popup {
      font-size: 1.8rem;
      font-weight: 900;
      text-shadow: 0 2px 10px rgba(0,0,0,0.15);
      animation: floatUp 1.2s forwards;
      white-space: nowrap;
    }

    .float-popup.good { color: #10b981; }
    .float-popup.bad { color: #f43f5e; }

    @keyframes floatUp {
      0% { transform: translateY(0) scale(0.8); opacity: 0; }
      20% { transform: translateY(-15px) scale(1.15); opacity: 1; }
      80% { transform: translateY(-40px) scale(1.05); opacity: 0.9; }
      100% { transform: translateY(-65px) scale(0.9); opacity: 0; }
    }

    /* 算式展示 */
    .equation-area {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100px;
      margin: auto 0;
    }

    .eq-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.15rem;
      flex-wrap: wrap;
    }

    .eq-expr, .eq-comp-part {
      font-size: 3.5rem;
      font-weight: 900;
      font-variant-numeric: tabular-nums;
      color: var(--text-main);
    }

    .eq-op {
      font-size: 3.5rem;
      font-weight: 700;
      color: var(--text-muted);
    }

    .eq-input-slot {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 125px;
      height: 80px;
      padding: 0 1rem;
      background: var(--bg-page);
      border: 3px dashed #94a3b8;
      border-radius: 1rem;
      font-size: 3.5rem;
      font-weight: 900;
      color: var(--brand);
      transition: all 0.15s;
    }

    .eq-input-slot.has-val {
      border-style: solid;
      border-color: var(--brand);
      background: #eff6ff;
    }

    .eq-input-slot.wrong {
      border-color: #f43f5e;
      background: #fff1f2;
      color: #f43f5e;
    }

    .slot-cursor {
      display: inline-block;
      width: 3px;
      height: 48px;
      background: var(--brand);
      margin-left: 4px;
      animation: blink 1s infinite;
    }

    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    .eq-comp-circle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: #f1f5f9;
      border: 3px dashed #94a3b8;
      font-size: 2.8rem;
      font-weight: 900;
      color: #475569;
      transition: all 0.15s;
    }

    .eq-comp-circle.wrong {
      background: #fff1f2;
      border-color: #f43f5e;
      color: #f43f5e;
    }

    /* 智能互斥按键区 */
    /* 比大小 3 键 */
    .keypad-comp {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      width: 100%;
      max-width: 520px;
    }

    .btn-comp {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.4rem 0.5rem;
      border-radius: 1.25rem;
      border: 2px solid transparent;
      cursor: pointer;
      box-shadow: 0 6px 12px rgba(0,0,0,0.04);
      transition: all 0.15s;
    }

    .btn-comp:active { transform: scale(0.96); }
    .btn-comp .sym { font-size: 3.2rem; font-weight: 900; line-height: 1; }
    .btn-comp .sym-name { font-size: 1.1rem; font-weight: 700; margin-top: 0.25rem; }
    .btn-comp .key-hint { font-size: 0.72rem; opacity: 0.75; margin-top: 0.2rem; }

    .btn-greater { background: #fff1f2; border-color: #fecdd3; color: #e11d48; }
    .btn-equal { background: #fffbeb; border-color: #fef3c7; color: #d97706; }
    .btn-less { background: #ecfdf5; border-color: #a7f3d0; color: #059669; }

    /* 常规计算 0-9 小键盘 */
    .keypad-calc {
      width: 100%;
      max-width: 420px;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .num-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
    }

    .num-key {
      height: 60px;
      background: var(--bg-page);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      font-size: 1.85rem;
      font-weight: 700;
      color: var(--text-main);
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.1s;
    }

    .num-key:active { transform: scale(0.95); background: #e2e8f0; }
    .num-key.action-c { color: #e11d48; background: #fff1f2; }
    .num-key.action-b { color: #0284c7; background: #f0f9ff; font-size: 1.5rem; }

    .btn-submit {
      height: 52px;
      background: linear-gradient(135deg, #10b981, #059669);
      color: #ffffff;
      border: none;
      border-radius: 0.75rem;
      font-size: 1.2rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
      transition: all 0.15s;
    }

    .btn-submit:active { transform: scale(0.97); }

    .play-hint {
      text-align: center;
      margin-top: 1rem;
      font-size: 0.82rem;
      color: var(--text-muted);
    }

    /* 3. 结算大报告 */
    .result-card {
      max-width: 640px;
      margin: 1rem auto;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 1.5rem;
      padding: 2.25rem 1.75rem;
      text-align: center;
      box-shadow: var(--shadow-lg);
    }

    .trophy-icon {
      font-size: 4.2rem;
      margin-bottom: 0.4rem;
      animation: bounce 1s infinite alternate;
    }

    @keyframes bounce { from { transform: translateY(0); } to { transform: translateY(-8px); } }

    .honor-tag {
      display: inline-block;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #ffffff;
      font-size: 1.15rem;
      font-weight: 800;
      padding: 0.35rem 1.25rem;
      border-radius: 9999px;
      margin: 0.75rem 0 1.5rem 0;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
    }

    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.65rem;
      margin-bottom: 1.5rem;
    }

    .metric-card {
      background: var(--bg-page);
      border: 1px solid var(--border);
      border-radius: 0.85rem;
      padding: 1rem 0.4rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .metric-card.good {
      background: #ecfdf5;
      border-color: #a7f3d0;
    }

    .metric-card.good .v { color: #059669; }
    .metric-card .v { font-size: 1.75rem; font-weight: 900; }
    .metric-card .l { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; margin-top: 0.2rem; }

    .result-msg {
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--text-muted);
      background: var(--bg-page);
      border-radius: 0.75rem;
      padding: 0.85rem;
      margin-bottom: 1.5rem;
    }

    .round-mistakes-box {
      text-align: left;
      margin-bottom: 1.5rem;
      background: #fff1f2;
      border: 1px solid #fecdd3;
      border-radius: 0.85rem;
      padding: 0.85rem;
    }

    .round-mistakes-box h4 {
      font-size: 0.88rem;
      font-weight: 700;
      color: #9f1239;
      margin-bottom: 0.5rem;
    }

    .round-mistakes-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.4rem;
    }

    .m-chip {
      background: #ffffff;
      border: 1px solid #ffe4e6;
      border-radius: 0.4rem;
      padding: 0.4rem 0.6rem;
      font-size: 0.82rem;
      display: flex;
      justify-content: space-between;
    }

    .m-chip .w { color: #e11d48; text-decoration: line-through; margin-right: 4px; }
    .m-chip .c { color: #059669; font-weight: 700; }

    .result-buttons {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* 4. 模态弹窗系统 (严格受控隐藏) */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(4px);
      z-index: 1000;
      padding: 1rem;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
    }

    /* 只有未 hidden 时才 display: flex */
    .modal-overlay:not([hidden]) {
      display: flex !important;
    }

    .modal-box {
      background: var(--card-bg);
      border-radius: 1.25rem;
      padding: 1.75rem;
      width: 100%;
      max-width: 440px;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
      text-align: center;
      animation: popIn 0.2s ease-out;
    }

    .modal-box.wide {
      max-width: 640px;
      text-align: left;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
    }

    @keyframes popIn {
      from { opacity: 0; transform: scale(0.92); }
      to { opacity: 1; transform: scale(1); }
    }

    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .modal-head h3 {
      font-size: 1.25rem;
      font-weight: 800;
    }

    .modal-close-btn {
      background: none;
      border: none;
      font-size: 1.4rem;
      cursor: pointer;
      color: var(--text-muted);
    }

    .modal-desc {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0.85rem;
    }

    .mistake-scroll {
      flex: 1;
      overflow-y: auto;
      max-height: 360px;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 0.6rem;
      margin-bottom: 0.85rem;
    }

    .mistake-row {
      background: var(--bg-page);
      border: 1px solid var(--border);
      border-radius: 0.6rem;
      padding: 0.65rem 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
      font-size: 0.9rem;
    }

    .btn-del-m {
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      color: #065f46;
      padding: 0.25rem 0.55rem;
      border-radius: 0.4rem;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
    }

    .hist-stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.6rem;
      margin-bottom: 0.85rem;
    }

    .hist-stat-item {
      background: var(--bg-page);
      border: 1px solid var(--border);
      border-radius: 0.6rem;
      padding: 0.65rem;
      text-align: center;
    }

    .hist-stat-item .val { font-size: 1.35rem; font-weight: 800; color: var(--brand); display: block; }
    .hist-stat-item .lbl { font-size: 0.75rem; color: var(--text-muted); }

    .hist-scroll {
      flex: 1;
      overflow-y: auto;
      max-height: 300px;
      border: 1px solid var(--border);
      border-radius: 0.6rem;
      padding: 0.5rem;
    }

    .hist-log {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem;
      border-bottom: 1px solid var(--border);
      font-size: 0.82rem;
    }

    /* 5. 草稿纸手写抽屉 */
    .pad-drawer {
      position: fixed;
      bottom: 0;
      right: 0;
      width: 460px;
      max-width: 100vw;
      height: 360px;
      background: #ffffff;
      border-top-left-radius: 1.25rem;
      box-shadow: 0 -10px 30px rgba(0,0,0,0.18);
      border: 2px solid var(--border);
      border-bottom: none;
      z-index: 900;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .pad-bar {
      height: 44px;
      background: #f1f5f9;
      border-bottom: 1px solid #cbd5e1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 0.75rem;
    }

    .pad-tools {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .color-dot {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 2px solid #ffffff;
      cursor: pointer;
    }

    .color-dot.active {
      outline: 2px solid var(--brand);
      outline-offset: 1px;
    }

    .btn-pad-tool {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      padding: 0.2rem 0.5rem;
      border-radius: 0.35rem;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-pad-tool.active { background: #e2e8f0; }

    .pad-body {
      flex: 1;
      position: relative;
      background-color: #ffffff;
      background-image: linear-gradient(#e2e8f0 1px, transparent 1px), linear-gradient(90deg, #e2e8f0 1px, transparent 1px);
      background-size: 24px 24px;
      cursor: crosshair;
      touch-action: none;
    }

    .pad-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* 移动端与平板响应式适配 */
    @media (max-width: 640px) {
      .hero-box h2 { font-size: 1.6rem; }
      .mode-cards { grid-template-columns: 1fr; }
      .eq-expr, .eq-comp-part, .eq-op { font-size: 2.4rem; }
      .eq-input-slot { min-width: 90px; height: 64px; font-size: 2.4rem; }
      .eq-comp-circle { width: 64px; height: 64px; font-size: 2.2rem; }
      .metrics-grid { grid-template-columns: 1fr 1fr; }
      .btn-comp .sym { font-size: 2.4rem; }
      .num-key { height: 50px; font-size: 1.5rem; }
      .pad-drawer { width: 100vw; height: 300px; }
    }
  </style>
</head>
<body>
  <!-- 粒子特效 Canvas -->
  <canvas id="fx-canvas" class="fx-canvas"></canvas>

  <!-- 独立应用专属导航顶栏 -->
  <header class="app-header">
    <div class="header-inner">
      <div class="brand-wrap">
        <a href={`${base}/games/`} class="back-btn" title="返回 WordsMaster 游戏大厅">
          <span>‹</span> 游戏大厅
        </a>
        <h1 class="app-title">
          <span>🧮</span> 口算大冲关
          <span class="badge-standalone">速算冲关</span>
        </h1>
      </div>
      <div class="header-tools">
        <button id="btn-toggle-eye" class="tool-btn" title="切换护眼模式">🌿 护眼</button>
        <button id="btn-toggle-sound" class="tool-btn" title="开关音效">🔊 音效</button>
        <button id="btn-toggle-pad" class="tool-btn highlight" title="随手手写列竖式">📝 草稿纸</button>
        <button id="btn-toggle-fs" class="tool-btn" title="全屏练习">⛶ 全屏</button>
      </div>
    </div>
  </header>

  <!-- 主视口视图容器 -->
  <main class="app-viewport">
    <!-- 1. 设置与开始界面 (初始激活) -->
    <section id="view-setup" class="view-panel active">
      <div class="hero-box">
        <span class="hero-kicker">小学 1–3 年级运算能力进阶神器</span>
        <h2>每天 5 分钟 · 算力大冲关</h2>
        <p>11 级数段平滑晋阶、加减混合、九九乘除与比大小，智能键盘切换，练就扎实运算基本功！</p>
      </div>

      <div class="setup-card">
        <!-- 训练模式 -->
        <div class="form-group">
          <label class="form-label">
            <span>🎮 训练模式</span>
          </label>
          <div class="mode-cards">
            <button type="button" class="mode-card active" data-mode="progressive">
              <div class="t">🚀 逐级递增闯关（推荐）</div>
              <div class="d">从 10 以内起步，每连对 3 题平滑晋级下一个数段，直冲百内与乘除</div>
            </button>
            <button type="button" class="mode-card" data-mode="custom">
              <div class="t">🎯 自选梯级专项</div>
              <div class="d">挑选特定数段（如 20以内退位减法、百内加减或表内乘除）专项冲刺</div>
            </button>
          </div>
        </div>

        <!-- 11 级数段阶梯 -->
        <div class="form-group">
          <label class="form-label">
            <span>📈 目标数段（覆盖 11 个独立梯度）</span>
            <span class="sub" id="tier-hint">逐级闯关模式将从 10 以内开始动态晋阶</span>
          </label>
          <div class="tier-grid" id="tier-grid">
            <button type="button" class="tier-btn active" data-tier="0">10 以内</button>
            <button type="button" class="tier-btn" data-tier="1">20 以内</button>
            <button type="button" class="tier-btn" data-tier="2">30 以内</button>
            <button type="button" class="tier-btn" data-tier="3">40 以内</button>
            <button type="button" class="tier-btn" data-tier="4">50 以内</button>
            <button type="button" class="tier-btn" data-tier="5">60 以内</button>
            <button type="button" class="tier-btn" data-tier="6">70 以内</button>
            <button type="button" class="tier-btn" data-tier="7">80 以内</button>
            <button type="button" class="tier-btn" data-tier="8">90 以内</button>
            <button type="button" class="tier-btn" data-tier="9">100 以内</button>
            <button type="button" class="tier-btn special" data-tier="10">表内乘除综合</button>
          </div>
        </div>

        <!-- 题量与限时 -->
        <div class="form-group" style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 240px;">
            <label class="form-label"><span>🎯 目标题量</span></label>
            <div class="pill-row" id="count-pills">
              <button type="button" class="pill-btn" data-count="30">30 题</button>
              <button type="button" class="pill-btn active" data-count="50">50 题（推荐）</button>
              <button type="button" class="pill-btn" data-count="100">100 题</button>
              <button type="button" class="pill-btn" data-count="0">极速刷题</button>
            </div>
          </div>
          <div style="flex: 1; min-width: 240px;">
            <label class="form-label"><span>⏱️ 限时挑战</span></label>
            <div class="pill-row" id="time-pills">
              <button type="button" class="pill-btn active" data-time="300">5 分钟</button>
              <button type="button" class="pill-btn" data-time="180">3 分钟</button>
              <button type="button" class="pill-btn" data-time="600">10 分钟</button>
              <button type="button" class="pill-btn" data-time="0">不限时</button>
            </div>
          </div>
        </div>

        <!-- 启动操作区 -->
        <div class="setup-actions">
          <button type="button" id="btn-start" class="btn-start">
            ⚡ 立即开始口算冲关
          </button>
          <div class="sub-actions">
            <button type="button" id="btn-view-mistakes" class="btn-sub">
              📕 错题本 (<span id="txt-mistake-count">0</span>)
            </button>
            <button type="button" id="btn-view-history" class="btn-sub">
              🏆 历史战绩
            </button>
            <button type="button" id="btn-get-standalone" class="btn-sub" title="无网离线单文件版">
              💾 下载离线单文件
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. 核心答题竞技页 -->
    <section id="view-play" class="view-panel">
      <!-- 实时状态 HUD -->
      <div class="play-hud">
        <div class="hud-col">
          <span class="hud-label">当前梯度</span>
          <span class="hud-val" id="hud-tier-name">10 以内</span>
        </div>
        <div class="hud-col hud-progress">
          <div class="prog-text">
            <span>第 <strong id="hud-q-idx" style="color:var(--brand)">1</strong> / <span id="hud-q-total">50</span> 题</span>
            <span>正确率 <strong id="hud-q-acc" style="color:#059669">100%</strong></span>
          </div>
          <div class="prog-track">
            <div class="prog-fill" id="hud-prog-bar" style="width: 2%"></div>
          </div>
        </div>
        <div class="hud-col" id="hud-timer-box">
          <span class="hud-label">剩余时间</span>
          <span class="hud-val" id="hud-timer-txt">05:00</span>
        </div>
        <div class="hud-col hud-combo">
          <span id="hud-fire" class="combo-fire" style="font-size:1.3rem">🔥</span>
          <span class="combo-num" id="hud-streak-val">0</span>
          <span style="font-size:0.75rem; color:#92400e; font-weight:600">连对</span>
        </div>
        <button type="button" id="btn-pause" class="btn-sub" style="padding:0.4rem 0.75rem">⏸️ 暂停</button>
      </div>

      <!-- 核心算式舞台 -->
      <div class="math-card-stage" id="card-stage">
        <!-- 晋级全屏横幅 (默认 hidden) -->
        <div class="levelup-banner" id="banner-levelup" hidden>
          <div style="font-size:2rem; margin-bottom:0.25rem">🎉 ⭐ ⚡</div>
          <div style="font-size:1.75rem; font-weight:900" id="txt-levelup-title">恭喜晋级！进入 20 以内数段！</div>
          <div style="font-size:1rem; font-weight:600; margin-top:0.25rem" id="txt-levelup-sub">攻克进退位与破十法，继续冲刺！</div>
        </div>

        <!-- 浮动飘字层 -->
        <div class="float-layer" id="float-layer"></div>

        <!-- 算式卡片核心展示区 -->
        <div class="equation-area">
          <!-- A. 常规计算题 (12 + 15 = ?) -->
          <div class="eq-row" id="row-calc">
            <span class="eq-expr" id="txt-calc-expr">12 + 15</span>
            <span class="eq-op">=</span>
            <div class="eq-input-slot" id="slot-calc">
              <span id="txt-calc-val"></span>
              <span class="slot-cursor"></span>
            </div>
          </div>

          <!-- B. 比大小题 (38 + 24 ○ 60) -->
          <div class="eq-row" id="row-comp" hidden>
            <span class="eq-comp-part" id="txt-comp-left">38 + 24</span>
            <div class="eq-comp-circle" id="circle-comp">○</div>
            <span class="eq-comp-part" id="txt-comp-right">60</span>
          </div>
        </div>

        <!-- 智能互斥键盘 -->
        <!-- 比大小：只显示超大 > = < 符号 -->
        <div class="keypad-comp" id="keys-comp" hidden>
          <button type="button" class="btn-comp btn-greater" data-sym=">">
            <span class="sym">&gt;</span>
            <span class="sym-name">大于</span>
            <span class="key-hint">键盘 &gt; 或 .</span>
          </button>
          <button type="button" class="btn-comp btn-equal" data-sym="=">
            <span class="sym">=</span>
            <span class="sym-name">等于</span>
            <span class="key-hint">键盘 = 或回车</span>
          </button>
          <button type="button" class="btn-comp btn-less" data-sym="<">
            <span class="sym">&lt;</span>
            <span class="sym-name">小于</span>
            <span class="key-hint">键盘 &lt; 或 ,</span>
          </button>
        </div>

        <!-- 常规计算：0-9 触控键盘 -->
        <div class="keypad-calc" id="keys-calc">
          <div class="num-grid">
            <button type="button" class="num-key" data-k="1">1</button>
            <button type="button" class="num-key" data-k="2">2</button>
            <button type="button" class="num-key" data-k="3">3</button>
            <button type="button" class="num-key" data-k="4">4</button>
            <button type="button" class="num-key" data-k="5">5</button>
            <button type="button" class="num-key" data-k="6">6</button>
            <button type="button" class="num-key" data-k="7">7</button>
            <button type="button" class="num-key" data-k="8">8</button>
            <button type="button" class="num-key" data-k="9">9</button>
            <button type="button" class="num-key action-c" data-k="clear">C</button>
            <button type="button" class="num-key" data-k="0">0</button>
            <button type="button" class="num-key action-b" data-k="back">⌫</button>
          </div>
          <button type="button" class="btn-submit" id="btn-submit-calc">
            ✓ 确认提交 (Enter)
          </button>
        </div>
      </div>

      <p class="play-hint">💡 支持实体键盘数字键直接键入与回车提交 · 随时按 Esc 键暂停</p>
    </section>

    <!-- 3. 大结算报告页 -->
    <section id="view-result" class="view-panel">
      <div class="result-card">
        <div class="trophy-icon" id="res-trophy">🏆</div>
        <h2 style="font-size:1.85rem; font-weight:800; margin-bottom:0.25rem">练习大通关！</h2>
        <div class="honor-tag" id="res-honor">速算小能手</div>

        <div class="metrics-grid">
          <div class="metric-card">
            <span class="v" id="res-total">0</span>
            <span class="l">总作答题数</span>
          </div>
          <div class="metric-card good">
            <span class="v" id="res-acc">0%</span>
            <span class="l">正确率</span>
          </div>
          <div class="metric-card">
            <span class="v" id="res-speed">0.0s</span>
            <span class="l">平均每题</span>
          </div>
          <div class="metric-card">
            <span class="v" id="res-streak">0</span>
            <span class="l">最高连对</span>
          </div>
        </div>

        <p class="result-msg" id="res-summary-msg">
          表现优异！进位加减法熟练度达到高阶水平，坚持练习运算更快更准！
        </p>

        <!-- 本轮错题列表 -->
        <div class="round-mistakes-box" id="box-round-mistakes" hidden>
          <h4>⚠️ 本轮存在 <span id="txt-round-m-count">0</span> 道错题，已自动沉淀到错题本：</h4>
          <div class="round-mistakes-list" id="list-round-mistakes"></div>
        </div>

        <div class="result-buttons">
          <button type="button" id="btn-replay" class="btn-start" style="max-width:200px; padding:0.75rem 1.25rem">
            🔁 再来一轮
          </button>
          <button type="button" id="btn-redo-mistakes" class="btn-sub" style="background:#fff1f2; color:#e11d48; border-color:#fecdd3" hidden>
            🎯 立即重做错题
          </button>
          <button type="button" id="btn-go-home" class="btn-sub">
            🏠 返回主菜单
          </button>
        </div>
      </div>
    </section>
  </main>

  <!-- 4. 模态弹窗系统 (全声明 hidden 且严格控制) -->
  <!-- 暂停弹窗 -->
  <div class="modal-overlay" id="modal-pause" hidden>
    <div class="modal-box">
      <h3 style="font-size:1.35rem; font-weight:800; margin-bottom:0.5rem">⏸️ 练习已暂停</h3>
      <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:1.25rem">稍事休息，放松双眼，准备好随时继续！</p>
      <div style="display:flex; flex-direction:column; gap:0.6rem">
        <button type="button" id="btn-resume" class="btn-start" style="padding:0.75rem">▶️ 继续练习</button>
        <button type="button" id="btn-restart" class="btn-sub">🔁 重新开始本轮</button>
        <button type="button" id="btn-quit" class="btn-sub" style="color:#dc2626">🚪 退出到设置</button>
      </div>
    </div>
  </div>

  <!-- 错题本弹窗 -->
  <div class="modal-overlay" id="modal-mistakes" hidden>
    <div class="modal-box wide">
      <div class="modal-head">
        <h3>📕 错题专练闭环</h3>
        <button type="button" class="modal-close-btn" id="btn-close-m">✕</button>
      </div>
      <p class="modal-desc">系统已沉淀所有答错的题目。掌握一道即移除一道，点击「一键重做」直到完全消灭！</p>
