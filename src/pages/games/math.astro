    // -------------------------------------------------------------
    // 3. 粒子物理动效引擎 (Canvas Particles & Confetti)
    // -------------------------------------------------------------
    let fxCtx = null;
    let particles = [];
    let fxAnimId = null;

    function initFxCanvas() {
      if (!els.fxCanvas) return;
      fxCtx = els.fxCanvas.getContext('2d');
      resizeFxCanvas();
      window.addEventListener('resize', resizeFxCanvas);
    }

    function resizeFxCanvas() {
      if (!els.fxCanvas) return;
      els.fxCanvas.width = window.innerWidth;
      els.fxCanvas.height = window.innerHeight;
    }

    function spawnBurst(x, y, count = 35, colors = ['#f59e0b', '#10b981', '#3b82f6', '#ec4899', '#8b5cf6']) {
      for (let i = 0; i < count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 8 + 3;
        particles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 2,
          size: Math.random() * 8 + 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          alpha: 1,
          decay: Math.random() * 0.025 + 0.015,
          shape: Math.random() > 0.5 ? 'circle' : 'star',
          rot: Math.random() * Math.PI,
          vrot: (Math.random() - 0.5) * 0.2
        });
      }
      if (!fxAnimId) {
        fxAnimId = requestAnimationFrame(renderParticles);
      }
    }

    function spawnFireworks() {
      const cx = window.innerWidth / 2;
      const cy = window.innerHeight / 2;
      spawnBurst(cx - 160, cy - 80, 50);
      spawnBurst(cx + 160, cy - 80, 50);
      spawnBurst(cx, cy - 140, 60, ['#ffd700', '#ff6b6b', '#48dbfb', '#1dd1a1']);
    }

    function renderParticles() {
      if (!fxCtx) return;
      fxCtx.clearRect(0, 0, els.fxCanvas.width, els.fxCanvas.height);

      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.2; // gravity
        p.alpha -= p.decay;
        p.rot += p.vrot;

        if (p.alpha <= 0) {
          particles.splice(i, 1);
          continue;
        }

        fxCtx.save();
        fxCtx.globalAlpha = p.alpha;
        fxCtx.translate(p.x, p.y);
        fxCtx.rotate(p.rot);
        fxCtx.fillStyle = p.color;

        if (p.shape === 'circle') {
          fxCtx.beginPath();
          fxCtx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
          fxCtx.fill();
        } else {
          // 五角星
          drawStar(fxCtx, 0, 0, 5, p.size, p.size / 2);
          fxCtx.fill();
        }
        fxCtx.restore();
      }

      if (particles.length > 0) {
        fxAnimId = requestAnimationFrame(renderParticles);
      } else {
        fxAnimId = null;
      }
    }

    function drawStar(ctx, cx, cy, spikes, outerRadius, innerRadius) {
      let rot = (Math.PI / 2) * 3;
      let x = cx;
      let y = cy;
      const step = Math.PI / spikes;

      ctx.beginPath();
      ctx.moveTo(cx, cy - outerRadius);
      for (let i = 0; i < spikes; i++) {
        x = cx + Math.cos(rot) * outerRadius;
        y = cy + Math.sin(rot) * outerRadius;
        ctx.lineTo(x, y);
        rot += step;

        x = cx + Math.cos(rot) * innerRadius;
        y = cy + Math.sin(rot) * innerRadius;
        ctx.lineTo(x, y);
        rot += step;
      }
      ctx.lineTo(cx, cy - outerRadius);
      ctx.closePath();
    }

    // 动态飘字特效
    function spawnFloatText(text, isGood = true) {
      if (!els.floatLayer) return;
      const el = document.createElement('div');
      el.className = `float-popup ${isGood ? 'good' : 'bad'}`;
      el.textContent = text;
      els.floatLayer.appendChild(el);

      setTimeout(() => {
        el.remove();
      }, 1200);
    }

    // -------------------------------------------------------------
    // 4. 草稿纸手写绘图板 (Canvas Handwriting Scratchpad)
    // -------------------------------------------------------------
    let padCtx = null;
    let isDrawing = false;
    let padColor = '#1e293b';
    let padWidth = 3;
    let isEraser = false;
    let lastX = 0;
    let lastY = 0;

    function initScratchpad() {
      if (!els.scratchCanvas) return;
      padCtx = els.scratchCanvas.getContext('2d');
      resizeScratchCanvas();
      window.addEventListener('resize', resizeScratchCanvas);

      // 触控与鼠标事件
      const c = els.scratchCanvas;
      c.addEventListener('pointerdown', startDraw);
      c.addEventListener('pointermove', drawMove);
      c.addEventListener('pointerup', endDraw);
      c.addEventListener('pointercancel', endDraw);

      // 工具栏交互
      els.padColorDots.forEach(dot => {
        dot.addEventListener('click', () => {
          els.padColorDots.forEach(d => d.classList.remove('active'));
          dot.classList.add('active');
          padColor = dot.getAttribute('data-color');
          isEraser = false;
          els.padToolEraser.classList.remove('active');
        });
      });

      els.padToolEraser.addEventListener('click', () => {
        isEraser = !isEraser;
        els.padToolEraser.classList.toggle('active', isEraser);
      });

      els.padToolClear.addEventListener('click', clearScratchpad);
      els.padToolHide.addEventListener('click', toggleScratchpad);
      els.btnScratchpad.addEventListener('click', toggleScratchpad);
    }

    function resizeScratchCanvas() {
      if (!els.scratchCanvas || !els.scratchDrawer) return;
      const rect = els.scratchDrawer.getBoundingClientRect();
      const w = rect.width || window.innerWidth;
      const h = (rect.height || 360) - 50; // 减去头部
      if (w > 0 && h > 0) {
        // 保存现有绘图
        const temp = padCtx ? padCtx.getImageData(0, 0, els.scratchCanvas.width, els.scratchCanvas.height) : null;
        els.scratchCanvas.width = w;
        els.scratchCanvas.height = h;
        if (temp && padCtx) {
          padCtx.putImageData(temp, 0, 0);
        }
      }
    }

    function getCanvasCoords(e) {
      const rect = els.scratchCanvas.getBoundingClientRect();
      return {
        x: e.clientX - rect.left,
        y: e.clientY - rect.top
      };
    }

    function startDraw(e) {
      isDrawing = true;
      const pos = getCanvasCoords(e);
      lastX = pos.x;
      lastY = pos.y;
    }

    function drawMove(e) {
      if (!isDrawing || !padCtx) return;
      const pos = getCanvasCoords(e);

      padCtx.beginPath();
      padCtx.moveTo(lastX, lastY);
      padCtx.lineTo(pos.x, pos.y);
      padCtx.lineCap = 'round';
      padCtx.lineJoin = 'round';

      if (isEraser) {
        padCtx.strokeStyle = '#ffffff';
        padCtx.lineWidth = 24;
      } else {
        padCtx.strokeStyle = padColor;
        padCtx.lineWidth = padWidth;
      }
      padCtx.stroke();

      lastX = pos.x;
      lastY = pos.y;
    }

    function endDraw() {
      isDrawing = false;
    }

    function clearScratchpad() {
      if (!padCtx) return;
      padCtx.clearRect(0, 0, els.scratchCanvas.width, els.scratchCanvas.height);
      soundClick();
    }

    function toggleScratchpad() {
      const isHidden = els.scratchDrawer.hidden;
      els.scratchDrawer.hidden = !isHidden;
      els.btnScratchpad.classList.toggle('active', isHidden);
      if (isHidden) {
        setTimeout(resizeScratchCanvas, 50);
      }
      soundClick();
    }

    // -------------------------------------------------------------
    // 5. 错题本与历史战绩存储 (Local Storage)
    // -------------------------------------------------------------
    const STORAGE_KEY_MISTAKES = 'kousuan_mistakes_v1';
    const STORAGE_KEY_HISTORY = 'kousuan_history_v1';

    function getStoredMistakes() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY_MISTAKES);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveStoredMistakes(list) {
      try {
        localStorage.setItem(STORAGE_KEY_MISTAKES, JSON.stringify(list));
        updateMistakeBadge();
      } catch (e) {}
    }

    function addMistake(question, userAns) {
      const list = getStoredMistakes();
      // 避免重复记录相同题目
      const exists = list.some(item => item.hash === question.hash);
      if (!exists) {
        list.push({
          id: Date.now() + '_' + Math.random().toString(36).substring(2, 6),
          hash: question.hash,
          type: question.type,
          expr: question.type === 'calc' ? question.expr : `${question.leftText} ○ ${question.rightText}`,
          correctAnswer: question.answer,
          userAnswer: userAns,
          time: new Date().toLocaleDateString('zh-CN')
        });
        saveStoredMistakes(list);
      }
    }

    function removeMistakeByHash(hash) {
      let list = getStoredMistakes();
      list = list.filter(m => m.hash !== hash);
      saveStoredMistakes(list);
    }

    function updateMistakeBadge() {
      const list = getStoredMistakes();
      if (els.mistakeBadge) {
        els.mistakeBadge.textContent = list.length;
      }
    }

    function getStoredHistory() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY_HISTORY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }

    function saveHistoryRecord(record) {
      try {
        const list = getStoredHistory();
        list.unshift(record);
        if (list.length > 50) list.pop(); // 保留最近 50 次
        localStorage.setItem(STORAGE_KEY_HISTORY, JSON.stringify(list));
      } catch (e) {}
    }

    // -------------------------------------------------------------
    // 6. 游戏流程控制
    // -------------------------------------------------------------
    function switchView(viewName) {
      els.viewSetup.classList.remove('active');
      els.viewPlay.classList.remove('active');
      els.viewResult.classList.remove('active');

      if (viewName === 'setup') els.viewSetup.classList.add('active');
      if (viewName === 'play') els.viewPlay.classList.add('active');
      if (viewName === 'result') els.viewResult.classList.add('active');
    }

    function startGame(isDrill = false) {
      initAudio();
      state.isPaused = false;
      state.seenHashes.clear();
      state.currentIndex = 0;
      state.totalAnswered = 0;
      state.correctCount = 0;
      state.currentStreak = 0;
      state.maxStreak = 0;
      state.tierStreak = 0;
      state.roundMistakes = [];
      state.inputValue = '';
      state.totalQuestionTime = 0;

      if (isDrill) {
        state.mode = 'drill';
        const mistakes = getStoredMistakes();
        state.drillQueue = [...mistakes];
        state.targetCount = state.drillQueue.length;
        state.timeLimit = 0;
      } else {
        if (state.mode === 'progressive') {
          state.currentTier = 0; // 从 10 以内开始
        } else {
          state.currentTier = state.customTier;
        }
      }

      state.timeLeft = state.timeLimit;
      state.startTime = Date.now();

      // UI 初始化
      updatePlayHUD();
      switchView('play');
      startTimer();
      nextQuestion();
      soundClick();
    }

    function startTimer() {
      clearInterval(state.timerId);
      if (state.timeLimit <= 0) {
        els.hudTimeContainer.hidden = true;
        return;
      }
      els.hudTimeContainer.hidden = false;
      updateTimerDisplay();

      state.timerId = setInterval(() => {
        if (state.isPaused) return;
        state.timeLeft--;
        updateTimerDisplay();

        if (state.timeLeft <= 0) {
          clearInterval(state.timerId);
          finishGame('时间耗尽');
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const m = Math.floor(state.timeLeft / 60);
      const s = state.timeLeft % 60;
      els.hudTimerText.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      if (state.timeLeft <= 30) {
        els.hudTimerText.classList.add('urgent');
      } else {
        els.hudTimerText.classList.remove('urgent');
      }
    }

    function nextQuestion() {
      // 检查是否达到目标题量
      if (state.targetCount > 0 && state.currentIndex >= state.targetCount) {
        finishGame('达到目标题量');
        return;
      }

      state.currentIndex++;
      state.inputValue = '';
      state.questionStartTime = Date.now();

      if (state.mode === 'drill') {
        // 错题重做模式
        const item = state.drillQueue[state.currentIndex - 1];
        if (!item) {
          finishGame('错题全部重做完成');
          return;
        }
        if (item.type === 'calc') {
          state.currentQuestion = {
            type: 'calc',
            expr: item.expr,
            answer: item.correctAnswer,
            hash: item.hash
          };
        } else {
          const parts = item.expr.split('○');
          state.currentQuestion = {
            type: 'compare',
            leftText: parts[0]?.trim() || '',
            rightText: parts[1]?.trim() || '',
            answer: item.correctAnswer,
            hash: item.hash
          };
        }
      } else {
        state.currentQuestion = generateQuestion(state.currentTier, state.seenHashes);
      }

      renderCurrentQuestion();
      updatePlayHUD();
    }

    function renderCurrentQuestion() {
      const q = state.currentQuestion;
      if (!q) return;

      if (q.type === 'compare') {
        // 比大小题型
        els.eqCalcRow.hidden = true;
        els.eqCompRow.hidden = false;
        els.eqCompLeft.textContent = q.leftText;
        els.eqCompRight.textContent = q.rightText;
        els.eqCompCircle.textContent = '○';
        els.eqCompCircle.className = 'eq-comp-circle';

        // 互斥显示：隐藏数字键盘，只展示 3 个超大比大小符号键
        els.keypadCalc.hidden = true;
        els.keypadCompare.hidden = false;
      } else {
        // 常规计算题型
        els.eqCompRow.hidden = true;
        els.eqCalcRow.hidden = false;
        els.eqCalcExpr.textContent = q.expr;
        els.eqSlotVal.textContent = '';
        els.eqSlotVal.parentElement.classList.remove('has-val');

        // 互斥显示：隐藏比大小按键，展示 0-9 数字键盘
        els.keypadCompare.hidden = true;
        els.keypadCalc.hidden = false;
      }
    }

    function updatePlayHUD() {
      // 当前数段显示
      if (state.mode === 'drill') {
        els.hudTier.textContent = '错题专训模式';
      } else {
        const t = TIERS[state.currentTier] || TIERS[0];
        els.hudTier.textContent = state.mode === 'progressive' ? `第 ${state.currentTier + 1}/11 关 · ${t.name}` : t.name;
      }

      els.hudIndex.textContent = state.currentIndex || 1;
      els.hudTotal.textContent = state.targetCount > 0 ? state.targetCount : '∞';

      // 正确率
      const acc = state.totalAnswered > 0 ? Math.round((state.correctCount / state.totalAnswered) * 100) : 100;
      els.hudAccuracy.textContent = `${acc}%`;

      // 进度条
      const pct = state.targetCount > 0 ? Math.min(100, Math.round((state.currentIndex / state.targetCount) * 100)) : 100;
      els.hudProgressFill.style.width = `${pct}%`;

      // 连对与火焰动效
      els.hudComboVal.textContent = state.currentStreak;
      if (state.currentStreak >= 5) {
        els.comboFlame.classList.add('fire-active');
      } else {
        els.comboFlame.classList.remove('fire-active');
      }
    }

    // 提交作答判定
    function evaluateAnswer(userAnswer) {
      if (!state.currentQuestion) return;

      const q = state.currentQuestion;
      const isCorrect = String(userAnswer).trim() === String(q.answer).trim();
      const costSec = Math.max(0.5, (Date.now() - state.questionStartTime) / 1000);
      state.totalQuestionTime += costSec;
      state.totalAnswered++;

      if (isCorrect) {
        state.correctCount++;
        state.currentStreak++;
        state.tierStreak++;
        if (state.currentStreak > state.maxStreak) {
          state.maxStreak = state.currentStreak;
        }

        // 音效与粒子
        soundCorrect();
        const rect = els.cardStage.getBoundingClientRect();
        spawnBurst(rect.left + rect.width / 2, rect.top + rect.height * 0.4, 30);

        // 浮动飘字
        let floatMsg = '+10 ⭐';
        if (state.currentStreak >= 3) {
          floatMsg = `+${10 + state.currentStreak * 2} 🔥 ${state.currentStreak}连对!`;
        }
        if (costSec < 2.0) {
          floatMsg += ' ⚡极速!';
        }
        spawnFloatText(floatMsg, true);

        // 如果是错题重做模式且答对了，从持久化错题本中移除该题
        if (state.mode === 'drill') {
          removeMistakeByHash(q.hash);
        }

        // 检查平滑晋级闯关逻辑：每连对 3 题，数段自动平滑晋级
        if (state.mode === 'progressive' && state.tierStreak >= 3 && state.currentTier < TIERS.length - 1) {
          state.tierStreak = 0;
          state.currentTier++;
          triggerLevelUpBanner(TIERS[state.currentTier]);
        } else {
          setTimeout(nextQuestion, 280);
        }
      } else {
        // 答错处理
        state.currentStreak = 0;
        state.tierStreak = 0;
        soundWrong();
        spawnFloatText('加油，继续冲! ❌', false);

        // 记录错题
        const mistakeItem = {
          hash: q.hash,
          type: q.type,
          expr: q.type === 'calc' ? q.expr : `${q.leftText} ○ ${q.rightText}`,
          userAnswer: userAnswer || '(未填)',
          correctAnswer: q.answer
        };
        state.roundMistakes.push(mistakeItem);
        addMistake(q, userAnswer);

        // 错题在卡片短暂显示正确答案强化记忆
        if (q.type === 'compare') {
          els.eqCompCircle.textContent = q.answer;
          els.eqCompCircle.classList.add('circle-wrong');
        } else {
          els.eqSlotVal.textContent = q.answer;
          els.eqSlotVal.parentElement.classList.add('slot-wrong');
        }

        setTimeout(() => {
          if (q.type === 'compare') {
            els.eqCompCircle.classList.remove('circle-wrong');
          } else {
            els.eqSlotVal.parentElement.classList.remove('slot-wrong');
          }
          nextQuestion();
        }, 1100);
      }
    }

    // 全屏金色晋级横幅动效
    function triggerLevelUpBanner(tierObj) {
      soundLevelUp();
      spawnFireworks();
      els.levelupTitle.textContent = `🎉 恭喜晋级！进入【${tierObj.name}】！`;
      els.levelupSub.textContent = tierObj.title;
      els.levelupBanner.hidden = false;
      els.levelupBanner.classList.add('pop-in');

      setTimeout(() => {
        els.levelupBanner.classList.remove('pop-in');
        els.levelupBanner.hidden = true;
        nextQuestion();
      }, 1600);
    }

    // 结算大报告
    function finishGame(reason) {
      clearInterval(state.timerId);
      soundVictory();
      spawnFireworks();

      const acc = state.totalAnswered > 0 ? Math.round((state.correctCount / state.totalAnswered) * 100) : 0;
      const avgSpeed = state.totalAnswered > 0 ? (state.totalQuestionTime / state.totalAnswered).toFixed(1) : '0.0';

      // 称号计算
      let honor = '🌱 计算新星';
      let trophy = '🎖️';
      let summary = '每一次练习都是心算肌肉的积累，继续坚持，你将更快更准！';

      if (acc >= 98 && parseFloat(avgSpeed) <= 3.0) {
        honor = '⚡ 无敌神算子';
        trophy = '👑';
        summary = '太震撼了！极速且零失误，你就是名副其实的心算战神！';
      } else if (acc >= 95) {
        honor = '🏆 数学小天才';
        trophy = '🏆';
        summary = '准确率超过 95%，数字直觉超强，进退位运用自如！';
      } else if (acc >= 90) {
        honor = '🌟 心算大师';
        trophy = '🌟';
        summary = '扎实的运算功底，已经完全掌握当前数段技巧！';
      } else if (acc >= 80) {
        honor = '✨ 速算小能手';
        trophy = '⭐';
        summary = '表现非常出色！稍微留意细节，就能冲击全对！';
      } else if (acc < 60) {
        honor = '☀️ 口算萌芽';
        trophy = '🌱';
        summary = '不要气馁！多用内置草稿纸随手列竖式，多练几次就能突飞猛进！';
      }

      els.resHonor.textContent = honor;
      els.resTrophy.textContent = trophy;
      els.resSummaryMsg.textContent = summary;

      // 平滑滚动数字展示
      animateValue(els.resTotal, 0, state.totalAnswered, 800, '');
      animateValue(els.resAccuracy, 0, acc, 800, '%');
      animateValue(els.resStreak, 0, state.maxStreak, 800, '');
      els.resSpeed.textContent = `${avgSpeed}s`;

      // 错题展示与一键重做
      if (state.roundMistakes.length > 0) {
        els.roundMistakesBox.hidden = false;
        els.btnRedoMistakes.hidden = false;
        els.roundMistakesCount.textContent = state.roundMistakes.length;
        els.roundMistakesList.innerHTML = state.roundMistakes.map(m => `
          <div class="m-card">
            <span class="m-expr">${m.expr}</span>
            <span class="m-diff">你的答案: <strong class="wrong">${m.userAnswer}</strong> ➔ 正确: <strong class="correct">${m.correctAnswer}</strong></span>
          </div>
        `).join('');
      } else {
        els.roundMistakesBox.hidden = true;
        els.btnRedoMistakes.hidden = true;
      }

      // 保存历史记录
      saveHistoryRecord({
        date: new Date().toLocaleDateString('zh-CN'),
        total: state.totalAnswered,
        correct: state.correctCount,
        accuracy: acc,
        avgSpeed: avgSpeed,
        maxStreak: state.maxStreak,
        honor: honor
      });

      updateMistakeBadge();
      switchView('result');
    }

    function animateValue(elem, start, end, duration, suffix = '') {
      let startTimestamp = null;
      const step = (timestamp) => {
        if (!startTimestamp) startTimestamp = timestamp;
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        const val = Math.floor(progress * (end - start) + start);
        elem.textContent = val + suffix;
        if (progress < 1) {
          window.requestAnimationFrame(step);
        } else {
          elem.textContent = end + suffix;
        }
      };
      window.requestAnimationFrame(step);
    }

    // -------------------------------------------------------------
    // 7. 交互绑定 (按键、键盘、弹窗)
    // -------------------------------------------------------------
    function setupInteractions() {
      // 模式切换
      els.modeTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          els.modeTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          state.mode = tab.getAttribute('data-mode');
          if (state.mode === 'progressive') {
            els.tierTipText.textContent = '当前：逐级闯关模式将从 10 以内开始动态递增';
            els.tierChips.forEach((c, idx) => c.classList.toggle('active', idx === 0));
          } else {
            els.tierTipText.textContent = '当前：自选模式，可随意点击下方任意数段开始高强度专练';
          }
          soundClick();
        });
      });

      // 梯级选择
      els.tierChips.forEach(chip => {
        chip.addEventListener('click', () => {
          els.tierChips.forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          const tIdx = parseInt(chip.getAttribute('data-tier'), 10);
          state.customTier = tIdx;
          // 切换到自选模式
          els.modeTabs.forEach(t => t.classList.toggle('active', t.getAttribute('data-mode') === 'custom'));
          state.mode = 'custom';
          els.tierTipText.textContent = `已锁定梯级：【${TIERS[tIdx].name}】${TIERS[tIdx].title}`;
          soundClick();
        });
      });

      // 题量选择
      els.countPills.forEach(pill => {
        pill.addEventListener('click', () => {
          els.countPills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          state.targetCount = parseInt(pill.getAttribute('data-count'), 10);
          soundClick();
        });
      });

      // 限时选择
      els.timePills.forEach(pill => {
        pill.addEventListener('click', () => {
          els.timePills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          state.timeLimit = parseInt(pill.getAttribute('data-time'), 10);
          soundClick();
        });
      });

      // 启动游戏
      els.btnStart.addEventListener('click', () => startGame(false));

      // 比大小按键点击（点击瞬间自动提交判定）
      els.keypadCompare.querySelectorAll('.btn-comp').forEach(btn => {
        btn.addEventListener('click', () => {
          const sym = btn.getAttribute('data-symbol');
          soundClick();
          els.eqCompCircle.textContent = sym;
          evaluateAnswer(sym);
        });
      });

      // 常规计算数字按键点击
      els.keypadCalc.querySelectorAll('.num-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-key');
          soundClick();
          handleCalcKey(key);
        });
      });

      // 确认提交计算
      els.btnSubmitCalc.addEventListener('click', () => {
        if (!state.inputValue) return;
        soundClick();
        evaluateAnswer(state.inputValue);
      });

      // 实体键盘监听 (全按键智能映射)
      window.addEventListener('keydown', (e) => {
        if (!els.viewPlay.classList.contains('active') || state.isPaused) {
          if (e.key === 'p' || e.key === 'P') togglePause();
          return;
        }

        const q = state.currentQuestion;
        if (!q) return;

        if (q.type === 'compare') {
          // 比大小模式键盘映射
          if (e.key === '>' || e.key === '.') {
            e.preventDefault();
            soundClick();
            els.eqCompCircle.textContent = '>';
            evaluateAnswer('>');
          } else if (e.key === '<' || e.key === ',') {
            e.preventDefault();
            soundClick();
            els.eqCompCircle.textContent = '<';
            evaluateAnswer('<');
          } else if (e.key === '=' || e.key === 'Enter') {
            e.preventDefault();
            soundClick();
            els.eqCompCircle.textContent = '=';
            evaluateAnswer('=');
          }
        } else {
          // 常规计算键盘映射
          if (/^[0-9]$/.test(e.key)) {
            soundClick();
            handleCalcKey(e.key);
          } else if (e.key === 'Backspace') {
            soundClick();
            handleCalcKey('back');
          } else if (e.key === 'c' || e.key === 'C' || e.key === 'Delete') {
            soundClick();
            handleCalcKey('clear');
          } else if (e.key === 'Enter') {
            if (state.inputValue) {
              soundClick();
              evaluateAnswer(state.inputValue);
            }
          }
        }

        if (e.key === 'Escape' || e.key === 'p' || e.key === 'P') {
          togglePause();
        }
      });

      // 暂停按钮
      els.btnPause.addEventListener('click', togglePause);
      els.btnResume.addEventListener('click', togglePause);
      els.btnRestart.addEventListener('click', () => {
        els.modalPause.hidden = true;
        startGame(state.mode === 'drill');
      });
      els.btnQuit.addEventListener('click', () => {
        clearInterval(state.timerId);
        els.modalPause.hidden = true;
        switchView('setup');
      });

      // 结算面板按钮
      els.btnPlayAgain.addEventListener('click', () => startGame(false));
      els.btnRedoMistakes.addEventListener('click', () => startGame(true));
      els.btnResultHome.addEventListener('click', () => switchView('setup'));

      // 错题本模态框
      els.btnOpenMistakes.addEventListener('click', openMistakesModal);
      els.btnCloseMistakes.addEventListener('click', () => { els.modalMistakes.hidden = true; });
      els.btnDrillMistakes.addEventListener('click', () => {
        els.modalMistakes.hidden = true;
        startGame(true);
      });
      els.btnClearMistakes.addEventListener('click', () => {
        if (confirm('确认清空所有已记录的错题？')) {
          saveStoredMistakes([]);
          openMistakesModal();
        }
      });

      // 历史战绩模态框
      els.btnOpenHistory.addEventListener('click', openHistoryModal);
      els.btnCloseHistory.addEventListener('click', () => { els.modalHistory.hidden = true; });

      // 音效开关
      els.btnSound.addEventListener('click', () => {
        isMuted = !isMuted;
        localStorage.setItem('kousuan_muted', String(isMuted));
        els.btnSound.textContent = isMuted ? '🔇 静音' : '🔊 音效';
        soundClick();
      });
      els.btnSound.textContent = isMuted ? '🔇 静音' : '🔊 音效';

      // 护眼模式切换
      els.btnTheme.addEventListener('click', () => {
        const isWarm = els.app.classList.toggle('eye-protection');
        localStorage.setItem('kousuan_eye_mode', String(isWarm));
        els.btnTheme.textContent = isWarm ? '☀️ 明亮' : '🌿 护眼';
        soundClick();
      });
      if (localStorage.getItem('kousuan_eye_mode') === 'true') {
        els.app.classList.add('eye-protection');
        els.btnTheme.textContent = '☀️ 明亮';
      }

      // 全屏模式切换
      els.btnFullscreen.addEventListener('click', toggleFullscreen);

      // 导出单文件离线版
      els.btnDownloadStandalone.addEventListener('click', downloadStandaloneHtml);
    }

    function handleCalcKey(key) {
      if (key === 'clear') {
        state.inputValue = '';
      } else if (key === 'back') {
        state.inputValue = state.inputValue.slice(0, -1);
      } else {
        if (state.inputValue.length < 6) {
          state.inputValue += key;
        }
      }
      els.eqSlotVal.textContent = state.inputValue;
      if (state.inputValue) {
        els.eqSlotVal.parentElement.classList.add('has-val');
      } else {
        els.eqSlotVal.parentElement.classList.remove('has-val');
      }
    }

    function togglePause() {
      state.isPaused = !state.isPaused;
      els.modalPause.hidden = !state.isPaused;
      soundClick();
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        els.app.requestFullscreen?.() || document.documentElement.requestFullscreen?.();
        els.btnFullscreen.textContent = '🗗 还原';
      } else {
        document.exitFullscreen?.();
        els.btnFullscreen.textContent = '⛶ 全屏';
      }
    }

    // 打开错题本模态框
    function openMistakesModal() {
      const list = getStoredMistakes();
      els.drillCountSpan.textContent = list.length;
      if (list.length === 0) {
        els.mistakesEmpty.hidden = false;
        els.mistakesList.innerHTML = '';
        els.btnDrillMistakes.disabled = true;
      } else {
        els.mistakesEmpty.hidden = true;
        els.btnDrillMistakes.disabled = false;
        els.mistakesList.innerHTML = list.map(m => `
          <div class="mistake-item">
            <div class="m-left">
              <span class="m-expr">${m.expr}</span>
              <span class="m-time">${m.time || ''}</span>
            </div>
            <div class="m-right">
              <span class="m-your">你的作答: <strong class="wrong">${m.userAnswer}</strong></span>
              <span class="m-ans">正确答案: <strong class="correct">${m.correctAnswer}</strong></span>
              <button type="button" class="btn-del-mistake" data-hash="${m.hash}" title="标记为已掌握并移除">✓ 已掌握</button>
            </div>
          </div>
        `).join('');

        els.mistakesList.querySelectorAll('.btn-del-mistake').forEach(btn => {
          btn.addEventListener('click', () => {
            const hash = btn.getAttribute('data-hash');
            removeMistakeByHash(hash);
            openMistakesModal();
          });
        });
      }
      els.modalMistakes.hidden = false;
      soundClick();
    }

    // 打开历史战绩模态框
    function openHistoryModal() {
      const logs = getStoredHistory();
      if (logs.length === 0) {
        els.historyEmpty.hidden = false;
        els.historyLogList.innerHTML = '<p class="history-empty">暂无练习历史，完成一轮练习后将在这里沉淀脚印！</p>';
        els.ltTotalCount.textContent = '0';
        els.ltAvgAcc.textContent = '0%';
        els.ltBestStreak.textContent = '0';
      } else {
        els.historyEmpty.hidden = true;
        let sumTotal = 0;
        let sumCorrect = 0;
        let maxS = 0;

        logs.forEach(l => {
          sumTotal += (l.total || 0);
          sumCorrect += (l.correct || 0);
          if ((l.maxStreak || 0) > maxS) maxS = l.maxStreak;
        });

        els.ltTotalCount.textContent = sumTotal;
        els.ltAvgAcc.textContent = sumTotal > 0 ? Math.round((sumCorrect / sumTotal) * 100) + '%' : '0%';
        els.ltBestStreak.textContent = maxS;

        els.historyLogList.innerHTML = logs.map(l => `
          <div class="history-row">
            <span class="h-date">${l.date}</span>
            <span class="h-honor">${l.honor || '速算小能手'}</span>
            <span class="h-stat">答题: ${l.total} 题</span>
            <span class="h-stat">正确率: <strong>${l.accuracy}%</strong></span>
            <span class="h-stat">速度: ${l.avgSpeed}s/题</span>
            <span class="h-stat">连对: 🔥${l.maxStreak}</span>
          </div>
        `).join('');
      }
      els.modalHistory.hidden = false;
      soundClick();
    }

    // 单文件离线导出逻辑
    function downloadStandaloneHtml() {
      soundClick();
      window.open('/games/math/standalone.html', '_blank');
    }

    // -------------------------------------------------------------
    // 8. 启动挂载
    // -------------------------------------------------------------
    initFxCanvas();
    initScratchpad();
    setupInteractions();
    updateMistakeBadge();
  })();
</script>

<style>
  /* 基础容器与童趣大字号护眼调色 */
  .math-app-container {
    --bg-primary: #f8fafc;
    --surface-card: #ffffff;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --brand-color: #2563eb;
    --brand-hover: #1d4ed8;
    --accent-gold: #f59e0b;
    --accent-emerald: #10b981;
    --accent-rose: #f43f5e;
    --border-color: #e2e8f0;
    --shadow-soft: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
    --shadow-elevated: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    
    position: relative;
    width: 100%;
    min-height: 85vh;
    background: var(--bg-primary);
    color: var(--text-main);
    border-radius: 1.25rem;
    padding: 1.25rem;
    box-sizing: border-box;
    overflow: hidden;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', sans-serif;
    user-select: none;
    transition: background 0.3s, color 0.3s;
  }

  /* 护眼暖色模式 */
  .math-app-container.eye-protection {
    --bg-primary: #fbf7ee;
    --surface-card: #fffefb;
    --border-color: #ede3ce;
    --text-main: #2d261e;
    --text-muted: #796b58;
  }

  /* 粒子 Canvas */
  .fx-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 999;
  }

  /* 顶部导航 */
  .math-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .top-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 0.4rem 0.75rem;
    border-radius: 0.5rem;
    background: rgba(0,0,0,0.03);
    transition: all 0.15s;
  }

  .top-nav-btn:hover {
    color: var(--brand-color);
    background: rgba(37,99,235,0.08);
  }

  .math-title {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }

  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tool-btn {
    border: 1px solid var(--border-color);
    background: var(--surface-card);
    color: var(--text-main);
    padding: 0.45rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }

  .tool-btn:hover {
    border-color: var(--brand-color);
    color: var(--brand-color);
  }

  .tool-btn.highlight {
    background: #eff6ff;
    border-color: #bfdbfe;
    color: #1d4ed8;
  }

  .tool-btn.active {
    background: var(--brand-color);
    color: #ffffff;
    border-color: var(--brand-color);
  }

  /* 面板路由切换 */
  .view-panel {
    display: none;
    animation: fadeIn 0.25s ease-out;
  }

  .view-panel.active {
    display: block;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* 1. 设置面板样式 */
  .setup-hero {
    text-align: center;
    margin-bottom: 2rem;
  }

  .hero-badge {
    display: inline-block;
    background: #ecfdf5;
    color: #065f46;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .setup-hero h2 {
    font-size: 2.1rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .hero-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .setup-card {
    max-width: 820px;
    margin: 0 auto;
    background: var(--surface-card);
    border: 1px solid var(--border-color);
    border-radius: 1.25rem;
    padding: 2rem;
    box-shadow: var(--shadow-soft);
  }

  .setting-group {
    margin-bottom: 1.75rem;
  }

  .setting-row {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .setting-group.half {
    flex: 1;
    min-width: 280px;
  }

  .group-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-main);
  }

  .tier-tip {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--text-muted);
  }

  /* 模式切换 Tabs */
  .mode-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .mode-tab {
    display: flex;
    flex-direction: column;
    text-align: left;
    background: var(--bg-primary);
    border: 2px solid transparent;
    padding: 1.15rem;
    border-radius: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .mode-tab:hover {
    background: #f1f5f9;
  }

  .mode-tab.active {
    background: #eff6ff;
    border-color: var(--brand-color);
  }

  .tab-title {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-main);
    margin-bottom: 0.35rem;
  }

  .tab-desc {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* 11 梯级网格 */
  .tier-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(115px, 1fr));
    gap: 0.6rem;
  }

  .tier-chip {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    padding: 0.65rem 0.5rem;
    border-radius: 0.65rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    text-align: center;
    transition: all 0.15s;
  }

  .tier-chip:hover {
    border-color: var(--brand-color);
    background: #f8fafc;
  }

  .tier-chip.active {
    background: var(--brand-color);
    color: #ffffff;
    border-color: var(--brand-color);
    box-shadow: 0 4px 12px rgba(37,99,235,0.25);
  }

  .tier-chip.special {
    grid-column: span 2;
    background: #fffbeb;
    border-color: #fde68a;
    color: #b45309;
  }

  .tier-chip.special.active {
    background: #d97706;
    color: #ffffff;
    border-color: #d97706;
  }

  /* Pill 按钮 */
  .option-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pill-btn {
    flex: 1;
    min-width: 70px;
    padding: 0.65rem 0.5rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 0.65rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
  }

  .pill-btn:hover {
    border-color: var(--brand-color);
  }

  .pill-btn.active {
    background: var(--brand-color);
    color: #ffffff;
    border-color: var(--brand-color);
  }

  /* 按钮与辅助 */
  .setup-actions {
    margin-top: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .btn-cta {
    width: 100%;
    max-width: 440px;
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: #ffffff;
    border: none;
    padding: 1.1rem 2rem;
    font-size: 1.25rem;
    font-weight: 800;
    border-radius: 0.95rem;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(37,99,235,0.3);
    transition: all 0.2s;
  }

  .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(37,99,235,0.38);
  }

  .secondary-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .sub-btn {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 0.6rem 1.1rem;
    border-radius: 0.65rem;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }

  .sub-btn:hover {
    border-color: var(--brand-color);
    color: var(--brand-color);
  }

  .sub-btn.warn {
    background: #fff1f2;
    border-color: #fecdd3;
    color: #e11d48;
  }

  .sub-btn.danger {
    background: #fef2f2;
    border-color: #fee2e2;
    color: #dc2626;
  }

  /* 2. 核心答题竞技面板样式 */
  .play-hud {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--surface-card);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 0.85rem 1.25rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-soft);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hud-item {
    display: flex;
    flex-direction: column;
  }

  .hud-label {
    font-size: 0.76rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  .hud-value {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-main);
  }

  .hud-progress {
    flex: 2;
    min-width: 180px;
  }

  .progress-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.86rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .progress-track {
    width: 100%;
    height: 8px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #10b981);
    transition: width 0.3s ease;
  }

  .time-val.urgent {
    color: var(--accent-rose);
    animation: pulse 1s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.05); }
  }

  .hud-combo {
    flex-direction: row;
    align-items: center;
    gap: 0.35rem;
    background: #fffbeb;
    padding: 0.4rem 0.85rem;
    border-radius: 0.75rem;
    border: 1px solid #fef3c7;
  }

  .combo-flame {
    font-size: 1.35rem;
    transition: transform 0.2s;
  }

  .combo-flame.fire-active {
    animation: flameShake 0.4s infinite alternate;
  }

  @keyframes flameShake {
    0% { transform: scale(1) rotate(-5deg); filter: drop-shadow(0 0 4px #f59e0b); }
    100% { transform: scale(1.3) rotate(5deg); filter: drop-shadow(0 0 10px #ef4444); }
  }

  .combo-num {
    font-size: 1.25rem;
    font-weight: 900;
    color: #b45309;
  }

  .combo-unit {
    font-size: 0.82rem;
    color: #92400e;
    font-weight: 600;
  }

  .hud-btn {
    border: 1px solid var(--border-color);
    background: var(--bg-primary);
    padding: 0.45rem 0.85rem;
    border-radius: 0.6rem;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  /* 核心算式舞台 */
  .card-stage {
    position: relative;
    max-width: 780px;
    margin: 0 auto;
    background: var(--surface-card);
    border: 2px solid var(--border-color);
    border-radius: 1.5rem;
    padding: 2.5rem 1.5rem 2rem 1.5rem;
    box-shadow: var(--shadow-elevated);
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    overflow: hidden;
  }

  /* 升级弹窗横幅 */
  .levelup-banner {
    position: absolute;
    top: 15%;
    left: 5%;
    right: 5%;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #78350f;
    padding: 1.5rem;
    border-radius: 1.25rem;
    text-align: center;
    box-shadow: 0 20px 40px rgba(245, 158, 11, 0.4);
    z-index: 50;
    border: 3px solid #fef3c7;
    animation: popBanner 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes popBanner {
    0% { transform: scale(0.6) translateY(40px); opacity: 0; }
    100% { transform: scale(1) translateY(0); opacity: 1; }
  }

  .banner-sparkle {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .banner-title {
    font-size: 1.85rem;
    font-weight: 900;
    margin-bottom: 0.25rem;
  }

  .banner-sub {
    font-size: 1.1rem;
    font-weight: 600;
  }

  /* 动态飘字层 */
  .float-text-layer {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 40;
  }

  .float-popup {
    font-size: 1.8rem;
    font-weight: 900;
    text-shadow: 0 2px 10px rgba(0,0,0,0.15);
    animation: floatUp 1.2s forwards;
    white-space: nowrap;
  }

  .float-popup.good {
    color: #10b981;
  }

  .float-popup.bad {
    color: #f43f5e;
  }

  @keyframes floatUp {
    0% { transform: translateY(0) scale(0.8); opacity: 0; }
    20% { transform: translateY(-15px) scale(1.15); opacity: 1; }
    80% { transform: translateY(-45px) scale(1.05); opacity: 0.9; }
    100% { transform: translateY(-70px) scale(0.9); opacity: 0; }
  }

  /* 算式卡片 */
  .equation-box {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 2rem;
    min-height: 110px;
  }

  .eq-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .eq-expr, .eq-comp-part {
    font-size: 3.5rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
    color: var(--text-main);
  }

  .eq-op {
    font-size: 3.5rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .eq-input-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 130px;
    height: 84px;
    padding: 0 1rem;
    background: var(--bg-primary);
    border: 3px dashed #94a3b8;
    border-radius: 1rem;
    font-size: 3.5rem;
    font-weight: 900;
    color: var(--brand-color);
    transition: all 0.2s;
  }

  .eq-input-slot.has-val {
    border-style: solid;
    border-color: var(--brand-color);
    background: #eff6ff;
  }

  .eq-input-slot.slot-wrong {
    border-color: var(--accent-rose);
    background: #fff1f2;
    color: var(--accent-rose);
  }

  .slot-cursor {
    display: inline-block;
    width: 3px;
    height: 48px;
    background: var(--brand-color);
    margin-left: 4px;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .eq-comp-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 86px;
    height: 86px;
    border-radius: 50%;
    background: #f1f5f9;
    border: 3px dashed #94a3b8;
    font-size: 3rem;
    font-weight: 900;
    color: #475569;
    transition: all 0.2s;
  }

  .eq-comp-circle.circle-wrong {
    background: #fff1f2;
    border-color: #f43f5e;
    color: #f43f5e;
  }

  /* 3. 智能互斥键盘 */
  /* A. 比大小专用大按键 */
  .keypad-compare {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    width: 100%;
    max-width: 540px;
    margin-bottom: 0.5rem;
  }

  .btn-comp {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 0.5rem;
    border-radius: 1.25rem;
    border: 2px solid transparent;
    cursor: pointer;
    box-shadow: 0 8px 16px rgba(0,0,0,0.06);
    transition: all 0.15s;
  }

  .btn-comp:active {
    transform: scale(0.96);
  }

  .btn-comp .sym {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .btn-comp .sym-name {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .btn-comp .key-hint {
    font-size: 0.72rem;
    opacity: 0.75;
    margin-top: 0.25rem;
  }

  .btn-greater {
    background: #fff1f2;
    border-color: #fecdd3;
    color: #e11d48;
  }

  .btn-greater:hover {
    background: #ffe4e6;
    border-color: #fda4af;
  }

  .btn-equal {
    background: #fffbeb;
    border-color: #fef3c7;
    color: #d97706;
  }

  .btn-equal:hover {
    background: #fef3c7;
    border-color: #fde68a;
  }

  .btn-less {
    background: #ecfdf5;
    border-color: #a7f3d0;
    color: #059669;
  }

  .btn-less:hover {
    background: #d1fae5;
    border-color: #6ee7b7;
  }

  /* B. 常规计算 0-9 触控键盘 */
  .keypad-calc {
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .num-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
  }

  .num-btn {
    height: 64px;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 0.85rem;
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--text-main);
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0,0,0,0.03);
    transition: all 0.12s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .num-btn:active {
    transform: scale(0.94);
    background: #e2e8f0;
  }

  .num-btn.action-clear {
    color: #e11d48;
    background: #fff1f2;
    border-color: #ffe4e6;
  }

  .num-btn.action-back {
    color: #0284c7;
    background: #f0f9ff;
    border-color: #e0f2fe;
    font-size: 1.6rem;
  }

  .btn-submit {
    height: 56px;
    background: linear-gradient(135deg, #10b981, #059669);
    color: #ffffff;
    border: none;
    border-radius: 0.85rem;
    font-size: 1.25rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(16, 185, 129, 0.3);
    transition: all 0.15s;
  }

  .btn-submit:active {
    transform: scale(0.97);
  }

  .play-tips {
    text-align: center;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* 4. 结算面板样式 */
  .result-card {
    max-width: 680px;
    margin: 1.5rem auto;
    background: var(--surface-card);
    border: 1px solid var(--border-color);
    border-radius: 1.5rem;
    padding: 2.5rem 2rem;
    text-align: center;
    box-shadow: var(--shadow-elevated);
  }

  .result-trophy {
    font-size: 4.5rem;
    margin-bottom: 0.5rem;
    animation: bounce 1s infinite alternate;
  }

  @keyframes bounce {
    from { transform: translateY(0); }
    to { transform: translateY(-10px); }
  }

  .result-title {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }

  .honor-badge {
    display: inline-block;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 800;
    padding: 0.4rem 1.4rem;
    border-radius: 9999px;
    margin-bottom: 1.75rem;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.35);
  }

  .result-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .metric-box {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 1.1rem 0.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .metric-box.highlight {
    background: #ecfdf5;
    border-color: #a7f3d0;
  }

