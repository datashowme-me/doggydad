---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="口算大冲关 · 100以内速算小能手 | WordsMaster 游戏模块"
  description="专为小学低年级学生（1–3年级）设计的 100 以内口算速算练习神器：11级数段递增进阶、加减混合、九九乘除、比大小智能按键切换、草稿纸、连对粒子与错题闭环。"
  keywords={['口算练习', '口算小游戏', '小学数学', '100以内加减法', '速算训练', '凑十法破十法', '九九乘除法', '幼小衔接']}
  breadcrumbs={[
    { name: '首页', url: `${base}/` },
    { name: '游戏模块', url: `${base}/games/` },
    { name: '口算大冲关', url: `${base}/games/math/` }
  ]}
>
  <div class="math-app-container" id="math-app">
    <!-- 顶部极简导航栏 -->
    <header class="math-top-bar">
      <div class="top-bar-left">
        <a href={`${base}/games/`} class="top-nav-btn" title="返回游戏大厅">
          <span class="icon">‹</span> 游戏大厅
        </a>
        <h1 class="math-title">🧮 口算大冲关</h1>
      </div>
      <div class="top-bar-right">
        <button id="btn-theme-mode" class="tool-btn" title="切换护眼模式">🌿 护眼</button>
        <button id="btn-sound-toggle" class="tool-btn" title="开关音效">🔊 音效</button>
        <button id="btn-scratchpad-toggle" class="tool-btn highlight" title="打开/关闭草稿纸">📝 草稿纸</button>
        <button id="btn-fullscreen-toggle" class="tool-btn" title="全屏练习">⛶ 全屏</button>
      </div>
    </header>

    <!-- 粒子特效 Canvas（全局覆盖） -->
    <canvas id="fx-canvas" class="fx-canvas"></canvas>

    <!-- 主视口内容区 -->
    <main class="math-main">
      <!-- 1. 开始与配置面板 -->
      <section id="view-setup" class="view-panel active">
        <div class="setup-hero">
          <div class="hero-badge">小学生（1–3年级）专属速算冲关神器</div>
          <h2>每天 5 分钟，成为心算小天才</h2>
          <p class="hero-desc">10 到 100 以内数段梯级自选、平滑闯关、比大小与混合运算，练就扎实运算基本功！</p>
        </div>

        <div class="setup-card">
          <!-- 模式选择 -->
          <div class="setting-group">
            <label class="group-label">🎮 训练模式</label>
            <div class="mode-tabs">
              <button type="button" class="mode-tab active" data-mode="progressive">
                <span class="tab-title">🚀 逐级递增闯关（主打推荐）</span>
                <span class="tab-desc">从 10 以内起步，每连对 3 题自动向下一个数段升级，直冲 100 与乘除</span>
              </button>
              <button type="button" class="mode-tab" data-mode="custom">
                <span class="tab-title">🎯 自选梯级专项</span>
                <span class="tab-desc">自选特定数段或表内乘除进行高强度专项训练</span>
              </button>
            </div>
          </div>

          <!-- 数段阶梯选择（自选模式生效） -->
          <div class="setting-group" id="tier-picker-group">
            <label class="group-label">
              <span>📈 目标数段（共 11 个独立梯度）</span>
              <span class="tier-tip" id="tier-tip-text">当前：逐级闯关模式将从 10 以内开始动态递增</span>
            </label>
            <div class="tier-grid" id="tier-grid">
              <button type="button" class="tier-chip active" data-tier="0">10 以内</button>
              <button type="button" class="tier-chip" data-tier="1">20 以内</button>
              <button type="button" class="tier-chip" data-tier="2">30 以内</button>
              <button type="button" class="tier-chip" data-tier="3">40 以内</button>
              <button type="button" class="tier-chip" data-tier="4">50 以内</button>
              <button type="button" class="tier-chip" data-tier="5">60 以内</button>
              <button type="button" class="tier-chip" data-tier="6">70 以内</button>
              <button type="button" class="tier-chip" data-tier="7">80 以内</button>
              <button type="button" class="tier-chip" data-tier="8">90 以内</button>
              <button type="button" class="tier-chip" data-tier="9">100 以内</button>
              <button type="button" class="tier-chip special" data-tier="10">表内乘除综合</button>
            </div>
          </div>

          <!-- 题量与时间配置 -->
          <div class="setting-row">
            <div class="setting-group half">
              <label class="group-label">🎯 目标题量</label>
              <div class="option-pills" id="count-picker">
                <button type="button" class="pill-btn" data-count="30">30 题</button>
                <button type="button" class="pill-btn active" data-count="50">50 题（推荐）</button>
                <button type="button" class="pill-btn" data-count="100">100 题</button>
                <button type="button" class="pill-btn" data-count="0">极速刷题</button>
              </div>
            </div>

            <div class="setting-group half">
              <label class="group-label">⏱️ 限时挑战</label>
              <div class="option-pills" id="time-picker">
                <button type="button" class="pill-btn active" data-time="300">5 分钟（300s）</button>
                <button type="button" class="pill-btn" data-time="180">3 分钟</button>
                <button type="button" class="pill-btn" data-time="600">10 分钟</button>
                <button type="button" class="pill-btn" data-time="0">不限时</button>
              </div>
            </div>
          </div>

          <!-- 启动与辅助入口 -->
          <div class="setup-actions">
            <button type="button" id="btn-start-game" class="btn-cta">
              ⚡ 立即开始口算冲关
            </button>
            <div class="secondary-actions">
              <button type="button" id="btn-open-mistakes" class="sub-btn">
                📕 错题本 (<span id="mistake-count-badge">0</span>)
              </button>
              <button type="button" id="btn-open-history" class="sub-btn">
                🏆 历史战绩
              </button>
              <button type="button" id="btn-download-standalone" class="sub-btn" title="下载无网络单文件版，随时双击离线练习">
                💾 导出单文件离线版
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. 核心答题竞技面板 -->
      <section id="view-play" class="view-panel">
        <!-- 实时 HUD 状态栏 -->
        <div class="play-hud">
          <div class="hud-item hud-tier">
            <span class="hud-label">当前梯度</span>
            <span class="hud-value" id="hud-current-tier">10 以内</span>
          </div>
          <div class="hud-item hud-progress">
            <div class="progress-info">
              <span>进度: <strong id="hud-question-index">1</strong> / <span id="hud-question-total">50</span></span>
              <span>正确率: <strong id="hud-accuracy">100%</strong></span>
            </div>
            <div class="progress-track">
              <div class="progress-bar" id="hud-progress-fill" style="width: 2%"></div>
            </div>
          </div>
          <div class="hud-item hud-time" id="hud-time-container">
            <span class="hud-label">剩余时间</span>
            <span class="hud-value time-val" id="hud-timer-text">05:00</span>
          </div>
          <div class="hud-item hud-combo" id="hud-combo-container">
            <span class="combo-flame" id="combo-flame">🔥</span>
            <span class="combo-num" id="hud-combo-val">0</span>
            <span class="combo-unit">连对</span>
          </div>
          <div class="hud-item hud-controls">
            <button type="button" id="btn-pause-game" class="hud-btn" title="暂停游戏 (P)">⏸️ 暂停</button>
          </div>
        </div>

        <!-- 算式卡片核心舞台 -->
        <div class="card-stage" id="card-stage">
          <!-- 升级全屏金色弹窗横幅（升级时弹出） -->
          <div class="levelup-banner" id="levelup-banner" hidden>
            <div class="banner-sparkle">⭐ 🎉 ⚡</div>
            <div class="banner-title" id="levelup-title">晋级成功！</div>
            <div class="banner-sub" id="levelup-sub">进入 20 以内数段挑战，继续加油！</div>
          </div>

          <!-- 动态飘字容器 -->
          <div id="float-text-layer" class="float-text-layer"></div>

          <!-- 算式展示区 -->
          <div class="equation-box" id="equation-box">
            <!-- 常规计算题结构 -->
            <div class="eq-row" id="eq-calc-row">
              <span class="eq-expr" id="eq-calc-expr">12 + 15</span>
              <span class="eq-op">=</span>
              <span class="eq-input-slot" id="eq-input-slot">
                <span class="slot-val" id="eq-slot-val"></span>
                <span class="slot-cursor"></span>
              </span>
            </div>

            <!-- 比大小题结构 -->
            <div class="eq-row" id="eq-comp-row" hidden>
              <span class="eq-comp-part" id="eq-comp-left">38 + 24</span>
              <span class="eq-comp-circle" id="eq-comp-circle">○</span>
              <span class="eq-comp-part" id="eq-comp-right">60</span>
            </div>
          </div>

          <!-- 智能互斥交互键盘 -->
          <!-- A. 比大小专用超大按键（当题目为大小比较时激活） -->
          <div class="keypad-compare" id="keypad-compare" hidden>
            <button type="button" class="btn-comp btn-greater" data-symbol=">">
              <span class="sym">&gt;</span>
              <span class="sym-name">大于</span>
              <span class="key-hint">键盘 &gt; 或 .</span>
            </button>
            <button type="button" class="btn-comp btn-equal" data-symbol="=">
              <span class="sym">=</span>
              <span class="sym-name">等于</span>
              <span class="key-hint">键盘 = 或回车</span>
            </button>
            <button type="button" class="btn-comp btn-less" data-symbol="<">
              <span class="sym">&lt;</span>
              <span class="sym-name">小于</span>
              <span class="key-hint">键盘 &lt; 或 ,</span>
            </button>
          </div>

          <!-- B. 常规计算专用超大触控数字键盘（常规计算时激活） -->
          <div class="keypad-calc" id="keypad-calc">
            <div class="num-grid">
              <button type="button" class="num-btn" data-key="1">1</button>
              <button type="button" class="num-btn" data-key="2">2</button>
              <button type="button" class="num-btn" data-key="3">3</button>
              <button type="button" class="num-btn" data-key="4">4</button>
              <button type="button" class="num-btn" data-key="5">5</button>
              <button type="button" class="num-btn" data-key="6">6</button>
              <button type="button" class="num-btn" data-key="7">7</button>
              <button type="button" class="num-btn" data-key="8">8</button>
              <button type="button" class="num-btn" data-key="9">9</button>
              <button type="button" class="num-btn action-clear" data-key="clear" title="清空">C</button>
              <button type="button" class="num-btn" data-key="0">0</button>
              <button type="button" class="num-btn action-back" data-key="back" title="退格">⌫</button>
            </div>
            <button type="button" class="btn-submit" id="btn-submit-calc">
              ✓ 确认提交 (Enter)
            </button>
          </div>
        </div>

        <div class="play-tips">
          <span>💡 提示：支持实体键盘按键（数字 0–9、回车提交、退格修改、ESC 暂停）</span>
        </div>
      </section>

      <!-- 3. 大结算报告面板 -->
      <section id="view-result" class="view-panel">
        <div class="result-card">
          <div class="result-header">
            <div class="result-trophy" id="result-trophy">🏆</div>
            <h2 class="result-title">练习大通关！</h2>
            <div class="honor-badge" id="result-honor">速算小能手</div>
          </div>

          <div class="result-metrics">
            <div class="metric-box">
              <span class="metric-val" id="res-total">0</span>
              <span class="metric-lbl">总作答题数</span>
            </div>
            <div class="metric-box highlight">
              <span class="metric-val" id="res-accuracy">0%</span>
              <span class="metric-lbl">正确率</span>
            </div>
            <div class="metric-box">
              <span class="metric-val" id="res-speed">0.0s</span>
              <span class="metric-lbl">平均每题速度</span>
            </div>
            <div class="metric-box">
              <span class="metric-val" id="res-streak">0</span>
              <span class="metric-lbl">最高连对数</span>
            </div>
          </div>

          <div class="result-summary" id="result-summary-msg">
            表现优异！进位加减法熟练度达到高阶水平，坚持练习运算更快更准！
          </div>

          <!-- 本局错题快速预览 -->
          <div class="round-mistakes-box" id="round-mistakes-box" hidden>
            <div class="round-mistakes-head">
              <span>⚠️ 本轮存在 <strong id="round-mistake-count">0</strong> 道错题，已自动沉淀到错题本：</span>
            </div>
            <div class="round-mistakes-list" id="round-mistakes-list"></div>
          </div>

          <div class="result-actions">
            <button type="button" id="btn-play-again" class="btn-cta">
              🔁 再来一轮
            </button>
            <button type="button" id="btn-redo-mistakes" class="sub-btn warn" hidden>
              🎯 立即重做本轮错题
            </button>
            <button type="button" id="btn-result-home" class="sub-btn">
              🏠 返回主菜单
            </button>
          </div>
        </div>
      </section>
    </main>

    <!-- 暂停遮罩弹窗 -->
    <div class="modal-overlay" id="modal-pause" hidden>
      <div class="modal-box">
        <h3>⏸️ 练习已暂停</h3>
        <p>稍事休息，放松双眼，准备好随时继续！</p>
        <div class="modal-buttons">
          <button type="button" id="btn-resume-game" class="btn-cta">▶️ 继续练习</button>
          <button type="button" id="btn-restart-round" class="sub-btn">🔁 重新开始本轮</button>
          <button type="button" id="btn-quit-game" class="sub-btn danger">🚪 退出到设置</button>
        </div>
      </div>
    </div>

    <!-- 错题本全屏模态框 -->
    <div class="modal-overlay" id="modal-mistakes" hidden>
      <div class="modal-box wide">
        <div class="modal-head">
          <h3>📕 错题专练闭环</h3>
          <button type="button" class="modal-close" id="btn-close-mistakes">✕</button>
        </div>
        <p class="modal-desc">
          系统已记录所有答错的题目。掌握一道即移除一道，点击「一键重做」直到全部消灭！
        </p>
        <div class="mistakes-container" id="mistakes-container">
          <div class="empty-state" id="mistakes-empty">
            🎉 太棒了！当前没有任何错题，算力满分！
          </div>
          <div class="mistakes-list" id="mistakes-list"></div>
        </div>
        <div class="modal-foot">
          <button type="button" id="btn-drill-all-mistakes" class="btn-cta">
            🎯 一键重做全部错题 (<span id="drill-mistake-btn-count">0</span>)
          </button>
          <button type="button" id="btn-clear-mistakes" class="sub-btn danger">
            🗑️ 清空所有记录
          </button>
        </div>
      </div>
    </div>

    <!-- 历史成长脚印模态框 -->
    <div class="modal-overlay" id="modal-history" hidden>
      <div class="modal-box wide">
        <div class="modal-head">
          <h3>🏆 历史练习成绩与成长脚印</h3>
          <button type="button" class="modal-close" id="btn-close-history">✕</button>
        </div>
        <div class="lifetime-summary">
          <div class="lifetime-item">
            <span class="val" id="lt-total-count">0</span>
            <span class="lbl">累计练习题数</span>
          </div>
          <div class="lifetime-item">
            <span class="val" id="lt-avg-acc">0%</span>
            <span class="lbl">综合正确率</span>
          </div>
          <div class="lifetime-item">
            <span class="val" id="lt-best-streak">0</span>
            <span class="lbl">最高连击纪录</span>
          </div>
        </div>
        <div class="history-list" id="history-log-list">
          <p class="history-empty" id="history-empty">暂无练习历史，完成一轮练习后将在这里沉淀脚印！</p>
        </div>
      </div>
    </div>

    <!-- 内置草稿纸画板浮层 -->
    <div class="scratchpad-drawer" id="scratchpad-drawer" hidden>
      <div class="pad-header">
        <div class="pad-title">
          <span>📝 手写草稿纸（随数列竖式）</span>
        </div>
        <div class="pad-tools">
          <div class="color-picker">
            <button type="button" class="color-dot active" data-color="#1e293b" style="background:#1e293b" title="铅笔黑"></button>
            <button type="button" class="color-dot" data-color="#2563eb" style="background:#2563eb" title="蓝色"></button>
            <button type="button" class="color-dot" data-color="#dc2626" style="background:#dc2626" title="红色标注"></button>
          </div>
          <button type="button" class="pad-tool-btn" id="pad-tool-eraser" title="橡皮擦">🧹 橡皮</button>
          <button type="button" class="pad-tool-btn" id="pad-tool-clear" title="清空全部">🗑️ 清空</button>
          <button type="button" class="pad-tool-btn primary" id="pad-tool-hide" title="收起草稿纸">✖️ 收起</button>
        </div>
      </div>
      <div class="pad-canvas-wrapper">
        <canvas id="scratch-canvas" class="scratch-canvas"></canvas>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // 口算游戏原生闭环脚本
  (function () {
    // -------------------------------------------------------------
    // 0. 音效引擎 (Web Audio API 纯代码合成)
    // -------------------------------------------------------------
    let audioCtx = null;
    let isMuted = localStorage.getItem('kousuan_muted') === 'true';

    function initAudio() {
      if (!audioCtx) {
        const AudioContextClass = window.AudioContext || window.webkitAudioContext;
        if (AudioContextClass) {
          audioCtx = new AudioContextClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playTone(freq, duration, type = 'sine', gainVal = 0.2, delay = 0) {
      if (isMuted) return;
      initAudio();
      if (!audioCtx) return;

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      const startTime = audioCtx.currentTime + delay;

      osc.type = type;
      osc.frequency.setValueAtTime(freq, startTime);

      gain.gain.setValueAtTime(gainVal, startTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start(startTime);
      osc.stop(startTime + duration);
    }

    function soundCorrect() {
      // 欢快双音琴声 (C5 -> E5 -> G5)
      playTone(523.25, 0.15, 'triangle', 0.25, 0);
      playTone(659.25, 0.15, 'triangle', 0.25, 0.08);
      playTone(783.99, 0.25, 'triangle', 0.3, 0.16);
    }

    function soundWrong() {
      // 柔和低音双咚 (非惩罚性)
      playTone(220, 0.18, 'sine', 0.2, 0);
      playTone(180, 0.22, 'sine', 0.2, 0.12);
    }

    function soundLevelUp() {
      // 金色号角 (C4 -> E4 -> G4 -> C5 -> E5 琶音)
      const notes = [261.63, 329.63, 392.00, 523.25, 659.25];
      notes.forEach((f, idx) => {
        playTone(f, 0.2, 'sawtooth', 0.15, idx * 0.09);
      });
    }

    function soundVictory() {
      // 通关凯歌
      const notes = [392.00, 523.25, 659.25, 783.99, 1046.50];
      notes.forEach((f, idx) => {
        playTone(f, 0.35, 'triangle', 0.22, idx * 0.12);
      });
    }

    function soundClick() {
      playTone(600, 0.04, 'sine', 0.08, 0);
    }

    // -------------------------------------------------------------
    // 1. 题库与生成逻辑 (11级阶梯全覆盖，加减/连加/混合/乘除/比大小)
    // -------------------------------------------------------------
    const TIERS = [
      { id: 0, name: '10 以内', max: 10, title: '10 以内加减基础' },
      { id: 1, name: '20 以内', max: 20, title: '20 以内进退位（凑十破十）' },
      { id: 2, name: '30 以内', max: 30, title: '30 以内加减进阶' },
      { id: 3, name: '40 以内', max: 40, title: '40 以内混合运算' },
      { id: 4, name: '50 以内', max: 50, title: '50 以内速算挑战' },
      { id: 5, name: '60 以内', max: 60, title: '60 以内口算' },
      { id: 6, name: '70 以内', max: 70, title: '70 以内综合' },
      { id: 7, name: '80 以内', max: 80, title: '80 以内进退位' },
      { id: 8, name: '90 以内', max: 90, title: '90 以内大数计算' },
      { id: 9, name: '100 以内', max: 100, title: '100 以内满十进退位' },
      { id: 10, name: '表内乘除综合', max: 100, title: '九九乘法与表内整除' }
    ];

    function randInt(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    // 生成单题，支持多种题型并确保会话去重
    function generateQuestion(tierIndex, seenSet) {
      let q = null;
      let tries = 0;

      while (tries < 40) {
        tries++;
        const candidate = buildRawQuestion(tierIndex);
        const hash = candidate.hash;
        if (!seenSet.has(hash)) {
          seenSet.add(hash);
          q = candidate;
          break;
        }
      }
      return q || buildRawQuestion(tierIndex);
    }

    function buildRawQuestion(tierIndex) {
      // 针对第 11 关：表内乘除综合
      if (tierIndex === 10) {
        return buildMulDivQuestion();
      }

      const tier = TIERS[tierIndex] || TIERS[0];
      const maxVal = tier.max;

      // 决定题型：25% 几率出比大小题，75% 几率出常规计算题
      const isCompare = Math.random() < 0.28;

      if (isCompare) {
        return buildCompareQuestion(maxVal);
      } else {
        return buildCalcQuestion(maxVal, tierIndex);
      }
    }

    // 常规计算题
    function buildCalcQuestion(maxVal, tierIndex) {
      // 题型变体: 0=双数加, 1=双数减, 2=连加(a+b+c), 3=加减混合(a+b-c 或 a-b+c)
      const allowedForms = [0, 1];
      if (tierIndex >= 2) allowedForms.push(2); // 30以内以上允许连加
      if (tierIndex >= 3) allowedForms.push(3); // 40以内以上允许混合加减

      const form = allowedForms[randInt(0, allowedForms.length - 1)];

      if (form === 0) {
        // 加法 a + b <= maxVal
        const a = randInt(1, maxVal - 1);
        const b = randInt(1, maxVal - a);
        const ans = a + b;
        return {
          type: 'calc',
          expr: `${a} + ${b}`,
          answer: String(ans),
          hash: `c_${a}+${b}`
        };
      } else if (form === 1) {
        // 减法 a - b >= 0
        const a = randInt(2, maxVal);
        const b = randInt(1, a);
        const ans = a - b;
        return {
          type: 'calc',
          expr: `${a} - ${b}`,
          answer: String(ans),
          hash: `c_${a}-${b}`
        };
      } else if (form === 2) {
        // 连加 a + b + c <= maxVal
        const a = randInt(1, Math.floor(maxVal / 3));
        const b = randInt(1, Math.floor(maxVal / 3));
        const c = randInt(1, maxVal - a - b);
        const ans = a + b + c;
        return {
          type: 'calc',
          expr: `${a} + ${b} + ${c}`,
          answer: String(ans),
          hash: `c_${a}+${b}+${c}`
        };
      } else {
        // 加减混合 a + b - c
        const a = randInt(2, Math.floor(maxVal * 0.6));
        const b = randInt(2, Math.floor(maxVal * 0.4));
        const sum = a + b;
        const c = randInt(1, Math.min(sum - 1, Math.floor(maxVal * 0.5)));
        const ans = sum - c;
        return {
          type: 'calc',
          expr: `${a} + ${b} - ${c}`,
          answer: String(ans),
          hash: `c_${a}+${b}-${c}`
        };
      }
    }

    // 比大小题 (38 + 24 ○ 60, 或 7 × 8 ○ 54)
    function buildCompareQuestion(maxVal) {
      const isAdd = Math.random() < 0.6;
      let leftVal = 0;
      let leftExpr = '';

      if (isAdd) {
        const a = randInt(1, maxVal - 2);
        const b = randInt(1, maxVal - a);
        leftVal = a + b;
        leftExpr = `${a} + ${b}`;
      } else {
        const a = randInt(3, maxVal);
        const b = randInt(1, a - 1);
        leftVal = a - b;
        leftExpr = `${a} - ${b}`;
      }

      // 右侧数字偏移：有 34% 几率正好相等 (=), 33% 几率大于, 33% 几率小于
      const mode = randInt(0, 2);
      let rightVal = leftVal;
      let symbol = '=';

      if (mode === 0) {
        // 相等
        rightVal = leftVal;
        symbol = '=';
      } else if (mode === 1) {
        // left > right
        const diff = randInt(1, Math.min(10, Math.max(1, leftVal - 1)));
        rightVal = leftVal - diff;
        symbol = '>';
      } else {
        // left < right
        const diff = randInt(1, 10);
        rightVal = leftVal + diff;
        symbol = '<';
      }

      return {
        type: 'compare',
        leftText: leftExpr,
        rightText: String(rightVal),
        answer: symbol,
        hash: `cmp_${leftExpr}_${symbol}_${rightVal}`
      };
    }

    // 表内乘除综合题
    function buildMulDivQuestion() {
      const isCompare = Math.random() < 0.25;

      if (isCompare) {
        // 乘法比大小 e.g. 7 × 8 ○ 54
        const a = randInt(2, 9);
        const b = randInt(2, 9);
        const prod = a * b;
        const offset = [0, -randInt(1, 4), randInt(1, 4)][randInt(0, 2)];
        const target = Math.max(1, prod + offset);
        let sym = '=';
        if (prod > target) sym = '>';
        if (prod < target) sym = '<';

        return {
          type: 'compare',
          leftText: `${a} × ${b}`,
          rightText: String(target),
          answer: sym,
          hash: `cmp_${a}x${b}_${sym}_${target}`
        };
      }

      const isMul = Math.random() < 0.55;
      if (isMul) {
        const a = randInt(2, 9);
        const b = randInt(2, 9);
        return {
          type: 'calc',
          expr: `${a} × ${b}`,
          answer: String(a * b),
          hash: `m_${a}x${b}`
        };
      } else {
        // 整除: 商 * 除数 = 被除数
        const divisor = randInt(2, 9);
        const quotient = randInt(1, 9);
        const dividend = divisor * quotient;
        return {
          type: 'calc',
          expr: `${dividend} ÷ ${divisor}`,
          answer: String(quotient),
          hash: `d_${dividend}/${divisor}`
        };
      }
    }

