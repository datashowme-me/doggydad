---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://wordsmaster.app';
const canonicalUrl = `${siteUrl}/games/words/`;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>单词大冒险 · 趣味少儿英语拼词与听力速记 | WordsMaster</title>
  <meta name="description" content="专为少儿、学生与英语学习者打造的单词大冒险互动游戏：自然拼读、小学1-6年级重点词汇、字母气泡拼词、听音选词、连连看与1/2/3分钟限时冲刺，集成 PixelFX 像素复古特效与真人纯正发音。" />
  <meta name="keywords" content="英语单词游戏,少儿英语,小学英语单词,自然拼读,听音辨词,背单词游戏,英语口语听力,英语打字练习,PixelFX游戏" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- OpenGraph -->
  <meta property="og:title" content="单词大冒险 · 趣味少儿英语拼词与听力速记" />
  <meta property="og:description" content="包含字母气泡拼词、听音辨词、记忆连连看与限时狂飙四大游戏模式，内置 PixelFX 像素火花与真人纯正发音。" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': '单词大冒险 · 趣味少儿英语拼词与听力速记',
    'url': canonicalUrl,
    'applicationCategory': 'EducationalApplication',
    'operatingSystem': 'Any',
    'description': '专为少儿与学生设计的英语单词闯关与拼读训练 Web 应用。',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'CNY'
    }
  })} />

  <style>
    :root {
      --bg-page: #f0f7ff;
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --brand: #2563eb;
      --brand-hover: #1d4ed8;
      --accent: #f59e0b;
      --success: #10b981;
      --danger: #ef4444;
      --border: #e2e8f0;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
      --shadow-md: 0 8px 24px -4px rgba(37,99,235,0.08);
      --shadow-lg: 0 20px 25px -5px rgba(0,0,0,0.1);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 18px;
      --radius-full: 9999px;
    }

    body.eye-mode {
      --bg-page: #fbf7ee;
      --card-bg: #fffefb;
      --text-main: #2d261e;
      --text-muted: #796b58;
      --border: #ede3ce;
    }

    body.dark-mode {
      --bg-page: #0b1120;
      --card-bg: #151f32;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --brand: #3b82f6;
      --brand-hover: #60a5fa;
      --border: #1e293b;
      --shadow-md: 0 8px 24px -4px rgba(0,0,0,0.4);
    }

    [hidden] {
      display: none !important;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      width: 100%;
      min-height: 100%;
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', sans-serif;
      user-select: none;
      -webkit-user-select: none;
      transition: background-color 0.25s, color 0.25s;
    }

    /* 粒子特效 Canvas */
    .fx-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 999;
    }

    /* 顶部导航 */
    .app-header {
      width: 100%;
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-inner {
      max-width: 1040px;
      margin: 0 auto;
      padding: 0.65rem 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-muted);
      text-decoration: none;
      padding: 0.35rem 0.65rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: var(--card-bg);
      transition: all 0.15s;
    }
    .back-btn:hover {
      color: var(--brand);
      border-color: var(--brand);
    }

    .app-title-group {
      display: flex;
      flex-direction: column;
    }

    .app-title-group h1 {
      font-size: 1.15rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .app-badge {
      font-size: 0.7rem;
      font-weight: 700;
      background: linear-gradient(135deg, #f59e0b, #ef4444);
      color: #fff;
      padding: 0.1rem 0.45rem;
      border-radius: var(--radius-full);
      letter-spacing: 0.04em;
    }

    .header-tools {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .tool-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--card-bg);
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 0.35rem 0.65rem;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }
    .tool-btn:hover {
      background: rgba(37, 99, 235, 0.06);
      border-color: var(--brand);
    }
    .tool-btn.active {
      background: var(--brand);
      color: #fff;
      border-color: var(--brand);
    }

    /* 主布局容器 */
    .main-wrap {
      max-width: 1040px;
      margin: 0 auto;
      padding: 1.25rem 1rem 3.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    /* 模式与词库选择控制台 */
    .control-console {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1rem 1.25rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .console-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .row-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.35rem;
      white-space: nowrap;
    }

    /* 模式切换胶囊按钮 */
    .mode-pills {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }

    .mode-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--bg-page);
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-md);
      font-size: 0.86rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
    }
    .mode-pill:hover {
      border-color: var(--brand);
      transform: translateY(-1px);
    }
    .mode-pill.active {
      background: var(--brand);
      color: #fff;
      border-color: var(--brand);
      box-shadow: 0 4px 12px color-mix(in srgb, var(--brand) 30%, transparent);
    }

    /* 词库选择器 */
    .deck-strip {
      display: flex;
      gap: 0.4rem;
      overflow-x: auto;
      padding-bottom: 0.2rem;
      scrollbar-width: thin;
    }
    .deck-strip::-webkit-scrollbar {
      height: 4px;
    }
    .deck-strip::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }

    .deck-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--bg-page);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-full);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s;
    }
    .deck-chip:hover {
      color: var(--text-main);
      border-color: var(--brand);
    }
    .deck-chip.active {
      background: color-mix(in srgb, var(--brand) 12%, transparent);
      color: var(--brand);
      border-color: var(--brand);
      font-weight: 700;
    }

    /* 计时器与快捷选项 */
    .time-options {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .time-chip {
      background: var(--bg-page);
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.25rem 0.6rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.15s;
    }
    .time-chip:hover {
      color: var(--text-main);
      border-color: var(--brand);
    }
    .time-chip.active {
      background: var(--accent);
      color: #78350f;
      border-color: var(--accent);
    }

    /* 游戏主舞台容器 */
    .game-arena {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.75rem 1.5rem;
      box-shadow: var(--shadow-md);
      position: relative;
      overflow: hidden;
      min-height: 420px;
      display: flex;
      flex-direction: column;
    }

    /* 顶部仪表盘：连击、得分、用时、准确率 */
    .hud-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid var(--border);
    }

    .hud-stat-group {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .hud-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .hud-label {
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .hud-val {
      font-size: 1.15rem;
      font-weight: 900;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      color: var(--text-main);
    }
    .hud-val.combo-val {
      color: #ea580c;
    }

    .hud-progress-wrap {
      flex: 1;
      max-width: 240px;
      min-width: 140px;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .hud-progress-info {
      display: flex;
      justify-content: space-between;
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--text-muted);
    }
    .progress-track {
      height: 8px;
      background: var(--bg-page);
      border-radius: 999px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--brand), #38bdf8);
      width: 0%;
      transition: width 0.3s ease;
    }

    /* ---------------- MODE 1: 字母气泡拼词 (Spelling) ---------------- */
    .spelling-board {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      gap: 1.5rem;
      padding: 0.5rem 0;
    }

    .word-prompt-card {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.45rem;
      max-width: 580px;
    }

    .word-image-emoji {
      font-size: 4rem;
      line-height: 1;
      filter: drop-shadow(0 6px 12px rgba(0,0,0,0.12));
      animation: emojiBob 3s ease-in-out infinite alternate;
    }
    @keyframes emojiBob {
      0% { transform: translateY(0) scale(1); }
      100% { transform: translateY(-8px) scale(1.06); }
    }

    .word-translation {
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .phonetic-audio-box {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--bg-page);
      padding: 0.3rem 0.75rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--border);
    }
    .phonetic-txt {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--brand);
      font-family: 'Times New Roman', serif;
    }
    .btn-audio-speak {
      background: none;
      border: none;
      color: var(--brand);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.2rem;
      border-radius: 50%;
      transition: transform 0.15s;
    }
    .btn-audio-speak:hover {
      transform: scale(1.2);
    }

    .word-sentence {
      font-size: 0.92rem;
      color: var(--text-muted);
      font-style: italic;
      margin-top: 0.25rem;
      line-height: 1.4;
    }

    /* 字母展示槽 (Letter Slots) */
    .letter-slots-row {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
      justify-content: center;
      margin: 0.75rem 0;
    }

    .letter-slot {
      width: 52px;
      height: 60px;
      border-radius: var(--radius-md);
      border: 2px dashed color-mix(in srgb, var(--brand) 40%, var(--border));
      background: var(--bg-page);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      font-weight: 900;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--brand);
      text-transform: uppercase;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.03);
      transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .letter-slot.filled {
      border: 2px solid var(--brand);
      background: color-mix(in srgb, var(--brand) 10%, var(--card-bg));
      transform: translateY(-2px);
    }
    .letter-slot.active-cursor {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 30%, transparent);
      animation: slotPulse 1.2s infinite;
    }
    .letter-slot.error-slot {
      border-color: var(--danger);
      background: color-mix(in srgb, var(--danger) 12%, var(--card-bg));
      color: var(--danger);
    }
    @keyframes slotPulse {
      0%, 100% { border-color: var(--accent); }
      50% { border-color: #f97316; }
    }

    /* 打乱的气泡字母池 (Scrambled Letter Bubbles) */
    .letter-bubble-pool {
      display: flex;
      gap: 0.65rem;
      flex-wrap: wrap;
      justify-content: center;
      max-width: 620px;
    }

    .letter-bubble-btn {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: linear-gradient(145deg, var(--card-bg), var(--bg-page));
      border: 2px solid var(--border);
      color: var(--text-main);
      font-size: 1.6rem;
      font-weight: 900;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      text-transform: uppercase;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 10px rgba(0,0,0,0.07);
      transition: transform 0.15s, background 0.15s, opacity 0.15s;
    }
    .letter-bubble-btn:hover:not(:disabled) {
      transform: translateY(-4px) scale(1.08);
      border-color: var(--brand);
      color: var(--brand);
      box-shadow: 0 8px 16px color-mix(in srgb, var(--brand) 25%, transparent);
    }
    .letter-bubble-btn:active:not(:disabled) {
      transform: translateY(1px) scale(0.96);
    }
    .letter-bubble-btn:disabled {
      opacity: 0.25;
      cursor: not-allowed;
      border-color: transparent;
      box-shadow: none;
    }

    /* 操作快捷行：撤销、提示、跳过 */
    .spelling-actions {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      margin-top: 0.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .spelling-tool-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--bg-page);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 0.45rem 0.9rem;
      border-radius: var(--radius-md);
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s;
    }
    .spelling-tool-btn:hover {
      background: var(--card-bg);
      color: var(--text-main);
      border-color: var(--brand);
    }

    /* ---------------- MODE 2: 听音辨词 (Listening) ---------------- */
    .listening-board {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      gap: 2rem;
      padding: 1rem 0;
    }

    .audio-speaker-center {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .big-sound-disc {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #38bdf8, #2563eb);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      border: 4px solid #fff;
      box-shadow: 0 10px 25px rgba(37,99,235,0.35);
      cursor: pointer;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
      animation: soundPulse 2.5s infinite;
    }
    .big-sound-disc:hover {
      transform: scale(1.1);
    }
    .big-sound-disc:active {
      transform: scale(0.95);
    }
    @keyframes soundPulse {
      0%, 100% { box-shadow: 0 10px 25px rgba(37,99,235,0.35); }
      50% { box-shadow: 0 12px 36px rgba(37,99,235,0.6); }
    }

    .audio-hint-txt {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text-muted);
    }

    .listening-options-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(220px, 1fr));
      gap: 1rem;
      width: 100%;
      max-width: 640px;
    }

    @media (max-width: 580px) {
      .listening-options-grid {
        grid-template-columns: 1fr;
      }
    }

    .listen-opt-card {
      background: var(--bg-page);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.1rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      cursor: pointer;
      transition: all 0.18s;
      text-align: left;
    }
    .listen-opt-card:hover {
      transform: translateY(-2px);
      border-color: var(--brand);
      background: color-mix(in srgb, var(--brand) 6%, var(--card-bg));
      box-shadow: var(--shadow-sm);
    }
    .listen-opt-card.correct {
      background: color-mix(in srgb, var(--success) 15%, var(--card-bg));
      border-color: var(--success);
      color: #065f46;
    }
    .listen-opt-card.wrong {
      background: color-mix(in srgb, var(--danger) 15%, var(--card-bg));
      border-color: var(--danger);
      color: #991b1b;
      animation: shakeCard 0.3s;
    }

    .opt-word {
      font-size: 1.25rem;
      font-weight: 800;
    }
    .opt-meaning {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* ---------------- MODE 3: 连连看消消乐 (Match Pairs) ---------------- */
    .match-board {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
      gap: 1.25rem;
      width: 100%;
    }

    .match-tip-banner {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text-muted);
      background: var(--bg-page);
      padding: 0.4rem 1rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--border);
    }

    .match-cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.85rem;
      width: 100%;
      max-width: 680px;
    }

    @media (max-width: 640px) {
      .match-cards-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .match-card {
      aspect-ratio: 1.4 / 1;
      background: var(--card-bg);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0.5rem;
      cursor: pointer;
      text-align: center;
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text-main);
      box-shadow: var(--shadow-sm);
      transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .match-card:hover:not(.matched) {
      transform: translateY(-3px);
      border-color: var(--brand);
      box-shadow: 0 6px 14px color-mix(in srgb, var(--brand) 20%, transparent);
    }
    .match-card.selected {
      border-color: var(--accent);
      background: color-mix(in srgb, var(--accent) 15%, var(--card-bg));
      transform: scale(1.05);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 30%, transparent);
    }
    .match-card.matched {
      opacity: 0.25;
      cursor: default;
      border-color: var(--success);
      background: color-mix(in srgb, var(--success) 12%, var(--card-bg));
      transform: scale(0.95);
      pointer-events: none;
    }

    /* ---------------- 模态框 / 弹窗 (错词本、结算等) ---------------- */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      z-index: 1000;
      animation: modalFadeIn 0.2s ease-out;
    }
    @keyframes modalFadeIn {
      from { opacity: 0; transform: scale(0.98); }
      to { opacity: 1; transform: scale(1); }
    }

    .modal-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
      max-width: 580px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      box-shadow: var(--shadow-lg);
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.75rem;
    }
    .modal-header h2 {
      font-size: 1.3rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .btn-modal-close {
      background: none;
      border: none;
      font-size: 1.25rem;
      color: var(--text-muted);
      cursor: pointer;
    }
    .btn-modal-close:hover {
      color: var(--text-main);
    }

    .notebook-list {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .notebook-item {
      background: var(--bg-page);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .nb-word {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--brand);
    }
    .nb-mean {
      font-size: 0.85rem;
      color: var(--text-muted);
      flex: 1;
      margin-left: 0.5rem;
    }

    .victory-box {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .victory-trophy {
      font-size: 4rem;
      animation: trophySpin 1s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes trophySpin {
      0% { transform: scale(0.3) rotate(-30deg); }
      100% { transform: scale(1) rotate(0deg); }
    }

    .victory-title {
      font-size: 1.75rem;
      font-weight: 900;
      color: var(--text-main);
    }
    .victory-stars {
      font-size: 2rem;
      letter-spacing: 0.35rem;
    }

    .victory-stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      width: 100%;
      margin: 0.5rem 0;
    }
    .vic-stat {
      background: var(--bg-page);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 0.75rem 0.5rem;
      text-align: center;
    }
    .vic-stat-num {
      font-size: 1.35rem;
      font-weight: 900;
      color: var(--brand);
      font-family: ui-monospace, SFMono-Regular, monospace;
    }
    .vic-stat-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }

    .modal-actions {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      width: 100%;
    }

    .btn-modal-primary {
      background: var(--brand);
      color: #fff;
      border: none;
      font-weight: 800;
      font-size: 0.95rem;
      padding: 0.75rem 1.5rem;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-modal-primary:hover {
      background: var(--brand-hover);
      transform: translateY(-2px);
    }

    .btn-modal-secondary {
      background: var(--bg-page);
      border: 1px solid var(--border);
      color: var(--text-main);
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-modal-secondary:hover {
      background: var(--card-bg);
      border-color: var(--brand);
    }

    @keyframes shakeCard {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-8px); }
      40%, 80% { transform: translateX(8px); }
    }
  </style>
</head>

<body>
  <!-- PixelFX 2D Canvas Overlay -->
  <canvas id="pixelfx-canvas" class="fx-canvas"></canvas>

  <!-- 顶部导航条 -->
  <header class="app-header">
    <div class="header-inner">
      <div class="brand-wrap">
        <a href={`${base}/games/#words`} class="back-btn" title="返回游戏中心">
          <span>←</span> 游戏中心
        </a>
        <div class="app-title-group">
          <h1>
            <span>🔤 单词大冒险</span>
            <span class="app-badge">PixelFX 像素版</span>
          </h1>
        </div>
      </div>

      <div class="header-tools">
        <!-- 慢速发音跟读开关 (适合少儿) -->
        <button type="button" class="tool-btn" id="btn-slow-audio" title="开启慢速发音 (0.75x，方便少儿跟读模仿)">
          <span>🐢</span> <span id="txt-slow-audio">正常语速</span>
        </button>

        <!-- 音效开关 -->
        <button type="button" class="tool-btn" id="btn-toggle-sound" title="开关复古按键音与合成音效">
          <span>🔊</span> <span id="txt-sound-state">音效 开</span>
        </button>

        <!-- 试听与音效测试 -->
        <button type="button" class="tool-btn" id="btn-test-sound" title="测试发音与像素动效">
          <span>🔔</span> 音效测试
        </button>

        <!-- 错题生词本 -->
        <button type="button" class="tool-btn" id="btn-open-notebook" title="查看生词与复习本">
          <span>📖</span> 生词本 (<span id="txt-wrong-count">0</span>)
        </button>

        <!-- 护眼模式 -->
        <button type="button" class="tool-btn" id="btn-toggle-eye" title="切换柔和护眼羊皮纸背景">
          <span>👓</span> 护眼
        </button>
      </div>
    </div>
  </header>

  <!-- 主体工作区 -->
  <main class="main-wrap">
    <!-- 控制台：模式切换、词库分级、限时选项 -->
    <section class="control-console" aria-label="游戏玩法与词库设置">
      <!-- 游戏模式切换 -->
      <div class="console-row">
        <div class="row-title">🎮 玩法模式</div>
        <div class="mode-pills" role="tablist">
          <button type="button" class="mode-pill active" data-mode="spelling">
            <span>🔤</span> 字母气泡拼词
          </button>
          <button type="button" class="mode-pill" data-mode="listening">
            <span>🎧</span> 听音辨词侦探
          </button>
          <button type="button" class="mode-pill" data-mode="rush">
            <span>⚡</span> 限时冲关狂飙
          </button>
          <button type="button" class="mode-pill" data-mode="match">
            <span>🧩</span> 单词连连看
          </button>
        </div>

        <!-- 限时设置（1min, 2min, 3min, 自由无限制） -->
        <div class="time-options" id="time-options-wrap">
          <span class="row-title" style="font-size:0.75rem;">⏱️ 限时:</span>
          <button type="button" class="time-chip" data-time="60">1分钟</button>
          <button type="button" class="time-chip active" data-time="120">2分钟</button>
          <button type="button" class="time-chip" data-time="180">3分钟</button>
          <button type="button" class="time-chip" data-time="0">无限制</button>
        </div>
      </div>

      <!-- 词库分级（适合小学低年级各阶段） -->
      <div class="console-row">
        <div class="row-title">📚 关卡词库</div>
        <div class="deck-strip" role="radiogroup">
          <button type="button" class="deck-chip active" data-deck="animals">🐾 萌宠动物 (自然拼读)</button>
          <button type="button" class="deck-chip" data-deck="foods">🍎 美味果蔬 (小学必会)</button>
          <button type="button" class="deck-chip" data-deck="colors_nums">🎨 颜色数字 (低年级基础)</button>
          <button type="button" class="deck-chip" data-deck="body_home">👀 身体家庭 (日常高频)</button>
          <button type="button" class="deck-chip" data-deck="school">🎒 校园文具 (PEP精选)</button>
          <button type="button" class="deck-chip" data-deck="actions">🏃 趣味动作 (常用动词)</button>
          <button type="button" class="deck-chip" data-deck="nature">⛅ 天气四季 (进阶扩展)</button>
          <button type="button" class="deck-chip" data-deck="coder">💻 程序员极客 (Tech)</button>
        </div>
      </div>
    </section>

    <!-- 游戏舞台核心卡片 -->
    <section class="game-arena" id="game-stage">
      <!-- 顶部 HUD 统计栏 -->
      <div class="hud-bar">
        <div class="hud-stat-group">
          <div class="hud-item">
            <span class="hud-label">得分</span>
            <span class="hud-val" id="hud-score">0</span>
          </div>
          <div class="hud-item">
            <span class="hud-label">连击</span>
            <span class="hud-val combo-val" id="hud-combo">🔥 0</span>
          </div>
          <div class="hud-item">
            <span class="hud-label">用时</span>
            <span class="hud-val" id="hud-timer">00:00</span>
          </div>
          <div class="hud-item">
            <span class="hud-label">准确率</span>
            <span class="hud-val" id="hud-accuracy">100%</span>
          </div>
        </div>

        <div class="hud-progress-wrap">
          <div class="hud-progress-info">
            <span>本轮进度</span>
            <span id="hud-progress-txt">1 / 10</span>
          </div>
          <div class="progress-track">
            <div class="progress-fill" id="hud-progress-bar"></div>
          </div>
        </div>
      </div>

      <!-- ---------------- MODE 1 & 3: 字母拼词看板 ---------------- -->
      <div class="spelling-board" id="mode-spelling-view">
        <div class="word-prompt-card">
          <div class="word-image-emoji" id="spell-emoji">🐶</div>
          <div class="word-translation" id="spell-meaning">小狗</div>
          <div class="phonetic-audio-box">
            <span class="phonetic-txt" id="spell-phonetic">/dɔːɡ/</span>
            <button type="button" class="btn-audio-speak" id="btn-spell-speak" title="听真人发音 (按空格也可重播)">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
              </svg>
            </button>
          </div>
          <p class="word-sentence" id="spell-sentence">"I have a friendly pet dog."</p>
        </div>

        <!-- 目标字母插槽 -->
        <div class="letter-slots-row" id="spell-slots"></div>

        <!-- 触屏打乱字母气泡池 -->
        <div class="letter-bubble-pool" id="spell-bubbles"></div>

        <!-- 辅助操作 -->
        <div class="spelling-actions">
          <button type="button" class="spelling-tool-btn" id="btn-spell-backspace" title="退格撤销一个字母 (Backspace)">
            <span>⌫</span> 退格
          </button>
          <button type="button" class="spelling-tool-btn" id="btn-spell-hint" title="提示下一个字母">
            <span>💡</span> 提示字母
          </button>
          <button type="button" class="spelling-tool-btn" id="btn-spell-skip" title="跳过当前词 (Skip)">
            <span>⏭️</span> 跳过
          </button>
        </div>
      </div>

      <!-- ---------------- MODE 2: 听音辨词看板 ---------------- -->
      <div class="listening-board" id="mode-listening-view" hidden>
        <div class="audio-speaker-center">
          <button type="button" class="big-sound-disc" id="btn-big-speaker" title="点击再次播放发音">
            <span>🔊</span>
          </button>
          <span class="audio-hint-txt">仔细聆听发音，选择正确的单词或释义</span>
        </div>

        <div class="listening-options-grid" id="listening-options"></div>
      </div>

      <!-- ---------------- MODE 4: 单词连连看看板 ---------------- -->
      <div class="match-board" id="mode-match-view" hidden>
        <div class="match-tip-banner">
          🧩 点击一张英文卡片和一张中文卡片配对消消乐，消灭所有卡牌通关！
        </div>
        <div class="match-cards-grid" id="match-cards-container"></div>
      </div>
    </section>
  </main>

  <!-- 弹窗：生词本 (Notebook) -->
  <div class="modal-overlay" id="modal-notebook" hidden>
    <div class="modal-card">
      <div class="modal-header">
        <h2>📖 错题生词本</h2>
        <button type="button" class="btn-modal-close" id="btn-close-nb">✕</button>
      </div>
      <p style="font-size:0.86rem; color:var(--text-muted);">
        练习中拼错或答错的单词会自动收录在此，随时开启针对性专训！
      </p>
      <div class="notebook-list" id="notebook-items">
        <p style="text-align:center; padding:1.5rem; color:var(--text-muted); font-size:0.9rem;">
          生词本为空，继续保持全对哦！🎉
        </p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-modal-primary" id="btn-drill-notebook">
          🎯 专练生词本单词
        </button>
        <button type="button" class="btn-modal-secondary" id="btn-clear-notebook">
          清空记录
        </button>
      </div>
    </div>
  </div>

  <!-- 弹窗：通关与战报总结 (Victory Summary) -->
  <div class="modal-overlay" id="modal-victory" hidden>
    <div class="modal-card">
      <div class="victory-box">
        <div class="victory-trophy">🏆</div>
        <h2 class="victory-title" id="vic-heading">闯关大获全胜！</h2>
        <div class="victory-stars" id="vic-stars">⭐⭐⭐</div>
        <p style="color:var(--text-muted); font-size:0.95rem;" id="vic-feedback">太厉害了！词汇积累又迈进了一大步！</p>

        <div class="victory-stats-grid">
          <div class="vic-stat">
            <div class="vic-stat-num" id="vic-score">280</div>
            <div class="vic-stat-label">总得分</div>
          </div>
          <div class="vic-stat">
            <div class="vic-stat-num" id="vic-max-combo">🔥 10</div>
            <div class="vic-stat-label">最大连击</div>
          </div>
          <div class="vic-stat">
            <div class="vic-stat-num" id="vic-accuracy">100%</div>
            <div class="vic-stat-label">正确率</div>
          </div>
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-modal-primary" id="btn-vic-restart">
          🔄 再战一轮
        </button>
        <button type="button" class="btn-modal-secondary" id="btn-vic-next-tier">
          🪜 挑战下个词库
        </button>
      </div>
    </div>
  </div>

