    // ---------------- 游戏引擎流程逻辑 ----------------

    function shuffleArray<T>(arr: T[]): T[] {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function updateHud() {
      els.hudScore.textContent = String(state.score);
      els.hudCombo.textContent = `🔥 ${state.streak}`;
      const totalWords = state.wordList.length;
      const current = Math.min(state.currentIndex + 1, totalWords);
      els.hudProgressTxt.textContent = `${current} / ${totalWords}`;
      const pct = Math.round((current / totalWords) * 100);
      els.hudProgressBar.style.width = `${pct}%`;

      const acc = state.totalAttempts > 0 ? Math.round((state.correctCount / state.totalAttempts) * 100) : 100;
      els.hudAccuracy.textContent = `${acc}%`;
      els.txtWrongCount.textContent = String(state.wrongWords.length);
    }

    function formatTime(sec: number): string {
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function startTimer() {
      if (state.timerInterval) clearInterval(state.timerInterval);
      state.elapsedSeconds = 0;
      els.hudTimer.textContent = formatTime(state.elapsedSeconds);

      state.timerInterval = window.setInterval(() => {
        state.elapsedSeconds++;
        if (state.timeLimit > 0) {
          const remaining = Math.max(0, state.timeLimit - state.elapsedSeconds);
          els.hudTimer.textContent = formatTime(remaining);
          if (remaining <= 0) {
            handleTimeUp();
          }
        } else {
          els.hudTimer.textContent = formatTime(state.elapsedSeconds);
        }
      }, 1000);
    }

    function stopTimer() {
      if (state.timerInterval) {
        clearInterval(state.timerInterval);
        state.timerInterval = null;
      }
    }

    function handleTimeUp() {
      stopTimer();
      sound.playWrong();
      showVictoryModal(true);
    }

    // 记录错词
    function addWrongWord(item: WordItem) {
      if (!state.wrongWords.some(w => w.word.toLowerCase() === item.word.toLowerCase())) {
        state.wrongWords.unshift(item);
        if (state.wrongWords.length > 50) state.wrongWords.pop();
        localStorage.setItem('wordsmaster_wrong_words', JSON.stringify(state.wrongWords));
        updateHud();
      }
    }

    // ---------------- 渲染模式 1 & 3: 拼词 ----------------
    function renderSpellingWord() {
      const item = state.wordList[state.currentIndex];
      if (!item) {
        showVictoryModal();
        return;
      }

      state.typedLetters = [];
      els.spellEmoji.textContent = item.emoji;
      els.spellMeaning.textContent = item.meaning;
      els.spellPhonetic.textContent = item.phonetic;
      els.spellSentence.textContent = `"${item.sentence}"`;

      // 播放一次发音
      speakText(item.word);

      // 生成字母插槽
      els.spellSlots.innerHTML = '';
      const letters = item.word.split('');
      letters.forEach((_, idx) => {
        const slot = document.createElement('div');
        slot.className = 'letter-slot' + (idx === 0 ? ' active-cursor' : '');
        slot.dataset.index = String(idx);
        els.spellSlots.appendChild(slot);
      });

      // 打乱字母生成气泡池（包含目标字母 + 1-2个随机干扰字母）
      const charPool = item.word.toLowerCase().split('');
      const distractorCount = Math.min(2, 8 - charPool.length);
      const alphabet = 'abcdefghijklmnopqrstuvwxyz';
      for (let i = 0; i < distractorCount; i++) {
        charPool.push(alphabet[Math.floor(Math.random() * alphabet.length)]);
      }
      const shuffled = shuffleArray(charPool);

      state.scrambledLetters = shuffled.map((char, index) => ({
        id: index,
        char,
        used: false
      }));

      renderBubbles();
      updateHud();
    }

    function renderBubbles() {
      els.spellBubbles.innerHTML = '';
      state.scrambledLetters.forEach(item => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'letter-bubble-btn';
        btn.textContent = item.char;
        btn.disabled = item.used;
        btn.addEventListener('click', () => {
          handleInputChar(item.char, item.id);
        });
        els.spellBubbles.appendChild(btn);
      });
    }

    function handleInputChar(char: string, bubbleId?: number) {
      const currentWord = state.wordList[state.currentIndex];
      if (!currentWord) return;

      const targetChars = currentWord.word.toLowerCase().split('');
      const slotIndex = state.typedLetters.length;

      if (slotIndex >= targetChars.length) return;

      const expectedChar = targetChars[slotIndex];
      const isCorrect = char.toLowerCase() === expectedChar;

      state.totalAttempts++;

      if (isCorrect) {
        state.typedLetters.push(char.toLowerCase());
        sound.playPop();

        if (bubbleId !== undefined) {
          const b = state.scrambledLetters.find(x => x.id === bubbleId);
          if (b) b.used = true;
          renderBubbles();
        } else {
          // 键盘输入时，将对应可用气泡设为 used
          const b = state.scrambledLetters.find(x => x.char.toLowerCase() === char.toLowerCase() && !x.used);
          if (b) {
            b.used = true;
            renderBubbles();
          }
        }

        // 更新插槽
        const slot = els.spellSlots.children[slotIndex] as HTMLElement;
        if (slot) {
          slot.textContent = char;
          slot.classList.remove('active-cursor', 'error-slot');
          slot.classList.add('filled');
        }

        const nextSlot = els.spellSlots.children[slotIndex + 1] as HTMLElement;
        if (nextSlot) {
          nextSlot.classList.add('active-cursor');
        }

        // 单词全部拼写完成
        if (state.typedLetters.length === targetChars.length) {
          state.correctCount++;
          state.streak++;
          if (state.streak > state.maxStreak) state.maxStreak = state.streak;
          state.score += 10 + Math.min(20, state.streak * 2);

          sound.playSuccess(state.streak);
          speakText(currentWord.word);

          // 触发 PixelFX 特效
          const centerSlot = els.spellSlots.children[Math.floor(targetChars.length / 2)] as HTMLElement;
          if (window.pixelFx) {
            window.pixelFx.triggerCorrect(centerSlot, state.streak, true);
          }

          setTimeout(() => {
            state.currentIndex++;
            if (state.currentIndex >= state.wordList.length) {
              showVictoryModal();
            } else {
              renderSpellingWord();
            }
          }, 550);
        }
      } else {
        // 拼写错误反馈
        state.streak = 0;
        sound.playWrong();
        addWrongWord(currentWord);

        const slot = els.spellSlots.children[slotIndex] as HTMLElement;
        if (slot) {
          slot.textContent = char;
          slot.classList.add('error-slot');
          setTimeout(() => {
            slot.textContent = '';
            slot.classList.remove('error-slot');
          }, 350);
        }

        if (window.pixelFx) {
          window.pixelFx.triggerWrong(slot, els.gameStage);
        }
      }

      updateHud();
    }

    // 拼写退格
    function handleBackspace() {
      if (state.typedLetters.length === 0) return;
      const removedChar = state.typedLetters.pop()!;
      sound.playKeyTap();

      // 解除最后一个被使用的对应气泡
      for (let i = state.scrambledLetters.length - 1; i >= 0; i--) {
        const b = state.scrambledLetters[i];
        if (b.char.toLowerCase() === removedChar.toLowerCase() && b.used) {
          b.used = false;
          break;
        }
      }
      renderBubbles();

      const slotIdx = state.typedLetters.length;
      const currentSlot = els.spellSlots.children[slotIdx] as HTMLElement;
      if (currentSlot) {
        currentSlot.textContent = '';
        currentSlot.classList.remove('filled');
        currentSlot.classList.add('active-cursor');
      }
      const nextSlot = els.spellSlots.children[slotIdx + 1] as HTMLElement;
      if (nextSlot) {
        nextSlot.classList.remove('active-cursor');
      }
    }

    // 提示下一个字母
    function handleHint() {
      const currentWord = state.wordList[state.currentIndex];
      if (!currentWord) return;
      const targetChars = currentWord.word.toLowerCase().split('');
      const nextIdx = state.typedLetters.length;
      if (nextIdx < targetChars.length) {
        const nextChar = targetChars[nextIdx];
        handleInputChar(nextChar);
      }
    }

    // ---------------- 渲染模式 2: 听音选词 ----------------
    function renderListeningWord() {
      const item = state.wordList[state.currentIndex];
      if (!item) {
        showVictoryModal();
        return;
      }

      speakText(item.word);

      // 从当前词库挑选 3 个干扰项
      const otherWords = state.wordList.filter(w => w.word !== item.word);
      const distractors = shuffleArray(otherWords).slice(0, 3);
      const options = shuffleArray([item, ...distractors]);

      els.listeningOptions.innerHTML = '';
      options.forEach(opt => {
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'listen-opt-card';
        card.innerHTML = `
          <div>
            <div class="opt-word">${opt.word}</div>
            <div class="opt-meaning">${opt.meaning}</div>
          </div>
          <span style="font-size:1.4rem;">${opt.emoji}</span>
        `;

        card.addEventListener('click', () => {
          handleListenChoice(card, opt, item);
        });

        els.listeningOptions.appendChild(card);
      });

      updateHud();
    }

    function handleListenChoice(cardEl: HTMLElement, chosen: WordItem, correct: WordItem) {
      state.totalAttempts++;
      const isCorrect = chosen.word === correct.word;

      if (isCorrect) {
        cardEl.classList.add('correct');
        state.correctCount++;
        state.streak++;
        if (state.streak > state.maxStreak) state.maxStreak = state.streak;
        state.score += 15 + Math.min(20, state.streak * 2);

        sound.playSuccess(state.streak);
        speakText(correct.word);

        if (window.pixelFx) {
          window.pixelFx.triggerCorrect(cardEl, state.streak, true);
        }

        setTimeout(() => {
          state.currentIndex++;
          if (state.currentIndex >= state.wordList.length) {
            showVictoryModal();
          } else {
            renderListeningWord();
          }
        }, 550);
      } else {
        cardEl.classList.add('wrong');
        state.streak = 0;
        sound.playWrong();
        addWrongWord(correct);

        if (window.pixelFx) {
          window.pixelFx.triggerWrong(cardEl, els.gameStage);
        }
      }

      updateHud();
    }

    // ---------------- 渲染模式 4: 单词连连看 (Match Pairs) ----------------
    function renderMatchPairs() {
      // 选取 6 个单词，生成 12 张卡片 (6 英文, 6 中文)
      const subset = shuffleArray(state.wordList).slice(0, 6);
      const cards: GameState['matchCards'] = [];

      subset.forEach((w, idx) => {
        cards.push({
          id: idx * 2,
          wordId: idx,
          text: w.word,
          isEnglish: true,
          matched: false,
          selected: false
        });
        cards.push({
          id: idx * 2 + 1,
          wordId: idx,
          text: `${w.emoji} ${w.meaning}`,
          isEnglish: false,
          matched: false,
          selected: false
        });
      });

      state.matchCards = shuffleArray(cards);
      state.selectedMatchCards = [];

      renderMatchGrid();
      updateHud();
    }

    function renderMatchGrid() {
      els.matchCardsContainer.innerHTML = '';
      state.matchCards.forEach(card => {
        const btn = document.createElement('div');
        btn.className = 'match-card' + (card.selected ? ' selected' : '') + (card.matched ? ' matched' : '');
        btn.textContent = card.text;

        if (!card.matched) {
          btn.addEventListener('click', () => {
            handleMatchCardClick(card.id, btn);
          });
        }
        els.matchCardsContainer.appendChild(btn);
      });
    }

    function handleMatchCardClick(cardId: number, cardEl: HTMLElement) {
      const card = state.matchCards.find(c => c.id === cardId);
      if (!card || card.matched || card.selected) return;

      sound.playPop();
      card.selected = true;
      state.selectedMatchCards.push(cardId);
      renderMatchGrid();

      if (state.selectedMatchCards.length === 2) {
        state.totalAttempts++;
        const [id1, id2] = state.selectedMatchCards;
        const card1 = state.matchCards.find(c => c.id === id1)!;
        const card2 = state.matchCards.find(c => c.id === id2)!;

        // 如果刚好配对成功 (同一个 wordId 且一个中文一个英文)
        if (card1.wordId === card2.wordId && card1.isEnglish !== card2.isEnglish) {
          card1.matched = true;
          card2.matched = true;
          card1.selected = false;
          card2.selected = false;
          state.selectedMatchCards = [];

          state.correctCount++;
          state.streak++;
          if (state.streak > state.maxStreak) state.maxStreak = state.streak;
          state.score += 20 + state.streak * 2;

          sound.playSuccess(state.streak);
          if (card1.isEnglish) speakText(card1.text);
          else speakText(card2.text);

          if (window.pixelFx) {
            window.pixelFx.triggerCorrect(cardEl, state.streak, true);
          }

          renderMatchGrid();

          // 检查是否全部消除
          if (state.matchCards.every(c => c.matched)) {
            setTimeout(() => {
              showVictoryModal();
            }, 600);
          }
        } else {
          // 配对失败
          state.streak = 0;
          sound.playWrong();
          if (window.pixelFx) {
            window.pixelFx.triggerWrong(cardEl, els.gameStage);
          }

          setTimeout(() => {
            card1.selected = false;
            card2.selected = false;
            state.selectedMatchCards = [];
            renderMatchGrid();
          }, 500);
        }

        updateHud();
      }
    }

    // ---------------- 切换玩法与词库 ----------------
    function switchGameMode(mode: GameState['mode']) {
      state.mode = mode;
      state.currentIndex = 0;
      state.streak = 0;

      // 切换视图显示
      els.viewSpelling.hidden = mode === 'listening' || mode === 'match';
      els.viewListening.hidden = mode !== 'listening';
      els.viewMatch.hidden = mode !== 'match';

      // 限时冲刺选项仅在模式匹配时强化
      els.timeOptionsWrap.style.display = 'flex';

      startCurrentMode();
    }

    function switchDeck(deckKey: string) {
      if (!VOCAB_DECKS[deckKey]) return;
      state.currentDeck = deckKey;
      state.wordList = shuffleArray([...VOCAB_DECKS[deckKey].words]);
      state.currentIndex = 0;
      state.streak = 0;
      startCurrentMode();
    }

    function startCurrentMode() {
      state.currentIndex = 0;
      startTimer();
      if (state.mode === 'spelling' || state.mode === 'rush') {
        renderSpellingWord();
      } else if (state.mode === 'listening') {
        renderListeningWord();
      } else if (state.mode === 'match') {
        renderMatchPairs();
      }
    }

    // ---------------- 通关胜利弹窗 ----------------
    function showVictoryModal(isTimeUp = false) {
      stopTimer();
      els.modalVictory.hidden = false;

      if (window.pixelFx) {
        window.pixelFx.triggerConfetti();
      }

      if (isTimeUp) {
        els.vicHeading.textContent = '⏰ 限时冲刺完成！';
        els.vicFeedback.textContent = '手速与反应力太赞了！来看看你的战绩报告：';
      } else {
        els.vicHeading.textContent = '🎉 关卡大获全胜！';
        els.vicFeedback.textContent = '本轮单词全部拿下，词汇大冒险闯关成功！';
      }

      const acc = state.totalAttempts > 0 ? Math.round((state.correctCount / state.totalAttempts) * 100) : 100;
      let stars = '⭐⭐⭐';
      if (acc < 70) stars = '⭐';
      else if (acc < 90) stars = '⭐⭐';

      els.vicStars.textContent = stars;
      els.vicScore.textContent = String(state.score);
      els.vicMaxCombo.textContent = `🔥 ${state.maxStreak}`;
      els.vicAccuracy.textContent = `${acc}%`;
    }

    function closeVictoryModal() {
      els.modalVictory.hidden = true;
    }

    // ---------------- 生词本弹窗 ----------------
    function renderNotebook() {
      els.notebookItems.innerHTML = '';
      if (state.wrongWords.length === 0) {
        els.notebookItems.innerHTML = `
          <p style="text-align:center; padding:1.5rem; color:var(--text-muted); font-size:0.9rem;">
            生词本为空，继续保持全对哦！🎉
          </p>
        `;
        return;
      }

      state.wrongWords.forEach((item, idx) => {
        const div = document.createElement('div');
        div.className = 'notebook-item';
        div.innerHTML = `
          <span style="font-size:1.3rem;">${item.emoji}</span>
          <span class="nb-word">${item.word}</span>
          <span class="nb-mean">${item.phonetic} · ${item.meaning}</span>
          <button type="button" class="btn-audio-speak" data-word="${item.word}" title="朗读">🔊</button>
        `;
        div.querySelector('.btn-audio-speak')?.addEventListener('click', () => {
          speakText(item.word);
        });
        els.notebookItems.appendChild(div);
      });
    }

    // ---------------- 全局事件绑定 ----------------

    // 物理键盘敲击监听 (支持大写/小写字母、退格、空格、回车)
    window.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

      // 仅在拼词与冲刺模式下捕获键盘输入
      if (state.mode === 'spelling' || state.mode === 'rush') {
        if (/^[a-zA-Z]$/.test(e.key)) {
          e.preventDefault();
          handleInputChar(e.key.toLowerCase());
        } else if (e.key === 'Backspace') {
          e.preventDefault();
          handleBackspace();
        } else if (e.key === ' ' || e.key === 'Spacebar') {
          e.preventDefault();
          const currentWord = state.wordList[state.currentIndex];
          if (currentWord) speakText(currentWord.word);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          handleHint();
        }
      }
    });

    // 模式切换按钮
    document.querySelectorAll<HTMLButtonElement>('.mode-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.mode-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const mode = btn.dataset.mode as GameState['mode'];
        if (mode) switchGameMode(mode);
      });
    });

    // 词库切换按钮
    document.querySelectorAll<HTMLButtonElement>('.deck-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.deck-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const deck = btn.dataset.deck;
        if (deck) switchDeck(deck);
      });
    });

    // 限时选项切换 (1min, 2min, 3min, 0)
    document.querySelectorAll<HTMLButtonElement>('.time-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.time-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        state.timeLimit = parseInt(btn.dataset.time || '120', 10);
        startTimer();
      });
    });

    // 拼词操作按钮
    els.btnSpellSpeak.addEventListener('click', () => {
      const cur = state.wordList[state.currentIndex];
      if (cur) speakText(cur.word);
    });
    els.btnSpellBackspace.addEventListener('click', handleBackspace);
    els.btnSpellHint.addEventListener('click', handleHint);
    els.btnSpellSkip.addEventListener('click', () => {
      const cur = state.wordList[state.currentIndex];
      if (cur) addWrongWord(cur);
      state.streak = 0;
      state.currentIndex++;
      if (state.currentIndex >= state.wordList.length) {
        showVictoryModal();
      } else {
        renderSpellingWord();
      }
    });

    // 听音大按钮
    els.btnBigSpeaker.addEventListener('click', () => {
      const cur = state.wordList[state.currentIndex];
      if (cur) speakText(cur.word);
    });

    // 音效开关
    els.btnToggleSound.addEventListener('click', () => {
      sound.enabled = !sound.enabled;
      els.txtSoundState.textContent = sound.enabled ? '音效 开' : '音效 关';
      els.btnToggleSound.classList.toggle('active', sound.enabled);
    });

    // 慢速发音切换
    els.btnSlowAudio.addEventListener('click', () => {
      isSlowSpeech = !isSlowSpeech;
      els.txtSlowAudio.textContent = isSlowSpeech ? '慢速跟读 0.75x' : '正常语速';
      els.btnSlowAudio.classList.toggle('active', isSlowSpeech);
      const cur = state.wordList[state.currentIndex];
      if (cur) speakText(cur.word);
    });

    // 测试音效与动效
    els.btnTestSound.addEventListener('click', () => {
      sound.playSuccess(5);
      speakText('Awesome job!');
      if (window.pixelFx) {
        window.pixelFx.triggerCorrect(els.btnTestSound, 5, true);
        window.pixelFx.triggerLevelUp('PixelFX 引擎已就绪!');
      }
    });

    // 护眼羊皮纸背景切换
    els.btnToggleEye.addEventListener('click', () => {
      document.body.classList.toggle('eye-mode');
      const isEye = document.body.classList.contains('eye-mode');
      els.btnToggleEye.classList.toggle('active', isEye);
    });

    // 生词本弹窗控制
    els.btnOpenNotebook.addEventListener('click', () => {
      renderNotebook();
      els.modalNotebook.hidden = false;
    });
    els.btnCloseNb.addEventListener('click', () => {
      els.modalNotebook.hidden = true;
    });
    els.btnClearNotebook.addEventListener('click', () => {
      state.wrongWords = [];
      localStorage.removeItem('wordsmaster_wrong_words');
      renderNotebook();
      updateHud();
    });
    els.btnDrillNotebook.addEventListener('click', () => {
      if (state.wrongWords.length === 0) return;
      state.wordList = shuffleArray([...state.wrongWords]);
      state.currentIndex = 0;
      state.streak = 0;
      els.modalNotebook.hidden = true;
      startCurrentMode();
    });

    // 胜利弹窗按钮
    els.btnVicRestart.addEventListener('click', () => {
      closeVictoryModal();
      state.score = 0;
      state.streak = 0;
      state.wordList = shuffleArray([...state.wordList]);
      startCurrentMode();
    });
    els.btnVicNextTier.addEventListener('click', () => {
      closeVictoryModal();
      const keys = Object.keys(VOCAB_DECKS);
      const nextIdx = (keys.indexOf(state.currentDeck) + 1) % keys.length;
      const nextDeck = keys[nextIdx];
      // 同步 UI 状态
      document.querySelectorAll<HTMLButtonElement>('.deck-chip').forEach(b => {
        b.classList.toggle('active', b.dataset.deck === nextDeck);
      });
      switchDeck(nextDeck);
    });

    // 初始化运行
    startCurrentMode();
  </script>
</body>
</html>
