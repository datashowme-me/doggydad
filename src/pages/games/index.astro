---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="游戏模块 · 口算速算与体感互动实验 | WordsMaster"
  description="WordsMaster 游戏模块：专为小学低年级打造的 100 以内口算速算闯关、摄像头 AI 手势体感切水果与 Three.js 3D 艺术抓娃娃机，纯前端本地运行。"
  keywords={['口算速算', '小学数学口算', '100以内口算', '切水果', '体感游戏', '手势识别', '浏览器游戏', 'WordsMaster 游戏']}
>
  <section class="games-page">
    <div class="games-hero">
      <div class="hero-badge">🎮 互动实验室 · 本地轻量运行</div>
      <h1>游戏模块</h1>
      <p>浏览器即开即玩的交互游戏与数学训练工具。零依赖、零安装，支持触屏、键盘与摄像头体感互动。</p>
    </div>

    <!-- 游戏模块导航 Tab 栏 -->
    <div class="games-tabs-wrapper" role="region" aria-label="游戏模块选项卡">
      <div class="games-tabs" role="tablist">
        <button type="button" class="tab-item active" role="tab" id="tab-btn-all" aria-selected="true" aria-controls="panel-all" data-tab="all">
          <span class="tab-icon">🌟</span>
          <span class="tab-title">全部游戏</span>
          <span class="tab-count">4</span>
        </button>
        <button type="button" class="tab-item" role="tab" id="tab-btn-math" aria-selected="false" aria-controls="panel-math" data-tab="math">
          <span class="tab-icon">🧮</span>
          <span class="tab-title">口算速算</span>
          <span class="tab-pill">1-3年级专训</span>
        </button>
        <button type="button" class="tab-item" role="tab" id="tab-btn-words" aria-selected="false" aria-controls="panel-words" data-tab="words">
          <span class="tab-icon">🔤</span>
          <span class="tab-title">单词大冒险</span>
          <span class="tab-pill">少儿拼读·PixelFX</span>
        </button>
        <button type="button" class="tab-item" role="tab" id="tab-btn-fruitwave" aria-selected="false" aria-controls="panel-fruitwave" data-tab="fruitwave">
          <span class="tab-icon">🍉</span>
          <span class="tab-title">体感切水果</span>
          <span class="tab-pill">AI 手势</span>
        </button>
        <button type="button" class="tab-item" role="tab" id="tab-btn-artcatcher" aria-selected="false" aria-controls="panel-artcatcher" data-tab="artcatcher">
          <span class="tab-icon">🧸</span>
          <span class="tab-title">3D 抓娃娃</span>
          <span class="tab-pill">Three.js</span>
        </button>
      </div>
    </div>

    <!-- Tab 1: 全部游戏 -->
    <div class="tab-panel active" id="panel-all" role="tabpanel" aria-labelledby="tab-btn-all">
      <div class="game-grid">
        <!-- 口算速算卡片 -->
        <a class="game-card math-card" href={`${base}/games/math/`}>
          <div class="card-featured-badge">🧮 推荐：小学数学速算</div>
          <div class="game-cover math-cover">
            <span class="cover-math math-1">🧮</span>
            <span class="cover-math math-2">➕</span>
            <span class="cover-math math-3">✖️</span>
            <span class="cover-math math-4">⭐</span>
          </div>
          <div class="game-body">
            <h2>口算大冲关 · 100以内速算</h2>
            <p>专为 1–3 年级设计的速算闯关神器：11级数段平滑晋阶、比大小智能按键、手写草稿纸竖式画板与错题闭环。</p>
            <div class="game-tags">
              <span>10-100梯度</span>
              <span>比大小 & 混合</span>
              <span>手写草稿纸</span>
              <span>错题闭环</span>
              <span>Web Audio 音效</span>
              <span>PixelFX 像素特效</span>
            </div>
            <div class="game-cta">进入口算冲关 →</div>
          </div>
        </a>

        <!-- 单词大冒险卡片 -->
        <a class="game-card words-card" href={`${base}/games/words/`}>
          <div class="card-featured-badge" style="color:#38bdf8; border-color:rgba(56,189,248,0.4);">🔤 热门：少儿拼词与听力</div>
          <div class="game-cover words-cover">
            <span class="cover-word word-1">🐶</span>
            <span class="cover-word word-2">🍎</span>
            <span class="cover-word word-3">🔤</span>
            <span class="cover-word word-4">⭐</span>
          </div>
          <div class="game-body">
            <h2>单词大冒险 · 少儿趣味拼读</h2>
            <p>专为少儿与学生打造的沉浸式背单词闯关：同步大陆牛津版小学教材（1-6年级核心）、字母气泡拼词、听音辨词侦探、连连看消消乐与 1/2/3 分钟限时狂飙，搭载 PixelFX 动效与纯正发音。</p>
            <div class="game-tags">
              <span>牛津1-6年级同步</span>
              <span>自然拼读</span>
              <span>萌宠果蔬文具</span>
              <span>听音辨词</span>
              <span>1/2/3min限时</span>
              <span>真人纯正发音</span>
              <span>PixelFX 动效</span>
            </div>
            <div class="game-cta">开启单词冒险 →</div>
          </div>
        </a>

        <!-- 切水果卡片 -->
        <a class="game-card fruitwave-card" href={`${base}/games/fruitwave/`}>
          <div class="game-cover fruitwave-cover">
            <div class="cover-blade-sheen"></div>
            <span class="cover-fruit fruit-1">🍉</span>
            <span class="cover-fruit fruit-2">🍓</span>
            <span class="cover-fruit fruit-3">🍍</span>
            <span class="cover-burst">✨</span>
          </div>
          <div class="game-body">
            <h2>FruitWave · 切水果</h2>
            <p>90 秒极限切水果，12 种水果等你挑战。有摄像头就伸出食指挥砍，没有摄像头用鼠标 / 触控板一样能玩。</p>
            <div class="game-tags">
              <span>手势识别</span>
              <span>鼠标 / 触控</span>
              <span>本地运行</span>
            </div>
            <div class="game-cta">开始切水果 →</div>
          </div>
        </a>

        <!-- 3D抓娃娃卡片 -->
        <a class="game-card artcatcher-card" href={`${base}/games/artcatcher/`}>
          <div class="game-cover artcatcher-cover">🧸🎁🦄</div>
          <div class="game-body">
            <h2>ArtCatcher · 3D 抓娃娃</h2>
            <p>Three.js 打造的 3D 艺术抓娃娃机：投币、操控机械爪、收集艺术手办，还有成就和图鉴等着你。</p>
            <div class="game-tags">
              <span>3D 物理</span>
              <span>键盘 / 触屏摇杆</span>
              <span>艺术手办图鉴</span>
            </div>
            <div class="game-cta">启动抓娃娃机 →</div>
          </div>
        </a>
      </div>
    </div>

    <!-- Tab 2: 口算速算单独专栏 (Dedicated Math Tab) -->
    <div class="tab-panel" id="panel-math" role="tabpanel" aria-labelledby="tab-btn-math" hidden>
      <div class="math-showcase">
        <!-- 主推大卡片 -->
        <div class="math-hero-card">
          <div class="math-hero-badge">小学生（1–3年级）口算专项提分神器</div>
          <div class="math-hero-content">
            <div class="math-hero-text">
              <h2>🧮 100 以内口算速算大冲关</h2>
              <p class="math-hero-desc">
                紧扣教育部人教版小学数学新课标，涵盖 <strong>10以内加减</strong>、<strong>20以内凑十破十</strong>、<strong>整十数进退位</strong> 直至 <strong>表内乘除混合</strong> 全 11 级梯度。内置比大小智能按键、竖式草稿画板、错题自动沉淀与 A4 纸质作业单打印生成。
              </p>
              <div class="math-hero-actions">
                <a class="btn-primary-action" href={`${base}/games/math/`}>
                  🎮 立即开始口算冲关
                </a>
                <a class="btn-secondary-action" href={`${base}/games/math/standalone.html`} target="_blank" rel="noopener">
                  📥 打开离线单文件版
                </a>
              </div>
            </div>
            <div class="math-hero-visual">
              <div class="math-preview-box">
                <div class="preview-tag">题型预览</div>
                <div class="preview-expr">38 + 24 = <span class="preview-ans">62</span></div>
                <div class="preview-compare">7 × 8 <span class="preview-circle">&gt;</span> 54</div>
                <div class="preview-chips">
                  <span>✨ 连击音效</span>
                  <span>👾 PixelFX 像素动效</span>
                  <span>📝 竖式草稿</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 核心特色 4 栏 -->
        <div class="math-features-grid">
          <div class="math-feature-item">
            <div class="feat-icon">🪜</div>
            <h3>11 级数段逐级平滑晋阶</h3>
            <p>从 10 以内基础稳扎稳打，每答对 2–3 题自动跃迁至下一十位数，满级挑战表内乘除综合，升级伴随金色礼花动效。</p>
          </div>
          <div class="math-feature-item">
            <div class="feat-icon">⌨️</div>
            <h3>符号与数字按键智能互斥</h3>
            <p>比大小题目自动隐藏 0–9 数字盘，仅展示 &gt;、&lt;、= 触控大键；计算题显示大触控数字键盘，支持键盘数字键与回车秒提。</p>
          </div>
          <div class="math-feature-item">
            <div class="feat-icon">📝</div>
            <h3>内置手写草稿纸竖式画板</h3>
            <p>右上角一键唤出半透明手写草稿纸，随手列竖式、标注进退位与试商，支持多色彩笔、橡皮与无损步骤撤销。</p>
          </div>
          <div class="math-feature-item">
            <div class="feat-icon">🖨️</div>
            <h3>错题巩固闭环 & A4 题卡打印</h3>
            <p>自动收集错题沉淀在错题本，支持一键错题专训；更支持随时生成 50 题标准 A4 每日打卡练习卷，直接调用打印机。</p>
          </div>
        </div>

        <!-- 11 级梯度全景速览 -->
        <div class="math-tiers-summary">
          <h3>📚 11 个数段梯度一览</h3>
          <div class="tiers-tags-list">
            <span class="tier-chip"><strong>T1</strong> 10 以内加减基础</span>
            <span class="tier-chip"><strong>T2</strong> 20 以内进位加 & 破十减</span>
            <span class="tier-chip"><strong>T3</strong> 30 以内加减与连加</span>
            <span class="tier-chip"><strong>T4</strong> 40 以内混合运算</span>
            <span class="tier-chip"><strong>T5</strong> 50 以内速算挑战</span>
            <span class="tier-chip"><strong>T6</strong> 60 以内满十进位</span>
            <span class="tier-chip"><strong>T7</strong> 70 以内加减混合</span>
            <span class="tier-chip"><strong>T8</strong> 80 以内综合进退位</span>
            <span class="tier-chip"><strong>T9</strong> 90 以内大数速算</span>
            <span class="tier-chip"><strong>T10</strong> 100 以内连加减满十</span>
            <span class="tier-chip highlight"><strong>T11</strong> 表内乘除综合 (九九乘法)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab: 单词大冒险单独专栏 (Dedicated Words Tab) -->
    <div class="tab-panel" id="panel-words" role="tabpanel" aria-labelledby="tab-btn-words" hidden>
      <div class="math-showcase">
        <!-- 主推大卡片 -->
        <div class="math-hero-card" style="background:radial-gradient(circle at 80% 20%, rgba(56, 189, 248, 0.15), transparent 50%), linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-alt) 100%); border-color:color-mix(in srgb, #38bdf8 35%, var(--color-border));">
          <div class="math-hero-badge" style="background:#0284c7; color:#f0f9ff;">少儿与学生趣味背词 · 字母拼读与听力专训</div>
          <div class="math-hero-content">
            <div class="math-hero-text">
              <h2>🔤 单词大冒险 · 趣味拼读与速记</h2>
              <p class="math-hero-desc">
                专为少儿、学生与英语爱好者打造的沉浸式单词游戏。融合 <strong>大陆牛津版小学英语（1-6年级同步词库）</strong>、<strong>字母气泡拼词</strong>、<strong>听音辨词小侦探</strong>、<strong>限时冲关狂飙 (1/2/3分钟)</strong> 与 <strong>单词连连看消消乐</strong> 4 大玩法。涵盖牛津低/中/高各年级、萌宠动物、果蔬美食、日常文具等 11 大精选词库，支持慢速发音跟读与 PixelFX 像素打击特效。
              </p>
              <div class="math-hero-actions">
                <a class="btn-primary-action" style="background:#0284c7;" href={`${base}/games/words/`}>
                  🎮 立即开始单词冒险
                </a>
                <a class="btn-secondary-action" href={`${base}/games/words/standalone.html`} target="_blank" rel="noopener">
                  📥 打开离线单文件版
                </a>
              </div>
            </div>
            <div class="math-hero-visual">
              <div class="math-preview-box" style="border-color:#0284c7;">
                <div class="preview-tag">题型预览</div>
                <div style="font-size:3.2rem; margin-bottom:0.25rem;">🐶</div>
                <div class="preview-expr">d o g <span class="preview-ans">小狗</span></div>
                <div class="preview-compare" style="font-size:1.1rem; color:#94a3b8;">/dɔːɡ/ · 萌宠自然拼读</div>
                <div class="preview-chips">
                  <span>🔊 真人发音</span>
                  <span>🐢 0.75x慢速跟读</span>
                  <span>✨ PixelFX 动效</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 核心特色 4 栏 -->
        <div class="math-features-grid">
          <div class="math-feature-item">
            <div class="feat-icon">🔤</div>
            <h3>字母气泡拼读挑战</h3>
            <p>屏幕打乱字母气泡，既可手指触屏轻点拼词，也能键盘盲打直接键入，支持字母提示与随时退格撤销。</p>
          </div>
          <div class="math-feature-item">
            <div class="feat-icon">🎧</div>
            <h3>听音辨词侦探模式</h3>
            <p>调用 Web Speech TTS 纯正英文原声，自动辨听发音在 4 个图文卡片中选出正确词汇，锤炼少儿敏锐听力。</p>
          </div>
          <div class="math-feature-item">
            <div class="feat-icon">⏱️</div>
            <h3>1/2/3分钟限时冲刺狂飙</h3>
            <p>支持 1 分钟快速热身、2 分钟标准演练与 3 分钟极限刷词，连续答对触发 PixelFX 火箭连击与暴击加分！</p>
          </div>
          <div class="math-feature-item">
            <div class="feat-icon">🧩</div>
            <h3>单词连连看消消乐</h3>
            <p>英文单词与中文释义卡片网格随机分布，快速匹配翻转消除，锻炼记忆广度与瞬时注意力。</p>
          </div>
        </div>

        <!-- 11 大词库全景速览 -->
        <div class="math-tiers-summary">
          <h3>📚 11 大精选词库一览（含大陆牛津版小学全套）</h3>
          <div class="tiers-tags-list">
            <span class="tier-chip highlight"><strong>01</strong> 🏫 牛津1-2年级 (低年级启蒙核心)</span>
            <span class="tier-chip highlight"><strong>02</strong> 📘 牛津3-4年级 (中年级生活交际)</span>
            <span class="tier-chip highlight"><strong>03</strong> 🎓 牛津5-6年级 (高年级小升初核心)</span>
            <span class="tier-chip"><strong>04</strong> 🐾 萌宠动物 (自然拼读入门)</span>
            <span class="tier-chip"><strong>05</strong> 🍎 美味果蔬 (小学高频日常)</span>
            <span class="tier-chip"><strong>06</strong> 🎨 颜色数字 (低年级基础认知)</span>
            <span class="tier-chip"><strong>07</strong> 👀 身体家庭 (生活情景表达)</span>
            <span class="tier-chip"><strong>08</strong> 🎒 校园文具 (PEP教材核心)</span>
            <span class="tier-chip"><strong>09</strong> 🏃 趣味动作 (常用动词速记)</span>
            <span class="tier-chip"><strong>10</strong> ⛅ 天气四季 (进阶扩展词汇)</span>
            <span class="tier-chip"><strong>11</strong> 💻 程序员极客 (Tech 常用技术词)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 3: 体感切水果单独专栏 -->
    <div class="tab-panel" id="panel-fruitwave" role="tabpanel" aria-labelledby="tab-btn-fruitwave" hidden>
      <div class="game-detail-card">
        <div class="detail-header">
          <div class="detail-title-group">
            <h2>🍉 FruitWave · 体感切水果</h2>
            <p>基于浏览器前端摄像头与 AI 手势关键点追踪的体感割草切水果。零依赖本地处理，保护隐私。</p>
          </div>
          <a class="btn-primary-action" href={`${base}/games/fruitwave/`}>
            🔪 开启切水果
          </a>
        </div>
        <div class="detail-info-grid">
          <div class="info-box">
            <h4>🎮 两种操作模式</h4>
            <p>既能调用前置摄像头伸出食指隔空挥砍刀光，也可随时用鼠标或手指触控划屏，流畅支持高刷新率。</p>
          </div>
          <div class="info-box">
            <h4>⏱️ 90 秒极限挑战</h4>
            <p>西瓜、草莓、菠萝、香蕉等 12 种各具特色的多汁水果随机抛掷，连击斩切触发额外爆汁加分。</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 4: 3D 抓娃娃单独专栏 -->
    <div class="tab-panel" id="panel-artcatcher" role="tabpanel" aria-labelledby="tab-btn-artcatcher" hidden>
      <div class="game-detail-card">
        <div class="detail-header">
          <div class="detail-title-group">
            <h2>🧸 ArtCatcher · 3D 艺术抓娃娃机</h2>
            <p>基于 Three.js 打造的真实物理爪机模拟器：3D 环形灯光、投币物理反馈与多款珍藏级艺术手办。</p>
          </div>
          <a class="btn-primary-action" href={`${base}/games/artcatcher/`}>
            🕹️ 启动抓娃娃机
          </a>
        </div>
        <div class="detail-info-grid">
          <div class="info-box">
            <h4>🕹️ 真实抓取力学</h4>
            <p>支持方向键 / 虚拟摇杆控制机械爪 X/Z 轴滑行，按下投币与下落抓取键，观察爪爪抓取包裹下落的物理重心碰撞。</p>
          </div>
          <div class="info-box">
            <h4>🏆 艺术图鉴展柜</h4>
            <p>成功抓取的娃娃将永久陈列于您的私人 3D 艺术品收藏架，配有专属成就勋章与掉落概率。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      const tabs = document.querySelectorAll('.tab-item');
      const panels = {
        all: document.getElementById('panel-all'),
        math: document.getElementById('panel-math'),
        words: document.getElementById('panel-words'),
        fruitwave: document.getElementById('panel-fruitwave'),
        artcatcher: document.getElementById('panel-artcatcher')
      };

      function switchTab(tabKey, updateHash = true) {
        if (!panels[tabKey]) tabKey = 'all';

        tabs.forEach(btn => {
          const isSelected = btn.dataset.tab === tabKey;
          btn.classList.toggle('active', isSelected);
          btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        });

        Object.keys(panels).forEach(key => {
          const panel = panels[key];
          if (!panel) return;
          if (key === tabKey) {
            panel.hidden = false;
            panel.classList.add('active');
          } else {
            panel.hidden = true;
            panel.classList.remove('active');
          }
        });

        if (updateHash) {
          try {
            if (tabKey === 'all') {
              history.replaceState(null, '', window.location.pathname + window.location.search);
            } else {
              history.replaceState(null, '', `#${tabKey}`);
            }
          } catch (e) {}
        }
      }

      tabs.forEach(btn => {
        btn.addEventListener('click', () => {
          switchTab(btn.dataset.tab, true);
        });
      });

      // 初始化：检测 URL Hash 或 query 参数
      function initTabFromUrl() {
        const hash = window.location.hash.replace('#', '').toLowerCase();
        const urlParams = new URLSearchParams(window.location.search);
        const queryTab = (urlParams.get('tab') || '').toLowerCase();

        const target = hash || queryTab;
        if (target && panels[target]) {
          switchTab(target, false);
        }
      }

      window.addEventListener('hashchange', () => {
        const hash = window.location.hash.replace('#', '').toLowerCase();
        if (panels[hash]) switchTab(hash, false);
      });

      initTabFromUrl();
    })();
  </script>
</BaseLayout>

