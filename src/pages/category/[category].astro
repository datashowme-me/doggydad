---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories, getPostDate, withBase, type CategoryKey } from '../../lib/blog';

export function getStaticPaths() {
  return Object.keys(categories).map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props as { category: CategoryKey };
const categoryInfo = categories[category];
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((post) => (post.data.category || post.slug.split('/')[0]) === category)
  .sort((a, b) => getPostDate(b).getTime() - getPostDate(a).getTime());
---

<BaseLayout title={`${categoryInfo.name} — DoggyDad`} description={categoryInfo.description}>
  <header class="category-header" style={`--category-accent:${categoryInfo.accent}`}>
    <p class="eyebrow">CATEGORY / {category.toUpperCase()}</p>
    <div>
      <h1>{categoryInfo.name}</h1>
      <p>{categoryInfo.description}</p>
    </div>
    <span>{String(posts.length).padStart(2, '0')} 篇</span>
  </header>

  <nav class="category-switcher" aria-label="切换分类">
    <a href={withBase('/')}>全部</a>
    {Object.entries(categories).map(([key, item]) => (
      <a href={withBase(`/category/${key}/`)} aria-current={key === category ? 'page' : undefined}>{item.name}</a>
    ))}
  </nav>

  {posts.length > 0 ? (
    <section class="category-posts" aria-label={`${categoryInfo.name}文章`}>
      {posts.map((post, index) => <PostCard post={post} featured={index === 0} />)}
    </section>
  ) : (
    <section class="empty-state">
      <p>这个分类还没有文章。</p>
      <a href={withBase('/')}>返回首页</a>
    </section>
  )}
</BaseLayout>

<style>
  .category-header { --category-accent: var(--color-accent); display: grid; grid-template-columns: 11rem 1fr auto; align-items: end; gap: 2rem; padding: 1rem 0 clamp(3.5rem, 8vw, 6.5rem); border-bottom: 1px solid var(--color-border); }
  .eyebrow { align-self: start; margin: .35rem 0 0; color: var(--category-accent); font-size: .7rem; font-weight: 700; letter-spacing: .13em; }
  h1 { margin: 0; color: var(--color-heading); font-family: var(--font-serif); font-size: clamp(3rem, 8vw, 6.3rem); letter-spacing: -.055em; line-height: 1; }
  .category-header div p { max-width: 32rem; margin: 1.2rem 0 0; color: var(--color-text-soft); line-height: 1.8; }
  .category-header > span { color: var(--color-text-muted); font-size: .82rem; font-variant-numeric: tabular-nums; }

  .category-switcher { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding: 1.1rem 0; border-bottom: 1px solid var(--color-border); }
  .category-switcher a { color: var(--color-text-muted); font-size: .84rem; font-weight: 600; text-decoration: none; }
  .category-switcher a:hover, .category-switcher a[aria-current='page'] { color: var(--color-heading); }
  .category-switcher a[aria-current='page']::before { content: '●'; margin-right: .4rem; color: var(--category-accent); font-size: .6rem; }

  .category-posts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 7vw, 6rem); padding-top: 2rem; }
  .category-posts :global(.featured) { grid-column: 1 / -1; }
  .empty-state { padding: 5rem 0; }

  @media (max-width: 760px) {
    .category-header { grid-template-columns: 1fr auto; }
    .category-header .eyebrow { grid-column: 1 / -1; }
    .category-posts { grid-template-columns: 1fr; }
    .category-posts :global(.featured) { grid-column: auto; }
  }
</style>
