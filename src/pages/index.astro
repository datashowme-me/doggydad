<script>
  // ================= 1. 先驱格言随机轮播交互 =================
  interface PioneerQuote {
    quote: string;
    translation: string;
    author: string;
    award: string;
    link: string;
  }

  const PIONEER_QUOTES: PioneerQuote[] = [
    {
      quote: '“Simplicity is prerequisite for reliability.”',
      translation: '“简单，是系统可靠性的首要前提。”',
      author: 'Edsger W. Dijkstra',
      award: '1972 图灵奖得主 · 结构化程序设计先驱',
      link: '/posts/turing-award/07_1972_edsger_w_dijkstra/'
    },
    {
      quote: '“Premature optimization is the root of all evil.”',
      translation: '“过早的优化，是软件开发中一切灾难的根源。”',
      author: 'Donald E. Knuth',
      award: '1974 图灵奖得主 · 《计算机程序设计艺术》作者',
      link: '/posts/turing-award/09_1974_donald_e_knuth/'
    },
    {
      quote: '“A language that doesn\'t affect the way you think about programming, is not worth knowing.”',
      translation: '“如果一门语言无法影响你的编程思维方式，那它就不值得学习。”',
      author: 'Alan Perlis',
      award: '1966 首届图灵奖得主 · 编译器与编程语言开拓者',
      link: '/posts/turing-award/01_1966_alan_perlis/'
    },
    {
      quote: '“We can only see a short distance ahead, but we can see plenty there that needs to be done.”',
      translation: '“我们能看清的距离很短，但眼前已有太多值得做的事情。”',
      author: 'Alan Turing',
      award: '计算机科学之父 · 图灵机与人工智能先驱',
      link: '/posts/turing-award/alan-turing/'
    },
    {
      quote: '“The best way to predict the future is to invent it.”',
      translation: '“预测未来的最好方法，就是亲手去发明它。”',
      author: 'Alan Kay',
      award: '2003 图灵奖得主 · 面向对象与图形界面先驱',
      link: '/posts/turing-award/38_2003_alan_kay/'
    }
  ];

  let currentQuoteIndex = 0;
  const quoteText = document.getElementById('quote-text');
  const quoteTranslation = document.getElementById('quote-translation');
  const quoteAuthor = document.getElementById('quote-author');
  const quoteAward = document.getElementById('quote-award');
  const quoteLink = document.getElementById('quote-link') as HTMLAnchorElement | null;
  const quoteRefreshBtn = document.getElementById('quote-refresh-btn');
  const pioneerCard = document.getElementById('pioneer-card');

  function renderQuote(index: number) {
    const q = PIONEER_QUOTES[index];
    if (!q || !quoteText || !quoteTranslation || !quoteAuthor || !quoteAward || !quoteLink) return;

    pioneerCard?.classList.add('fade-anim');
    quoteText.textContent = q.quote;
    quoteTranslation.textContent = q.translation;
    quoteAuthor.textContent = q.author;
    quoteAward.textContent = q.award;
    quoteLink.href = q.link;

    setTimeout(() => {
      pioneerCard?.classList.remove('fade-anim');
    }, 200);
  }

  quoteRefreshBtn?.addEventListener('click', () => {
    currentQuoteIndex = (currentQuoteIndex + 1) % PIONEER_QUOTES.length;
    renderQuote(currentQuoteIndex);
  });

  // ================= 2. Tab 切换与滑动指示器 =================
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.segmented-btn');
  const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
  const indicator = document.getElementById('segmented-indicator');

  function updateIndicatorPosition(activeBtn: HTMLButtonElement) {
    if (!indicator) return;
    const nav = activeBtn.parentElement;
    if (!nav) return;
    const navRect = nav.getBoundingClientRect();
    const btnRect = activeBtn.getBoundingClientRect();
    const leftOffset = btnRect.left - navRect.left;
    const width = btnRect.width;

    indicator.style.transform = `translateX(${leftOffset}px)`;
    indicator.style.width = `${width}px`;
  }

  function switchTab(tabId: string, updateUrl = true) {
    if (!['blog', 'games', 'words'].includes(tabId)) {
      tabId = 'blog';
    }

    let activeBtn: HTMLButtonElement | null = null;
    tabButtons.forEach((btn) => {
      const isTarget = btn.getAttribute('data-tab') === tabId;
      btn.classList.toggle('active', isTarget);
      btn.setAttribute('aria-selected', String(isTarget));
      if (isTarget) activeBtn = btn;
    });

    tabPanels.forEach((panel) => {
      const isTarget = panel.id === `panel-${tabId}`;
      panel.classList.toggle('active', isTarget);
    });

    if (activeBtn) {
      updateIndicatorPosition(activeBtn);
    }

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set('tab', tabId);
      window.history.replaceState({}, '', url.toString());
    }

    if (tabId === 'words') {
      const hiddenInput = document.getElementById('hidden-word-input') as HTMLInputElement | null;
      hiddenInput?.focus();
    }
  }

  // 快捷键 1, 2, 3 秒切 Tab
  window.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.key === '1') {
      e.preventDefault();
      switchTab('blog');
    } else if (e.key === '2') {
      e.preventDefault();
      switchTab('games');
    } else if (e.key === '3') {
      e.preventDefault();
      switchTab('words');
    }
  });

  // 初始化根据 URL 参数或 Hash 激活对应 Tab
  const initialParams = new URLSearchParams(window.location.search);
  const tabParam = initialParams.get('tab') || window.location.hash.replace('#', '');
  if (tabParam && ['blog', 'games', 'words'].includes(tabParam)) {
    switchTab(tabParam, false);
  } else {
    const defaultActiveBtn = document.querySelector<HTMLButtonElement>('.segmented-btn.active');
    if (defaultActiveBtn) {
      requestAnimationFrame(() => updateIndicatorPosition(defaultActiveBtn));
    }
  }

  window.addEventListener('resize', () => {
    const activeBtn = document.querySelector<HTMLButtonElement>('.segmented-btn.active');
    if (activeBtn) updateIndicatorPosition(activeBtn);
  });

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetTab = btn.getAttribute('data-tab');
      if (targetTab) switchTab(targetTab);
    });
  });

  // ================= 3. 游戏实验室切换与嵌入试玩 =================
  const pillFruitwave = document.getElementById('game-pill-fruitwave');
  const pillArtcatcher = document.getElementById('game-pill-artcatcher');
  const displayFruitwave = document.getElementById('game-display-fruitwave');
  const displayArtcatcher = document.getElementById('game-display-artcatcher');

  const toggleEmbedFruitwaveBtn = document.getElementById('toggle-embed-fruitwave-btn');
  const toggleEmbedArtcatcherBtn = document.getElementById('toggle-embed-artcatcher-btn');
  const embedGameContainer = document.getElementById('embed-game-container');
  const gameIframe = document.getElementById('game-iframe') as HTMLIFrameElement | null;
  const embedBoxTitle = document.getElementById('embed-box-title');
  const embedFullscreenLink = document.getElementById('embed-fullscreen-link') as HTMLAnchorElement | null;
  const embedFruitwaveText = document.getElementById('embed-fruitwave-text');
  const embedArtcatcherText = document.getElementById('embed-artcatcher-text');
  const closeEmbedBtn = document.getElementById('close-embed-game-btn');

  function switchSubgame(game: 'fruitwave' | 'artcatcher') {
    if (game === 'fruitwave') {
      pillFruitwave?.classList.add('active');
      pillFruitwave?.setAttribute('aria-selected', 'true');
      pillArtcatcher?.classList.remove('active');
      pillArtcatcher?.setAttribute('aria-selected', 'false');

      displayFruitwave?.classList.remove('hidden');
      displayFruitwave?.classList.add('active');
      displayArtcatcher?.classList.add('hidden');
      displayArtcatcher?.classList.remove('active');
    } else {
      pillArtcatcher?.classList.add('active');
      pillArtcatcher?.setAttribute('aria-selected', 'true');
      pillFruitwave?.classList.remove('active');
      pillFruitwave?.setAttribute('aria-selected', 'false');

      displayArtcatcher?.classList.remove('hidden');
      displayArtcatcher?.classList.add('active');
      displayFruitwave?.classList.add('hidden');
      displayFruitwave?.classList.remove('active');
    }
  }

  pillFruitwave?.addEventListener('click', () => switchSubgame('fruitwave'));
  pillArtcatcher?.addEventListener('click', () => switchSubgame('artcatcher'));

  let currentActiveEmbed: 'fruitwave' | 'artcatcher' | null = null;

  function openEmbedGame(game: 'fruitwave' | 'artcatcher') {
    if (!embedGameContainer || !gameIframe) return;
    embedGameContainer.classList.remove('hidden');
    currentActiveEmbed = game;

    const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, '');
    if (game === 'fruitwave') {
      const targetUrl = `${basePrefix}/games/fruitwave/`;
      if (gameIframe.src !== targetUrl && !gameIframe.src.endsWith('/games/fruitwave/')) {
        gameIframe.src = targetUrl;
      }
      if (embedBoxTitle) embedBoxTitle.textContent = 'FruitWave 浏览器体感切水果沙盒';
      if (embedFullscreenLink) embedFullscreenLink.href = targetUrl;
      if (embedFruitwaveText) embedFruitwaveText.textContent = '收起试玩窗口 ▴';
      if (embedArtcatcherText) embedArtcatcherText.textContent = '在当前页快速试玩 ▾';
    } else {
      const targetUrl = `${basePrefix}/games/artcatcher/`;
      if (gameIframe.src !== targetUrl && !gameIframe.src.endsWith('/games/artcatcher/')) {
        gameIframe.src = targetUrl;
      }
      if (embedBoxTitle) embedBoxTitle.textContent = 'ArtCatcher 3D 实时渲染物理爪机沙盒';
      if (embedFullscreenLink) embedFullscreenLink.href = targetUrl;
      if (embedArtcatcherText) embedArtcatcherText.textContent = '收起试玩窗口 ▴';
      if (embedFruitwaveText) embedFruitwaveText.textContent = '在当前页快速试玩 ▾';
    }
    embedGameContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function closeEmbedGame() {
    if (!embedGameContainer) return;
    embedGameContainer.classList.add('hidden');
    currentActiveEmbed = null;
    if (embedFruitwaveText) embedFruitwaveText.textContent = '在当前页快速试玩 ▾';
    if (embedArtcatcherText) embedArtcatcherText.textContent = '在当前页快速试玩 ▾';
  }

  toggleEmbedFruitwaveBtn?.addEventListener('click', () => {
    if (!embedGameContainer?.classList.contains('hidden') && currentActiveEmbed === 'fruitwave') {
      closeEmbedGame();
    } else {
      openEmbedGame('fruitwave');
    }
  });

  toggleEmbedArtcatcherBtn?.addEventListener('click', () => {
    if (!embedGameContainer?.classList.contains('hidden') && currentActiveEmbed === 'artcatcher') {
      closeEmbedGame();
    } else {
      openEmbedGame('artcatcher');
    }
  });

  closeEmbedBtn?.addEventListener('click', closeEmbedGame);

