  .fruit-accent {
    color: #34d399 !important;
  }
  .fruit-btn {
    background: #34d399 !important;
    color: #062419 !important;
  }
  .fruit-btn:hover {
    background: #6ee7b7 !important;
  }
  .game-specs-strip {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-bottom: 1.4rem;
  }
  .spec-tag {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    padding: .2rem .65rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, .08);
    border: 1px solid rgba(255, 255, 255, .12);
    font-size: .78rem;
    color: #d1fae5;
  }
  .fruit-border {
    border-color: rgba(52, 211, 153, .25) !important;
  }
  .fruit-badge {
    background: rgba(52, 211, 153, .12) !important;
    color: #34d399 !important;
    border: 1px solid rgba(52, 211, 153, .3);
  }
  .fruit-guide {
    border-color: rgba(52, 211, 153, .25) !important;
    background: rgba(16, 185, 129, .04);
  }

  /* FruitWave 动效视觉视窗 */
  .fruitwave-visual-card {
    position: relative;
    width: 14rem;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(52, 211, 153, .35);
    border-radius: var(--radius-xl);
    background: radial-gradient(circle at 50% 50%, rgba(16, 185, 129, .2), transparent 70%), linear-gradient(145deg, #0a1712 0%, #11261d 55%, #181326 100%);
    box-shadow: inset 0 0 2.5rem rgba(52, 211, 153, .12), 0 1rem 2.5rem rgba(0, 0, 0, .45);
    overflow: hidden;
    perspective: 800px;
  }

  .visual-card-ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, rgba(52, 211, 153, 0.22) 0%, rgba(52, 211, 153, 0) 65%);
    animation: visualAmbientGlow 3.6s ease-in-out infinite alternate;
    pointer-events: none;
  }

  /* 核心切水果动画舞台 */
  .slice-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-watermelon-box {
    position: absolute;
    top: 45%;
    left: 50%;
    width: 4.8rem;
    height: 4.8rem;
    transform: translate(-50%, -50%);
    animation: heroFloatCycle 3.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .watermelon-half {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    user-select: none;
    filter: drop-shadow(0 6px 14px rgba(0,0,0,.5));
  }

  .watermelon-half.half-left {
    clip-path: polygon(0 0, 52% 0, 48% 100%, 0 100%);
    animation: watermelonSplitLeft 3.6s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }

  .watermelon-half.half-right {
    clip-path: polygon(52% 0, 100% 0, 100% 100%, 48% 100%);
    animation: watermelonSplitRight 3.6s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }

  /* 刀光刀芒横扫轨迹 */
  .blade-slash-streak {
    position: absolute;
    top: 45%;
    left: -20%;
    width: 140%;
    height: 3px;
    background: linear-gradient(90deg, transparent, rgba(52,211,153,.3) 15%, #34d399 40%, #ffffff 50%, #34d399 60%, rgba(52,211,153,.3) 85%, transparent);
    box-shadow: 0 0 16px #34d399, 0 0 28px #fff, 0 0 45px rgba(52,211,153,.8);
    transform-origin: center;
    animation: bladeSlashSweep 3.6s cubic-bezier(0.15, 0.85, 0.35, 1) infinite;
  }

  /* 切割瞬间的高光闪爆与冲击波 */
  .blade-slash-flash {
    position: absolute;
    top: 45%;
    left: 50%;
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(52, 211, 153, 0.7) 40%, transparent 70%);
    animation: bladeFlashAnim 3.6s cubic-bezier(0.1, 0.9, 0.2, 1) infinite;
  }

  .slice-impact-burst {
    position: absolute;
    top: 45%;
    left: 50%;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 2px solid rgba(52, 211, 153, 0.8);
    transform: translate(-50%, -50%);
    animation: impactShockwave 3.6s cubic-bezier(0.1, 0.8, 0.2, 1) infinite;
  }

  /* 果汁飞溅水滴群 */
  .juice-spray {
    position: absolute;
    top: 45%;
    left: 50%;
    width: 1px;
    height: 1px;
    transform: translate(-50%, -50%);
  }

  .juice-drop {
    position: absolute;
    border-radius: 999px;
    background: #ff2a5f;
    box-shadow: 0 0 6px #ff2a5f;
    opacity: 0;
  }

  .juice-drop.d1 { width: 6px; height: 10px; animation: dropSpray1 3.6s ease-out infinite; }
  .juice-drop.d2 { width: 5px; height: 8px;  background: #ff477e; animation: dropSpray2 3.6s ease-out infinite; }
  .juice-drop.d3 { width: 7px; height: 12px; background: #ffe4e6; animation: dropSpray3 3.6s ease-out infinite; }
  .juice-drop.d4 { width: 5px; height: 9px;  animation: dropSpray4 3.6s ease-out infinite; }
  .juice-drop.d5 { width: 6px; height: 11px; background: #34d399; animation: dropSpray5 3.6s ease-out infinite; }
  .juice-drop.d6 { width: 8px; height: 8px;  background: #facc15; animation: dropSpray6 3.6s ease-out infinite; }

  /* 得分飘字 */
  .score-popup {
    position: absolute;
    top: 42%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.3rem;
    font-weight: 800;
    color: #fde047;
    text-shadow: 0 2px 8px rgba(0,0,0,0.8), 0 0 12px rgba(250, 204, 21, 0.6);
    animation: scorePopupAnim 3.6s cubic-bezier(0.1, 0.8, 0.2, 1) infinite;
  }

  /* 环绕悬浮漂浮水果 */
  .flying-fruit {
    position: absolute;
    font-size: 2.1rem;
    user-select: none;
    filter: drop-shadow(0 6px 12px rgba(0,0,0,.5));
    will-change: transform;
  }

  .fruit-pineapple {
    top: 14%;
    left: 18%;
    animation: floatPineapple 4.2s ease-in-out infinite alternate;
  }

  .fruit-strawberry {
    top: 12%;
    right: 18%;
    font-size: 1.8rem;
    animation: floatStrawberry 3.8s ease-in-out infinite alternate;
  }

  .fruit-kiwi {
    bottom: 28%;
    left: 15%;
    font-size: 1.9rem;
    animation: floatKiwi 4.6s ease-in-out infinite alternate;
  }

  .fruit-orange {
    bottom: 24%;
    right: 16%;
    font-size: 2rem;
    animation: floatOrange 4.1s ease-in-out infinite alternate;
  }

  /* 闪光火花 */
  .fruit-burst-particle {
    position: absolute;
    color: #34d399;
    font-size: 1.1rem;
    font-weight: 700;
    text-shadow: 0 0 8px #34d399;
  }
  .fruit-burst-particle.p1 { top: 32%; left: 38%; animation: sparkBlink 2.2s ease-in-out infinite; }
  .fruit-burst-particle.p2 { top: 46%; right: 30%; color: #facc15; text-shadow: 0 0 8px #facc15; animation: sparkBlink 2.7s ease-in-out infinite 0.4s; }
  .fruit-burst-particle.p3 { bottom: 36%; left: 45%; color: #6ee7b7; animation: sparkBlink 2.4s ease-in-out infinite 0.9s; }

  /* 动态连击徽章 */
  .fruit-combo-badge {
    position: absolute;
    bottom: 1.1rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .85rem;
    border-radius: 999px;
    background: rgba(6, 36, 25, .88);
    border: 1px solid rgba(52, 211, 153, .45);
    color: #34d399;
    font-size: .8rem;
    font-weight: 700;
    white-space: nowrap;
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 12px rgba(0, 0, 0, .3), 0 0 16px rgba(52, 211, 153, .2);
    animation: comboBadgePulse 3.6s ease-in-out infinite;
  }
  .combo-flame {
    display: inline-block;
    animation: flameWiggle 0.8s ease-in-out infinite alternate;
  }

  /* Keyframe 动效定义 */
  @keyframes visualAmbientGlow {
    0% { opacity: .6; transform: scale(0.95); }
    100% { opacity: 1; transform: scale(1.1); }
  }

  @keyframes heroFloatCycle {
    0% { transform: translate(-50%, 60%) scale(0.7) rotate(-15deg); opacity: 0; }
    15% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
    28% { transform: translate(-50%, -50%) scale(1.05) rotate(5deg); opacity: 1; }
    80% { opacity: 1; }
    92% { transform: translate(-50%, 30%) scale(0.8); opacity: 0; }
    100% { transform: translate(-50%, 60%) scale(0.7); opacity: 0; }
  }

  @keyframes watermelonSplitLeft {
    0%, 27% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    29% {
      transform: translate(-10px, -8px) rotate(-12deg);
      opacity: 1;
    }
    55% {
      transform: translate(-42px, -18px) rotate(-28deg);
      opacity: 1;
    }
    85% {
      transform: translate(-65px, 35px) rotate(-45deg);
      opacity: 0;
    }
    100% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0;
    }
  }

  @keyframes watermelonSplitRight {
    0%, 27% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    29% {
      transform: translate(10px, 8px) rotate(14deg);
      opacity: 1;
    }
    55% {
      transform: translate(45px, 22px) rotate(32deg);
      opacity: 1;
    }
    85% {
      transform: translate(68px, 60px) rotate(52deg);
      opacity: 0;
    }
    100% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0;
    }
  }

  @keyframes bladeSlashSweep {
    0%, 25% {
      opacity: 0;
      transform: rotate(-35deg) scaleX(0.2) translate(-90px, 0);
    }
    27% {
      opacity: 1;
      transform: rotate(-35deg) scaleX(1.3) translate(0, 0);
    }
    31% {
      opacity: .9;
      transform: rotate(-35deg) scaleX(1.5) translate(60px, 0);
    }
    37% {
      opacity: 0;
      transform: rotate(-35deg) scaleX(1.6) translate(120px, 0);
    }
    100% {
      opacity: 0;
      transform: rotate(-35deg) scaleX(0.2) translate(-90px, 0);
    }
  }

  @keyframes bladeFlashAnim {
    0%, 26% { opacity: 0; transform: translate(-50%, -50%) scale(0.2); }
    28% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); }
    34% { opacity: 0; transform: translate(-50%, -50%) scale(1.8); }
    100% { opacity: 0; }
  }

  @keyframes impactShockwave {
    0%, 27% { opacity: 0; transform: translate(-50%, -50%) scale(0.2); }
    29% { opacity: .9; transform: translate(-50%, -50%) scale(1.6); }
    40% { opacity: 0; transform: translate(-50%, -50%) scale(3.2); }
    100% { opacity: 0; }
  }

  @keyframes dropSpray1 {
    0%, 27% { opacity: 0; transform: translate(0, 0) rotate(0); }
    30% { opacity: 1; }
    50% { opacity: .8; transform: translate(-45px, -35px) rotate(-35deg) scale(1.2); }
    75% { opacity: 0; transform: translate(-70px, 15px) rotate(-65deg) scale(0.6); }
    100% { opacity: 0; }
  }

  @keyframes dropSpray2 {
    0%, 27% { opacity: 0; transform: translate(0, 0); }
    30% { opacity: 1; }
    50% { opacity: .8; transform: translate(40px, -30px) rotate(40deg) scale(1.1); }
    75% { opacity: 0; transform: translate(65px, 20px) rotate(70deg) scale(0.5); }
    100% { opacity: 0; }
  }

  @keyframes dropSpray3 {
    0%, 27% { opacity: 0; transform: translate(0, 0); }
    30% { opacity: 1; }
    50% { opacity: .9; transform: translate(-25px, -50px) rotate(-15deg); }
    75% { opacity: 0; transform: translate(-40px, -10px) rotate(-30deg) scale(0.5); }
    100% { opacity: 0; }
  }

  @keyframes dropSpray4 {
    0%, 27% { opacity: 0; transform: translate(0, 0); }
    30% { opacity: 1; }
    50% { opacity: .9; transform: translate(25px, 45px) rotate(45deg); }
    75% { opacity: 0; transform: translate(45px, 90px) rotate(60deg) scale(0.4); }
    100% { opacity: 0; }
  }

  @keyframes dropSpray5 {
    0%, 27% { opacity: 0; transform: translate(0, 0); }
    30% { opacity: 1; }
    50% { opacity: .9; transform: translate(-55px, 15px) rotate(-50deg); }
    75% { opacity: 0; transform: translate(-85px, 60px) rotate(-75deg) scale(0.4); }
    100% { opacity: 0; }
  }

  @keyframes dropSpray6 {
    0%, 27% { opacity: 0; transform: translate(0, 0); }
    30% { opacity: 1; }
    50% { opacity: 1; transform: translate(15px, -45px) scale(1.2); }
    75% { opacity: 0; transform: translate(30px, -15px) scale(0.6); }
    100% { opacity: 0; }
  }

  @keyframes scorePopupAnim {
    0%, 28% {
      opacity: 0;
      transform: translate(-50%, -30%) scale(0.4);
    }
    33% {
      opacity: 1;
      transform: translate(-50%, -90%) scale(1.3);
    }
    55% {
      opacity: 1;
      transform: translate(-50%, -120%) scale(1.05);
    }
    75% {
      opacity: 0;
      transform: translate(-50%, -150%) scale(0.9);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -150%) scale(0.9);
    }
  }

  @keyframes floatPineapple {
    0% { transform: translateY(0) rotate(-10deg) scale(1); }
    100% { transform: translateY(-12px) rotate(6deg) scale(1.06); }
  }

  @keyframes floatStrawberry {
    0% { transform: translateY(0) rotate(15deg) scale(1); }
    100% { transform: translateY(10px) rotate(-8deg) scale(0.94); }
  }

  @keyframes floatKiwi {
    0% { transform: translate(0, 0) rotate(10deg); }
    100% { transform: translate(8px, -10px) rotate(-18deg) scale(1.05); }
  }

  @keyframes floatOrange {
    0% { transform: translate(0, 0) rotate(-20deg); }
    100% { transform: translate(-7px, 9px) rotate(12deg) scale(1.04); }
  }

  @keyframes sparkBlink {
    0%, 100% { opacity: .2; transform: scale(0.8) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.3) rotate(45deg); }
  }

  @keyframes comboBadgePulse {
    0%, 24% { transform: translateX(-50%) scale(1); }
    28% { transform: translateX(-50%) scale(1.14); box-shadow: 0 0 24px rgba(52, 211, 153, .6); }
    38% { transform: translateX(-50%) scale(1.04); }
    100% { transform: translateX(-50%) scale(1); }
  }

  @keyframes flameWiggle {
    0% { transform: rotate(-8deg) scale(1); }
    100% { transform: rotate(10deg) scale(1.2); }
  }

  .games-hero-card {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(13rem, .75fr);
    align-items: center;
