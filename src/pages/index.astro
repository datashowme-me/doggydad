                  </div>
                  <div class="wk-vic-stat-item">
                    <span class="stat-num" id="wk-vic-acc">100%</span>
                    <span class="stat-lbl">准确率</span>
                  </div>
                </div>
                <div class="wk-vic-actions">
                  <button type="button" class="wk-vic-btn-primary" id="wk-vic-restart-btn">🔄 再来一局</button>
                  <button type="button" class="wk-vic-btn-secondary" id="wk-vic-close-btn">关闭</button>
