        phonetic: '/ˌserənˈdɪpəti/',
        translation: 'n. 意外发现珍奇事物的机缘',
        sentence: 'Deep curiosity invites serendipity into unexpected technological discoveries.'
      },
      {
        word: 'pragmatic',
        phonetic: '/præɡˈmætɪk/',
        translation: 'adj. 务实的；讲究实效的',
        sentence: 'The pragmatic craftsman builds simple solutions that solve tangible user needs.'
      }
    ],
    academic: [
      {
        word: 'substantiate',
        phonetic: '/səbˈstænʃieɪt/',
        translation: 'v. 证实；提供有力证据证明',
        sentence: 'Empirical experiments are essential to substantiate any computational hypothesis.'
      },
      {
        word: 'scrutinize',
        phonetic: '/ˈskruːtənaɪz/',
        translation: 'v. 仔细审查；周密检查',
        sentence: 'Senior engineers scrutinize security boundary invariants during architecture reviews.'
      },
      {
        word: 'ubiquity',
        phonetic: '/juːˈbɪkwəti/',
        translation: 'n. 普遍存在；无处不在',
        sentence: 'The ubiquity of smartphones fundamentally altered global information distribution.'
      },
      {
        word: 'synthesize',
        phonetic: '/ˈsɪnθəsaɪz/',
        translation: 'v. 综合；整合多方信息',
        sentence: 'Great researchers synthesize disparate insights across math and engineering.'
      }
    ]
  };

  let currentDeckKey = 'coder';
  let currentWordIndex = 0;
  let typedInput = '';
  let streak = 0;
  let totalKeystrokes = 0;
  let correctKeystrokes = 0;
  let soundEnabled = true;

  // Web Audio 机械键盘敲击音
  let audioCtx: AudioContext | null = null;
  function playKeySound(isCorrect: boolean) {
    if (!soundEnabled) return;
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      if (isCorrect) {
        osc.frequency.setValueAtTime(620, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.035);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.045);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.045);
      } else {
        osc.frequency.setValueAtTime(220, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.07);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.07);
      }
    } catch {
      // Audio fallback
    }
  }

  function playSuccessDing() {
    if (!soundEnabled) return;
    try {
      if (!audioCtx) audioCtx = new AudioContext();
      const osc1 = audioCtx.createOscillator();
      const osc2 = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc1.connect(gain);
      osc2.connect(gain);
      gain.connect(audioCtx.destination);

      osc1.frequency.setValueAtTime(523.25, audioCtx.currentTime);
      osc2.frequency.setValueAtTime(659.25, audioCtx.currentTime);
      gain.gain.setValueAtTime(0.09, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.22);
      osc1.start();
      osc2.start();
      osc1.stop(audioCtx.currentTime + 0.22);
      osc2.stop(audioCtx.currentTime + 0.22);
    } catch {
      // Audio fallback
    }
  }

  function pronounceWord(text: string) {
    if ('speechSynthesis' in window) {
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'en-US';
      utterance.rate = 0.9;
      window.speechSynthesis.speak(utterance);
    }
  }

  const lettersTrack = document.getElementById('letters-track');
  const displayPhonetic = document.getElementById('display-phonetic');
  const displayTranslation = document.getElementById('display-translation');
  const displaySentence = document.getElementById('display-sentence');
  const streakCounter = document.getElementById('streak-counter');
  const accuracyCounter = document.getElementById('accuracy-counter');
  const hiddenInput = document.getElementById('hidden-word-input') as HTMLInputElement | null;
  const pronounceBtn = document.getElementById('pronounce-btn');
  const skipWordBtn = document.getElementById('skip-word-btn');
  const resetStatsBtn = document.getElementById('reset-stats-btn');
  const trainerCard = document.getElementById('wordkey-trainer');
  const soundToggleBtn = document.getElementById('sound-toggle-btn');
  const soundIcon = document.getElementById('sound-icon');
  const deckButtons = document.querySelectorAll<HTMLButtonElement>('.deck-btn');

  function getActiveBank(): WordEntry[] {
    return DECKS[currentDeckKey] || DECKS.coder;
  }

  function renderCurrentWord() {
    const bank = getActiveBank();
    const entry = bank[currentWordIndex];
    if (!entry || !lettersTrack) return;

    if (displayPhonetic) displayPhonetic.textContent = entry.phonetic;
    if (displayTranslation) displayTranslation.textContent = entry.translation;
    if (displaySentence) displaySentence.textContent = `"${entry.sentence}"`;

    lettersTrack.innerHTML = '';
    const wordLetters = entry.word.split('');
    const typedArr = typedInput.split('');

    wordLetters.forEach((letter, idx) => {
      const span = document.createElement('span');
      span.className = 'letter-char';
      span.textContent = letter;

      if (idx < typedArr.length) {
        if (typedArr[idx].toLowerCase() === letter.toLowerCase()) {
          span.classList.add('is-correct');
        } else {
          span.classList.add('is-wrong');
        }
      } else if (idx === typedArr.length) {
        span.classList.add('is-current');
      }

      lettersTrack.appendChild(span);
    });
  }

  function handleKeystroke(char: string) {
    const bank = getActiveBank();
    const currentEntry = bank[currentWordIndex];
    if (!currentEntry) return;

    const targetWord = currentEntry.word;
    const nextCharIndex = typedInput.length;

    totalKeystrokes++;

    if (nextCharIndex < targetWord.length) {
      const expectedChar = targetWord[nextCharIndex].toLowerCase();
      if (char.toLowerCase() === expectedChar) {
        typedInput += targetWord[nextCharIndex];
        correctKeystrokes++;
        playKeySound(true);

        if (typedInput.length === targetWord.length) {
          streak++;
          playSuccessDing();
          pronounceWord(targetWord);
          if (streakCounter) streakCounter.textContent = `🔥 ${streak}`;
          
          setTimeout(() => {
            currentWordIndex = (currentWordIndex + 1) % bank.length;
            typedInput = '';
            renderCurrentWord();
          }, 420);
        }
      } else {
        streak = 0;
        playKeySound(false);
        if (streakCounter) streakCounter.textContent = `🔥 0`;
        trainerCard?.classList.add('shake-card');
        setTimeout(() => trainerCard?.classList.remove('shake-card'), 260);
      }

      const acc = totalKeystrokes > 0 ? Math.round((correctKeystrokes / totalKeystrokes) * 100) : 100;
      if (accuracyCounter) accuracyCounter.textContent = `${acc}%`;

      renderCurrentWord();
    }
  }

  // 词库切换
  deckButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      deckButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const deck = btn.getAttribute('data-deck');
      if (deck && DECKS[deck]) {
        currentDeckKey = deck;
        currentWordIndex = 0;
        typedInput = '';
        renderCurrentWord();
      }
    });
  });

  // 音效开关
  soundToggleBtn?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    if (soundIcon) soundIcon.textContent = soundEnabled ? '🔊' : '🔇';
    soundToggleBtn.classList.toggle('is-muted', !soundEnabled);
  });

  window.addEventListener('keydown', (e) => {
    const wordsPanel = document.getElementById('panel-words');
    if (!wordsPanel || !wordsPanel.classList.contains('active')) return;

    if (e.target instanceof HTMLInputElement && e.target !== hiddenInput) return;
    if (e.target instanceof HTMLTextAreaElement) return;

    if (e.key === 'Backspace') {
      e.preventDefault();
      if (typedInput.length > 0) {
        typedInput = typedInput.slice(0, -1);
        renderCurrentWord();
      }
      return;
    }

    if (e.key.length === 1 && /^[a-zA-Z]$/.test(e.key) && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      handleKeystroke(e.key);
    }
  });

  hiddenInput?.addEventListener('input', (e) => {
    const inputEvt = e as InputEvent;
    if (inputEvt.data && /^[a-zA-Z]$/.test(inputEvt.data)) {
      handleKeystroke(inputEvt.data);
    }
    hiddenInput.value = '';
  });

  trainerCard?.addEventListener('click', () => {
    hiddenInput?.focus();
  });

  pronounceBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const bank = getActiveBank();
    const currentEntry = bank[currentWordIndex];
    if (currentEntry) pronounceWord(currentEntry.word);
  });

  skipWordBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const bank = getActiveBank();
    currentWordIndex = (currentWordIndex + 1) % bank.length;
    typedInput = '';
    renderCurrentWord();
  });

  resetStatsBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    streak = 0;
    totalKeystrokes = 0;
    correctKeystrokes = 0;
    currentWordIndex = 0;
    typedInput = '';
    if (streakCounter) streakCounter.textContent = '🔥 0';
    if (accuracyCounter) accuracyCounter.textContent = '100%';
    renderCurrentWord();
  });

  renderCurrentWord();
</script>

