---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories, getPostCategory, getPostDate, withBase } from '../lib/blog';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => getPostDate(b).getTime() - getPostDate(a).getTime());
const featuredPost = sortedPosts[0];
const latestPosts = sortedPosts.slice(1, 9);

// 统计各大分类真实文章数量
const categoryCounts = posts.reduce((acc, post) => {
  const cat = getPostCategory(post);
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const homeItems = sortedPosts.slice(0, 12).map((post, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  url: new URL(withBase(`/posts/${post.slug}/`), Astro.site).toString(),
  name: post.data.title
}));
---

<BaseLayout
  title="WordsMaster | 深度技术架构、价值投资与认知哲学 · 独立数字花园"
  description="WordsMaster (wordsmaster.app)：把复杂的技术演进、商业逻辑与认知模型，写成可以反复阅读的长期笔记。由工程师 DoggyDad 主笔，涵盖 AI Agent 工程架构、价值投资复利体系、图灵奖先驱全史，以及自研体感与图形学实验室。"
  keywords={['WordsMaster', 'DoggyDad', '技术博客', 'AI Agent', '软件架构', '价值投资', '商业护城河', '图灵奖', '读书笔记', '数字花园']}
  structuredData={[{
    '@type': 'CollectionPage',
    '@id': `${new URL(withBase('/'), Astro.site).toString()}#collection`,
    name: 'WordsMaster · 独立技术与深度思考知识库',
    description: '深入探讨 AI Agent 与现代软件架构、价值投资与复利哲学、图灵奖先驱计算机科学史、精选读书笔记及 Web 交互实验室。',
    mainEntity: { '@type': 'ItemList', itemListElement: homeItems }
  }]}
>
  <!-- PixelFX 像素复古动效画布 (覆盖全屏与 WordKey 游戏主体) -->
  <canvas id="wordkey-fx-canvas" class="wordkey-fx-canvas"></canvas>

  <!-- 左右平衡的精致 Editorial Hero 区域 -->
  <header class="home-hero">
    <div class="hero-grid">
      <!-- 左侧：网站叙事与定位 -->
      <div class="hero-left">
        <div class="hero-kicker">
          <span class="kicker-brand">WORDSMASTER</span>
          <span class="kicker-divider" aria-hidden="true">/</span>
          <span class="kicker-subtitle">读书 · 技术 · 实验室</span>
        </div>
        <h1 class="hero-title">
          把复杂的技术与思想，<span class="hero-highlight">写成可以反复读的笔记。</span>
        </h1>
        <p class="hero-desc">
          记录读过的经典著作、正在演进的技术范式与塑造计算机科学的人。少一点浮躁结论，多一点来龙去脉与可交互动手的实践。
        </p>
        <div class="hero-meta-bar" aria-label="全站统计">
          <span class="meta-stat"><strong>{posts.length}</strong> 篇长期长文</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span class="meta-stat"><strong>5</strong> 大知识专栏</span>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span class="meta-stat"><strong>3</strong> 个可交互实验</span>
        </div>
      </div>

      <!-- 右侧：每日先驱灵感卡（Echoes of Pioneers） -->
      <div class="hero-right">
        <div class="pioneer-quote-card" id="pioneer-card">
          <div class="quote-header">
            <div class="quote-badge">
              <span class="quote-spark">✦</span>
              <span>先驱回响 · PIONEER ECHOES</span>
            </div>
            <button type="button" class="quote-refresh-btn" id="quote-refresh-btn" title="换一条先驱思考" aria-label="切换下一条格言">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
              </svg>
              <span>换一条</span>
            </button>
          </div>
          <blockquote class="quote-body">
            <p id="quote-text">“Simplicity is prerequisite for reliability.”</p>
            <cite id="quote-translation">“简单，是软件系统可靠性的首要前提。”</cite>
          </blockquote>
          <div class="quote-footer">
            <div class="quote-author-info">
              <strong id="quote-author">Edsger W. Dijkstra</strong>
              <small id="quote-award">1972 图灵奖得主 · 结构化程序设计先驱</small>
            </div>
            <a href={withBase('/posts/turing-award/07_1972_edsger_w_dijkstra/')} id="quote-link" class="quote-article-link">
              <span>人物专访</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- 首页三大核心 Tab 控制器 (Fluid Segmented Dock) -->
  <div class="tabs-container">
    <div class="tabs-sticky-dock">
      <div class="tabs-toolbar">
        <nav class="segmented-control" role="tablist" aria-label="首页内容板块切换">
          <!-- 平滑滑动背景滑块 -->
          <div class="segmented-indicator" id="segmented-indicator" aria-hidden="true"></div>

          <button
            type="button"
            id="tab-btn-blog"
            class="segmented-btn active"
            role="tab"
            aria-selected="true"
            aria-controls="panel-blog"
            data-tab="blog"
          >
            <svg class="btn-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
              <path d="M6 6h10"></path>
              <path d="M6 10h10"></path>
            </svg>
            <span class="btn-title">博客文章</span>
            <span class="btn-counter">{posts.length}</span>
            <kbd class="key-shortcut" title="按键盘数字键 1 快速切换">1</kbd>
          </button>

          <button
            type="button"
            id="tab-btn-games"
            class="segmented-btn"
            role="tab"
            aria-selected="false"
            aria-controls="panel-games"
            data-tab="games"
          >
            <svg class="btn-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="12" x="2" y="6" rx="2"></rect>
              <path d="M6 12h4"></path>
              <path d="M8 10v4"></path>
              <circle cx="15" cy="11" r="1"></circle>
              <circle cx="18" cy="13" r="1"></circle>
            </svg>
            <span class="btn-title">游戏实验室</span>
            <span class="btn-counter">FruitWave / 爪机</span>
            <kbd class="key-shortcut" title="按键盘数字键 2 快速切换">2</kbd>
          </button>

          <button
            type="button"
            id="tab-btn-words"
            class="segmented-btn"
            role="tab"
            aria-selected="false"
            aria-controls="panel-words"
            data-tab="words"
          >
            <svg class="btn-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="5" rx="2"></rect>
              <path d="M6 10h.01"></path>
              <path d="M10 10h.01"></path>
              <path d="M14 10h.01"></path>
              <path d="M18 10h.01"></path>
              <path d="M8 14h8"></path>
            </svg>
            <span class="btn-title">单词练习</span>
            <span class="btn-counter">WordKey</span>
            <kbd class="key-shortcut" title="按键盘数字键 3 快速切换">3</kbd>
          </button>
        </nav>
      </div>
    </div>

    <!-- ================= Tab 1: 博客文章 ================= -->
    <section id="panel-blog" class="tab-panel active" role="tabpanel" aria-labelledby="tab-btn-blog">
      <!-- 5 大分类导航条（带精确收录篇数透出） -->
      <nav class="category-strip" aria-label="内容专栏分类">
        {Object.entries(categories).map(([key, category], index) => {
          const count = categoryCounts[key] || 0;
          return (
            <a href={withBase(`/category/${key}/`)} class="category-strip-item" style={`--cat-color:${category.accent}`}>
              <div class="cat-top">
                <span class="cat-num">0{index + 1}</span>
                <span class="cat-count-badge">{count} 篇</span>
              </div>
              <span class="cat-name">{category.name}</span>
              <span class="cat-desc">{category.description}</span>
            </a>
          );
        })}
      </nav>

      <!-- 精选推荐 -->
      {featuredPost && (
        <div class="featured-block">
          <div class="block-header">
            <span class="block-kicker">FEATURED HIGHLIGHT</span>
            <h2 class="block-title">从这里开始</h2>
          </div>
          <PostCard post={featuredPost} featured />
        </div>
      )}

      <!-- 最新文章列表 -->
      <div class="archive-block">
        <div class="block-header">
          <span class="block-kicker">RECENT ARTICLES</span>
          <h2 class="block-title">最新归档</h2>
        </div>
        <div class="post-grid">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
        <div class="all-link-wrapper">
          <a class="all-posts-btn" href={withBase('/search/')}>
            <span>浏览全部 {posts.length} 篇归档文章</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= Tab 2: 游戏实验室 ================= -->
    <section id="panel-games" class="tab-panel" role="tabpanel" aria-labelledby="tab-btn-games">
      <!-- 游戏双子星切换导航 -->
      <div class="games-subnav-bar">
        <div class="games-subnav-buttons" role="tablist" aria-label="游戏实验室作品切换">
          <button type="button" class="game-pill-btn active" id="game-pill-fruitwave" role="tab" aria-selected="true" data-subgame="fruitwave">
            <span class="game-pill-emoji">🍉</span>
            <span class="game-pill-name">FruitWave · 体感切水果</span>
            <span class="game-pill-badge new-badge">NEW 首发</span>
          </button>
          <button type="button" class="game-pill-btn" id="game-pill-artcatcher" role="tab" aria-selected="false" data-subgame="artcatcher">
            <span class="game-pill-emoji">🧸</span>
            <span class="game-pill-name">ArtCatcher · 3D 抓娃娃</span>
            <span class="game-pill-badge">3D 街机</span>
          </button>
        </div>
        <a href={withBase('/games/')} class="games-hub-link">
          <span>进入独立游戏中心总览</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- 嵌入试玩视窗 (默认折叠，随两款游戏试玩按钮呼出) -->
      <div id="embed-game-container" class="embed-game-box hidden">
        <div class="embed-box-bar">
          <div class="bar-left">
            <span class="online-indicator"></span>
            <span id="embed-box-title">FruitWave 浏览器体感切水果沙盒</span>
          </div>
          <div class="bar-right">
            <a href={withBase('/games/fruitwave/')} id="embed-fullscreen-link" target="_blank" class="bar-btn">全屏新窗口 ↗</a>
            <button type="button" id="close-embed-game-btn" class="bar-btn">收起试玩 ✕</button>
          </div>
        </div>
        <div class="embed-box-viewport">
          <iframe id="game-iframe" src="about:blank" data-src={withBase('/games/fruitwave/')} title="FruitWave & ArtCatcher Game" loading="lazy" allow="camera; accelerometer; gyroscope; microphone"></iframe>
        </div>
      </div>

      <!-- ---------------- 展区 1: FruitWave · 体感切水果 (默认展示) ---------------- -->
      <div id="game-display-fruitwave" class="subgame-display active">
        <div class="games-hero-card fruitwave-theme">
          <div class="game-info-col">
            <div class="game-tag">
              <span class="tag-accent fruit-accent">MEDIAPIPE 手势识别 · BROWSER ARCADE</span>
              <span class="tag-sep">·</span>
              <span class="tag-title">FRUITWAVE 体感切水果</span>
            </div>
            <h2 class="game-main-title">挥手之间，凌空斩落满屏多汁热带水果</h2>
            <p class="game-main-desc">
              移植自 tvOS 真实体感规则！在浏览器中直接启用摄像头，伸出食指在空中凌空挥砍，MediaPipe 毫秒级骨骼检测；无摄像头或未授权时，鼠标、触控板与触摸屏无缝回退。12 种真实水果、90 秒极限冲榜、连击音调动态攀升，全部运算与数据 100% 在本地完成，保护隐私。
            </p>
            <div class="game-specs-strip">
              <span class="spec-tag">⏱️ 90 秒限时</span>
              <span class="spec-tag">🍉 12 种丰富果品</span>
              <span class="spec-tag">🎥 摄像头凌空挥砍</span>
              <span class="spec-tag">🖱️ 鼠标/触摸极速回退</span>
              <span class="spec-tag">🔒 零数据上传本地运行</span>
            </div>
            <div class="game-actions">
              <a class="action-btn-primary fruit-btn" href={withBase('/games/fruitwave/')}>
                <span>进入 FruitWave 全屏畅玩</span>
                <span aria-hidden="true">→</span>
              </a>
              <button type="button" id="toggle-embed-fruitwave-btn" class="action-btn-outline">
                <span id="embed-fruitwave-text">在当前页快速试玩 ▾</span>
              </button>
            </div>
          </div>

          <div class="game-visual-col" aria-hidden="true">
            <div class="fruitwave-visual-card" id="fruitwave-preview-card">
              <div class="visual-card-ambient"></div>
              
              <!-- 核心切开西瓜动效 -->
              <div class="slice-stage">
                <div class="hero-watermelon-box">
                  <div class="watermelon-half half-left">
                    <span class="half-emoji">🍉</span>
                  </div>
                  <div class="watermelon-half half-right">
                    <span class="half-emoji">🍉</span>
                  </div>
                </div>
                <div class="blade-slash-streak"></div>
                <div class="blade-slash-flash"></div>
                <div class="slice-impact-burst"></div>
                <div class="juice-spray">
                  <span class="juice-drop d1"></span>
                  <span class="juice-drop d2"></span>
                  <span class="juice-drop d3"></span>
                  <span class="juice-drop d4"></span>
                  <span class="juice-drop d5"></span>
                  <span class="juice-drop d6"></span>
                </div>
                <div class="score-popup">+10</div>
              </div>

              <!-- 环绕悬浮漂浮水果 -->
              <div class="flying-fruit fruit-pineapple">🍍</div>
              <div class="flying-fruit fruit-strawberry">🍓</div>
              <div class="flying-fruit fruit-kiwi">🥝</div>
              <div class="flying-fruit fruit-orange">🍊</div>

              <!-- 闪光火花 -->
              <div class="fruit-burst-particle p1">✦</div>
              <div class="fruit-burst-particle p2">✦</div>
              <div class="fruit-burst-particle p3">✦</div>
              
              <!-- 动态连击徽章 -->
              <div class="fruit-combo-badge">
                <span class="combo-flame">🔥</span>
                <span class="combo-text">COMBO ×5</span>
              </div>
            </div>
          </div>
        </div>

        <!-- FruitWave 核心特性 -->
        <div class="features-trio">
          <div class="trio-card fruit-border">
            <div class="trio-badge fruit-badge">01 · 凌空骨骼追踪</div>
            <h3>本地手势毫秒识别</h3>
            <p>基于 MediaPipe Hand Landmarker，食指指尖轨迹实时映射为凌空刀光，握拳自动收招，画面与坐标不出本地。</p>
          </div>
          <div class="trio-card fruit-border">
            <div class="trio-badge fruit-badge">02 · 12 款真实果品</div>
            <h3>物理弹射抛物线</h3>
            <p>西瓜、草莓、菠萝、奇异果等多种水果不同初始速度与旋转角速度，切中触发果汁四溅的粒子打击感。</p>
          </div>
          <div class="trio-card fruit-border">
            <div class="trio-badge fruit-badge">03 · 连击音阶演化</div>
            <h3>WebAudio 动态合成</h3>
            <p>WebAudio 本地实时合成切割与得分音效，连击音阶沿五度相生律逐步拔高，无需任何外部音频资源下载。</p>
          </div>
        </div>

        <!-- FruitWave 操作指南 -->
        <div class="arcade-controls-guide fruit-guide">
          <div class="guide-header">
            <span class="guide-icon">🍉</span>
            <strong>FruitWave 操作与快捷键指南 (Controls Guide)</strong>
          </div>
          <div class="guide-keys-row">
            <div class="key-guide-item">
              <kbd class="kbd-key">🎥 摄像头</kbd>
              <span>伸出食指在空中挥砍（握拳暂停）</span>
            </div>
            <div class="key-guide-sep">|</div>
            <div class="key-guide-item">
              <kbd class="kbd-key">🖱️ 鼠标 / 触控</kbd>
              <span>按住左键或触屏滑动切水果</span>
            </div>
            <div class="key-guide-sep">|</div>
            <div class="key-guide-item">
              <kbd class="kbd-key">P</kbd>
              <span>暂停 / 继续</span>
            </div>
            <div class="key-guide-sep">|</div>
            <div class="key-guide-item">
              <kbd class="kbd-key">M</kbd>
              <span>音效静音 / 开启</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ---------------- 展区 2: ArtCatcher · 3D 抓娃娃 ---------------- -->
      <div id="game-display-artcatcher" class="subgame-display hidden">
        <div class="games-hero-card">
          <div class="game-info-col">
            <div class="game-tag">
              <span class="tag-accent">THREE.JS 3D ARCADE</span>
              <span class="tag-sep">·</span>
              <span class="tag-title">ARTCATCHER 物理爪机</span>
            </div>
            <h2 class="game-main-title">把世界名画，抓进你的私人收藏柜</h2>
            <p class="game-main-desc">
              基于真实 3D 物理引擎打造的抓娃娃机模拟器。在自由视角中操控机械爪精确下抓，收集梵高《星夜》、达芬奇《蒙娜丽莎》与限定潮玩手办，打造属于你的 3D 艺术展馆。
            </p>
            <div class="game-actions">
              <a class="action-btn-primary" href={withBase('/games/artcatcher/')}>
                <span>进入 ArtCatcher 全屏游戏</span>
                <span aria-hidden="true">→</span>
              </a>
              <button type="button" id="toggle-embed-artcatcher-btn" class="action-btn-outline">
                <span id="embed-artcatcher-text">在当前页快速试玩 ▾</span>
              </button>
            </div>
          </div>

          <div class="game-visual-col" aria-hidden="true">
            <div class="arcade-cabinet-silhouette">
              <div class="arcade-glow"></div>
              <div class="arcade-claw-rod"></div>
              <div class="arcade-claw-head"></div>
              <div class="arcade-prize-orb">🎨</div>
              <div class="arcade-base-light"></div>
            </div>
          </div>
        </div>

        <!-- 游戏核心特性与按键控制指南 -->
        <div class="features-trio">
          <div class="trio-card">
            <div class="trio-badge">01 · 真实物理</div>
            <h3>双视角微调瞄准</h3>
            <p>支持顶视全局机位与平视深度机位自由切换，精准把控抓手下潜深度与机械开合时机。</p>
          </div>
          <div class="trio-card">
            <div class="trio-badge">02 · 名画图鉴</div>
            <h3>微缩艺术展品</h3>
            <p>收录梵高《星夜》、达芬奇《蒙娜丽莎》、向日葵名作手办，以及天线宝宝与小马宝莉限量玩偶。</p>
          </div>
          <div class="trio-card">
            <div class="trio-badge">03 · 成就展柜</div>
            <h3>360° 旋转博物馆</h3>
            <p>成功抓获的手办永久入驻个人藏宝阁，支持实时旋转微距赏析，结算代币与成就奖励。</p>
          </div>
        </div>

        <!-- 街机物理控台键位说明卡 -->
        <div class="arcade-controls-guide">
          <div class="guide-header">
            <span class="guide-icon">🕹️</span>
            <strong>街机控台键位说明 (Controls Guide)</strong>
          </div>
          <div class="guide-keys-row">
            <div class="key-guide-item">
