  function getActiveBank(): WordEntry[] {
    return DECKS[currentDeckKey] || DECKS.kids;
  }

  function formatTime(sec: number): string {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  function startTimer() {
    if (timerInterval) clearInterval(timerInterval);
    elapsedSeconds = 0;
    if (timerCounter) {
      timerCounter.textContent = timeLimit > 0 ? formatTime(timeLimit) : '00:00';
    }

    timerInterval = window.setInterval(() => {
      elapsedSeconds++;
      if (timeLimit > 0) {
        const remaining = Math.max(0, timeLimit - elapsedSeconds);
        if (timerCounter) timerCounter.textContent = formatTime(remaining);
        if (remaining <= 0) {
          stopTimer();
          handleTimeUp();
        }
      } else {
        if (timerCounter) timerCounter.textContent = formatTime(elapsedSeconds);
      }
    }, 1000);
  }

  function stopTimer() {
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
  }

  function handleTimeUp() {
    pixelFx.triggerConfetti();
    showVictoryModal(true);
  }

  function showVictoryModal(isTimeUp = false) {
    if (!wkVicModal) return;
    wkVicModal.classList.remove('hidden');

    if (wkVicTitle) {
      wkVicTitle.textContent = isTimeUp ? '⏰ 限时狂飙完成！' : '🎉 词库闯关大获全胜！';
    }

    const acc = totalKeystrokes > 0 ? Math.round((correctKeystrokes / totalKeystrokes) * 100) : 100;
    let stars = '⭐⭐⭐';
    if (acc < 70) stars = '⭐';
    else if (acc < 90) stars = '⭐⭐';

    if (wkVicStars) wkVicStars.textContent = stars;
    if (wkVicScore) wkVicScore.textContent = String(score);
    if (wkVicCombo) wkVicCombo.textContent = `🔥 ${maxStreak}`;
    if (wkVicAcc) wkVicAcc.textContent = `${acc}%`;
  }

  function closeVictoryModal() {
    wkVicModal?.classList.add('hidden');
  }

  function renderCurrentWord() {
    const bank = getActiveBank();
    const entry = bank[currentWordIndex];
    if (!entry || !lettersTrack) return;

    if (wkWordEmoji) wkWordEmoji.textContent = entry.emoji || '🔤';
    if (displayPhonetic) displayPhonetic.textContent = entry.phonetic;
    if (displayTranslation) displayTranslation.textContent = entry.translation;
    if (displaySentence) displaySentence.textContent = `"${entry.sentence}"`;

    lettersTrack.innerHTML = '';
    const wordLetters = entry.word.split('');
    const typedArr = typedInput.split('');

    wordLetters.forEach((letter, idx) => {
      const span = document.createElement('span');
      span.className = 'letter-char';
      span.textContent = idx < typedArr.length ? typedArr[idx] : letter;

      if (idx < typedArr.length) {
        if (typedArr[idx].toLowerCase() === letter.toLowerCase()) {
          span.classList.add('is-correct');
        } else {
          span.classList.add('is-wrong');
        }
      } else if (idx === typedArr.length) {
        span.classList.add('is-current');
      }

      lettersTrack.appendChild(span);
    });

    renderLetterBubbles(entry.word);
  }

  function renderLetterBubbles(targetWord: string) {
    if (!wkBubblesTrack) return;
    wkBubblesTrack.innerHTML = '';

    const letters = targetWord.toLowerCase().split('');
    // 添加 1-2 个随机干扰字母
    const alphabet = 'abcdefghijklmnopqrstuvwxyz';
    const distractorCount = Math.min(2, Math.max(1, 6 - letters.length));
    for (let i = 0; i < distractorCount; i++) {
      letters.push(alphabet[Math.floor(Math.random() * alphabet.length)]);
    }

    // 打乱顺序
    for (let i = letters.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [letters[i], letters[j]] = [letters[j], letters[i]];
    }

    bubbleList = letters.map((char, idx) => ({ id: idx, char, used: false }));

    bubbleList.forEach(bubble => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'wk-bubble-btn';
      btn.textContent = bubble.char;
      btn.disabled = bubble.used;
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        handleKeystroke(bubble.char, bubble.id);
      });
      wkBubblesTrack.appendChild(btn);
    });
  }

  function updateBubbleUsedState() {
    if (!wkBubblesTrack) return;
    const btns = wkBubblesTrack.querySelectorAll<HTMLButtonElement>('.wk-bubble-btn');
    btns.forEach((btn, idx) => {
      const b = bubbleList[idx];
      if (b) btn.disabled = b.used;
    });
  }

  function handleKeystroke(char: string, bubbleId?: number) {
    const bank = getActiveBank();
    const currentEntry = bank[currentWordIndex];
    if (!currentEntry) return;

    const targetWord = currentEntry.word;
    const nextCharIndex = typedInput.length;

    totalKeystrokes++;

    if (nextCharIndex < targetWord.length) {
      const expectedChar = targetWord[nextCharIndex].toLowerCase();
      if (char.toLowerCase() === expectedChar) {
        typedInput += targetWord[nextCharIndex];
        correctKeystrokes++;
        playKeySound(true);

        // 标记气泡使用
        if (bubbleId !== undefined) {
          const b = bubbleList.find(x => x.id === bubbleId);
          if (b) b.used = true;
        } else {
          const b = bubbleList.find(x => x.char.toLowerCase() === char.toLowerCase() && !x.used);
          if (b) b.used = true;
        }
        updateBubbleUsedState();

        // 触发 PixelFX 命中动效
        pixelFx.triggerCorrect(lettersTrack, streak, true);

        // 单词全部拼写完成
        if (typedInput.length === targetWord.length) {
          streak++;
          if (streak > maxStreak) maxStreak = streak;
          score += 10 + streak * 2;
          if (scoreCounter) scoreCounter.textContent = String(score);

          playSuccessDing();
          pronounceWord(targetWord);
          if (streakCounter) streakCounter.textContent = `🔥 ${streak}`;

          // 触发 PixelFX 连击或大通关动效
          pixelFx.triggerCorrect(trainerCard, streak, true);
          if (streak >= 3 && (streak % 3 === 0 || streak % 5 === 0)) {
            pixelFx.triggerCombo(streak, trainerCard);
          }

          setTimeout(() => {
            currentWordIndex = (currentWordIndex + 1) % bank.length;
            typedInput = '';
            if (currentWordIndex === 0) {
              pixelFx.triggerLevelUp(`进入下一个挑战!`);
            }
            renderCurrentWord();
          }, 450);
        }
      } else {
        streak = 0;
        playKeySound(false);
        if (streakCounter) streakCounter.textContent = `🔥 0`;
        trainerCard?.classList.add('shake-card');
        setTimeout(() => trainerCard?.classList.remove('shake-card'), 260);

        // 触发 PixelFX 护盾碎裂反馈
        pixelFx.triggerWrong(lettersTrack, trainerCard);
      }

      const acc = totalKeystrokes > 0 ? Math.round((correctKeystrokes / totalKeystrokes) * 100) : 100;
      if (accuracyCounter) accuracyCounter.textContent = `${acc}%`;

      renderCurrentWord();
    }
  }

  function handleBackspace() {
    if (typedInput.length === 0) return;
    const removedChar = typedInput.slice(-1);
    typedInput = typedInput.slice(0, -1);

    // 释放最后一个对应的气泡
    for (let i = bubbleList.length - 1; i >= 0; i--) {
      const b = bubbleList[i];
      if (b.char.toLowerCase() === removedChar.toLowerCase() && b.used) {
        b.used = false;
        break;
      }
    }
    updateBubbleUsedState();
    renderCurrentWord();
  }

  function handleHint() {
    const bank = getActiveBank();
    const currentEntry = bank[currentWordIndex];
    if (!currentEntry) return;
    const targetWord = currentEntry.word;
    const nextIdx = typedInput.length;
    if (nextIdx < targetWord.length) {
      handleKeystroke(targetWord[nextIdx]);
    }
  }

  // 词库切换
  deckButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      deckButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const deck = btn.getAttribute('data-deck');
      if (deck && DECKS[deck]) {
        currentDeckKey = deck;
        currentWordIndex = 0;
        typedInput = '';
        streak = 0;
        if (streakCounter) streakCounter.textContent = '🔥 0';
        renderCurrentWord();
        pixelFx.triggerLevelUp(`切换词库: ${btn.textContent?.trim()}`);
      }
    });
  });

  // 限时模式切换
  timePills.forEach(pill => {
    pill.addEventListener('click', () => {
      timePills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      timeLimit = parseInt(pill.dataset.time || '120', 10);
      startTimer();
    });
  });

  // 音效开关
  soundToggleBtn?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    if (soundIcon) soundIcon.textContent = soundEnabled ? '🔊' : '🔇';
    soundToggleBtn.classList.toggle('is-muted', !soundEnabled);
  });

  // 慢速发音跟读切换
  wkSlowAudioBtn?.addEventListener('click', () => {
    isSlowSpeech = !isSlowSpeech;
    if (wkSlowLabel) wkSlowLabel.textContent = isSlowSpeech ? '慢速 0.75x' : '正常语速';
    wkSlowAudioBtn.classList.toggle('active', isSlowSpeech);
    const bank = getActiveBank();
    const entry = bank[currentWordIndex];
    if (entry) pronounceWord(entry.word);
  });

  // 快捷操作按钮绑定
  wkBtnBackspace?.addEventListener('click', (e) => {
    e.stopPropagation();
    handleBackspace();
  });
  wkBtnHint?.addEventListener('click', (e) => {
    e.stopPropagation();
    handleHint();
  });
  skipWordBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const bank = getActiveBank();
    streak = 0;
    if (streakCounter) streakCounter.textContent = '🔥 0';
    currentWordIndex = (currentWordIndex + 1) % bank.length;
    typedInput = '';
    renderCurrentWord();
  });

  resetStatsBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    streak = 0;
    score = 0;
    totalKeystrokes = 0;
    correctKeystrokes = 0;
    currentWordIndex = 0;
    typedInput = '';
    if (streakCounter) streakCounter.textContent = '🔥 0';
    if (scoreCounter) scoreCounter.textContent = '0';
    if (accuracyCounter) accuracyCounter.textContent = '100%';
    startTimer();
    renderCurrentWord();
  });

  // 结算弹窗重启与关闭
  wkVicRestartBtn?.addEventListener('click', () => {
    closeVictoryModal();
    score = 0;
    streak = 0;
    currentWordIndex = 0;
    typedInput = '';
    if (scoreCounter) scoreCounter.textContent = '0';
    if (streakCounter) streakCounter.textContent = '🔥 0';
    startTimer();
    renderCurrentWord();
  });
  wkVicCloseBtn?.addEventListener('click', closeVictoryModal);

  // 全局键盘监听
  window.addEventListener('keydown', (e) => {
    const wordsPanel = document.getElementById('panel-words');
    if (!wordsPanel || !wordsPanel.classList.contains('active')) return;

    if (e.target instanceof HTMLInputElement && e.target !== hiddenInput) return;
    if (e.target instanceof HTMLTextAreaElement) return;

    if (e.key === 'Backspace') {
      e.preventDefault();
      handleBackspace();
      return;
    }

    if (e.key === ' ' || e.key === 'Spacebar') {
      e.preventDefault();
      const bank = getActiveBank();
      const currentEntry = bank[currentWordIndex];
      if (currentEntry) pronounceWord(currentEntry.word);
      return;
    }

    if (e.key === 'Enter') {
      e.preventDefault();
      handleHint();
      return;
    }

    if (e.key.length === 1 && /^[a-zA-Z]$/.test(e.key) && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      handleKeystroke(e.key);
    }
  });

  hiddenInput?.addEventListener('input', (e) => {
    const inputEvt = e as InputEvent;
    if (inputEvt.data && /^[a-zA-Z]$/.test(inputEvt.data)) {
      handleKeystroke(inputEvt.data);
    }
    hiddenInput.value = '';
  });

  trainerCard?.addEventListener('click', () => {
    hiddenInput?.focus();
  });

  pronounceBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const bank = getActiveBank();
    const currentEntry = bank[currentWordIndex];
    if (currentEntry) pronounceWord(currentEntry.word);
  });

  // 启动计时器与渲染首词
  startTimer();
  renderCurrentWord();
</script>

