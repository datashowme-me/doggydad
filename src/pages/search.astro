---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { getPostDate } from '../lib/blog';

const posts = (await getCollection('posts')).sort((a, b) => getPostDate(b).getTime() - getPostDate(a).getTime());
---

<BaseLayout title="搜索文章 — DoggyDad" description="搜索 DoggyDad 的读书笔记、技术文章与人物系列。">
  <header class="search-header">
    <p>SEARCH / ARCHIVE</p>
    <h1>找到一篇值得继续读的文章。</h1>
    <label for="search-input">搜索标题、摘要或标签</label>
    <div class="search-box">
      <input id="search-input" type="search" name="q" placeholder="例如：反脆弱、Agent、图灵奖" autocomplete="off" />
      <span id="result-count" aria-live="polite">共 {posts.length} 篇</span>
    </div>
  </header>

  <section class="search-results" id="search-results" aria-label="搜索结果">
    {posts.map((post) => (
      <div class="search-item" data-search={`${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase()}>
        <PostCard post={post} />
      </div>
    ))}
  </section>
  <p class="empty-message" id="empty-message" hidden>没有找到匹配的文章。试试更短的关键词。</p>

  <script>
    const input = document.querySelector<HTMLInputElement>('#search-input');
    const items = [...document.querySelectorAll<HTMLElement>('.search-item')];
    const count = document.querySelector('#result-count');
    const emptyMessage = document.querySelector<HTMLElement>('#empty-message');

    const filterPosts = () => {
      const query = input?.value.trim().toLowerCase() || '';
      let visible = 0;
      items.forEach((item) => {
        const matches = !query || item.dataset.search?.includes(query);
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      if (count) count.textContent = query ? `${visible} 篇匹配` : `共 ${visible} 篇`;
      if (emptyMessage) emptyMessage.hidden = visible !== 0;
      const url = new URL(window.location.href);
      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      history.replaceState({}, '', url);
    };

    if (input) {
      input.value = new URLSearchParams(location.search).get('q') || '';
      input.addEventListener('input', filterPosts);
      filterPosts();
    }
  </script>
</BaseLayout>

<style>
  .search-header { max-width: 870px; padding-bottom: clamp(3rem, 7vw, 6rem); }
  .search-header > p { margin: 0 0 1rem; color: var(--color-accent); font-size: .7rem; font-weight: 700; letter-spacing: .15em; }
  h1 { max-width: 14ch; margin: 0 0 3rem; color: var(--color-heading); font-family: var(--font-serif); font-size: clamp(2.8rem, 7vw, 5.5rem); letter-spacing: -.05em; line-height: 1.08; }
  label { display: block; margin-bottom: .55rem; color: var(--color-text-muted); font-size: .75rem; }
  .search-box { display: flex; align-items: center; gap: 1rem; padding-bottom: .8rem; border-bottom: 2px solid var(--color-heading); }
  input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--color-heading); font-family: var(--font-serif); font-size: clamp(1.1rem, 3vw, 1.5rem); }
  input::placeholder { color: var(--color-border-strong); }
  .search-box span { color: var(--color-text-muted); font-size: .75rem; white-space: nowrap; }
  .search-results { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 7vw, 6rem); }
  .search-item[hidden] { display: none; }
  .empty-message { padding: 4rem 0; color: var(--color-text-muted); }
  @media (max-width: 700px) { .search-results { grid-template-columns: 1fr; } }
</style>
